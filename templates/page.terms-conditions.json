    "custom_liquid_cWNzPF": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "custom_liquid": "<style>\n  .colamy-faqs-page {\n    --cw-text: #111111;\n    --cw-muted: #333333;\n    --cw-blue: #2f6df6;\n    --cw-border: #e5e5e5;\n    font-family: Arial, Helvetica, sans-serif;\n    color: var(--cw-text);\n    background: #ffffff;\n    line-height: 1.62;\n    font-size: 18px;\n  }\n  .colamy-faqs-page * { box-sizing: border-box; }\n  .colamy-faqs-inner {\n    width: 100%;\n    max-width: 1600px;\n    margin: 0 auto;\n    padding: 92px 22px 72px;\n  }\n  .colamy-faqs-page p { margin: 0 0 30px; }\n  .colamy-faqs-page h1 {\n    text-align: center;\n    font-size: 36px;\n    line-height: 1.25;\n    margin: 0px 0 26px;\n    font-weight: 700;\n    letter-spacing: -0.02em;\n  }\n  .colamy-faqs-page h2 {\n    font-size: 30px;\n    line-height: 1.25;\n    margin: 56px 0 26px;\n    font-weight: 500;\n    letter-spacing: -0.02em;\n  }\n  .colamy-faqs-page h3 {\n    font-size: 28px;\n    line-height: 1.28;\n    margin: 46px 0 20px;\n    font-weight: 500;\n    letter-spacing: -0.015em;\n  }\n  .colamy-faqs-page ul,\n  .colamy-faqs-page ol { margin: 0 0 30px 0; padding-left: 0; list-style: none; }\n  .colamy-faqs-page li {\n    position: relative;\n    margin: 0 0 13px 0;\n    padding-left: 42px;\n    line-height: 1.72;\n  }\n  .colamy-faqs-page ul li::before {\n    content: \"•\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: #111111;\n    font-size: 23px;\n    line-height: 1.35;\n  }\n  .colamy-faqs-page ol { counter-reset: faqs-counter; }\n  .colamy-faqs-page ol > li { counter-increment: faqs-counter; }\n  .colamy-faqs-page ol > li::before {\n    content: counter(faqs-counter) \".\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: #111111;\n    font-size: 17px;\n    line-height: 1.75;\n  }\n  .colamy-faqs-page .plain-list { margin-bottom: 30px; }\n  .colamy-faqs-page .plain-list li { padding-left: 26px; margin-bottom: 2px; line-height: 1.52; }\n  .colamy-faqs-page .plain-list li::before { color: #111; font-size: 18px; line-height: 1.52; }\n\n  /* FAQ Accordion */\n  .colamy-faqs-page .faq-list { border-top: 1px solid var(--cw-border); margin-bottom: 8px; }\n  .colamy-faqs-page .faq-item {\n    border-bottom: 1px solid var(--cw-border);\n    margin: 0;\n  }\n  .colamy-faqs-page .faq-item summary {\n    list-style: none;\n    cursor: pointer;\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 20px;\n    padding: 18px 0;\n    font-size: 18px;\n    line-height: 1.45;\n    font-weight: 400;\n  }\n  .colamy-faqs-page .faq-item summary::-webkit-details-marker { display: none; }\n  .colamy-faqs-page .faq-item summary::after {\n    content: \"+\";\n    flex: 0 0 auto;\n    font-weight: 400;\n    font-size: 24px;\n    line-height: 1;\n    color: #111;\n  }\n  .colamy-faqs-page .faq-item[open] summary::after { content: \"−\"; }\n  .colamy-faqs-page .faq-answer {\n    padding: 0 42px 20px 0;\n    font-size: 18px;\n    line-height: 1.62;\n    color: var(--cw-muted);\n  }\n  .colamy-faqs-page .faq-answer p { margin: 0 0 14px; }\n  .colamy-faqs-page .faq-answer ul,\n  .colamy-faqs-page .faq-answer ol { margin: 0 0 14px 0; }\n\n  /* Table Styles */\n  .colamy-faqs-page .refund-table-wrap {\n    margin: 16px 0 30px;\n    overflow-x: auto;\n  }\n  .colamy-faqs-page .refund-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 16px;\n    line-height: 1.5;\n  }\n  .colamy-faqs-page .refund-table th,\n  .colamy-faqs-page .refund-table td {\n    border: 1px solid var(--cw-border);\n    padding: 12px 16px;\n    text-align: left;\n    vertical-align: top;\n  }\n  .colamy-faqs-page .refund-table th {\n    background: #f5f5f5;\n    font-weight: 500;\n    color: var(--cw-text);\n  }\n  .colamy-faqs-page .refund-table td {\n    color: var(--cw-muted);\n  }\n\n  /* Image Placeholder */\n  .colamy-faqs-page .doc-image {\n    margin: 10px 0 20px;\n    text-align: left;\n  }\n  .colamy-faqs-page .doc-image img {\n    max-width: 500px;\n    height: auto;\n    display: block;\n    margin: 0;\n  }\n  .colamy-faqs-page .doc-image-placeholder {\n    margin: 10px 0 20px;\n    text-align: center;\n  }\n  .colamy-faqs-page .doc-image-placeholder-box {\n    width: 100%;\n    min-height: 220px;\n    border: 1px dashed #d9d9d9;\n    background: #fafafa;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #777;\n    font-size: 15px;\n  }\n  .colamy-faqs-page .image-caption {\n    margin-top: 14px;\n    text-align: center;\n    font-size: 16px;\n    line-height: 1.4;\n    color: #777;\n  }\n\n  .colamy-faqs-page a {\n    color: var(--cw-blue);\n    text-decoration: none;\n  }\n  .colamy-faqs-page a:hover {\n    text-decoration: underline;\n  }\n  .colamy-faqs-page .last-updated {\n    margin-top: 34px;\n    font-weight: 700;\n  }\n\n  @media (max-width: 749px) {\n    .colamy-faqs-page { font-size: 16px; line-height: 1.62; }\n    .colamy-faqs-inner { padding: 46px 18px 48px; }\n    .colamy-faqs-page h1 { font-size: 28px; }\n    .colamy-faqs-page h2 { font-size: 25px; margin: 44px 0 19px; }\n    .colamy-faqs-page h3 { font-size: 23px; margin: 38px 0 15px; }\n    .colamy-faqs-page li { padding-left: 28px; margin-bottom: 9px; }\n    .colamy-faqs-page .faq-item summary,\n    .colamy-faqs-page .faq-answer { font-size: 16px; }\n    .colamy-faqs-page .faq-answer { padding: 0 20px 16px 0; }\n    .colamy-faqs-page .refund-table { font-size: 14px; }\n    .colamy-faqs-page .refund-table th,\n    .colamy-faqs-page .refund-table td { padding: 10px 12px; }\n  }\n</style>\n\n<div class=\"colamy-faqs-page\">\n  <div class=\"colamy-faqs-inner\">\n    <h1>FAQs</h1>\n\n    <!-- ========== Order & Payment ========== -->\n    <h2>Order &amp; Payment</h2>\n\n    <div class=\"faq-list\">\n\n      <details class=\"faq-item\">\n        <summary>Why can't I use my coupon?</summary>\n        <div class=\"faq-answer\">\n          <p>If you find that the coupon cannot be used on the checkout page, it may be due to the following reasons:</p>\n          <ul class=\"plain-list\">\n            <li><strong>Expired coupon code:</strong> The coupon code has exceeded its usage period or limit</li>\n            <li><strong>Non-stackable:</strong> Your order has already applied another coupon code</li>\n            <li><strong>Special products:</strong> Some products may not support discounts</li>\n            <li><strong>Input error:</strong> Please check if the coupon code you entered is correct</li>\n          </ul>\n          <p>If you still cannot successfully apply the discount, please contact us and provide a screenshot of the corresponding error message for further assistance.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Why did my payment fail?</summary>\n        <div class=\"faq-answer\">\n          <p>If your payment was not successful, it may be due to the following reasons:</p>\n          <ul class=\"plain-list\">\n            <li>Insufficient funds or credit limit</li>\n            <li>Incorrect card number, expiry date, CVC, or billing details</li>\n            <li>Bank security checks or restrictions on international/online payments</li>\n            <li>Temporary connection or system issues</li>\n          </ul>\n          <p>Please try:</p>\n          <ul class=\"plain-list\">\n            <li>Checking your card details and funds/credit</li>\n            <li>Using a different card or payment method</li>\n            <li>Contacting your bank to confirm the payment is allowed</li>\n          </ul>\n          <p>If the problem continues, please contact us with a screenshot of the error message (without revealing full card details).</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Can I change/cancel my order?</summary>\n        <div class=\"faq-answer\">\n          <p>If your order has not yet been shipped, please contact us in time to cancel your order and receive a refund.</p>\n          <p>If the order has already been shipped and you have received a shipping confirmation email, the order cannot be canceled directly and may involve intercepting the package and returning it, etc., please contact our customer service team for advice on the next steps.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Is there a bulk purchase discount?</summary>\n        <div class=\"faq-answer\">\n          <p>If you have a bulk purchase requirement, we are happy to help you check whether it's possible to apply for additional discounts. Please contact us at <a href=\"mailto:hello@colamyhome.com\">hello@colamyhome.com</a> and let us know the model, quantity, and shipping address so we can provide you with a quote.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>How to purchase accessories?</summary>\n        <div class=\"faq-answer\">\n          <p>If you need to purchase accessories, please contact us at <a href=\"mailto:hello@colamyhome.com\">hello@colamyhome.com</a> and provide your order number, product model, and the accessory model you need (refer to the manual). We will check inventory and provide a quote for you, as well as suggest the next steps.</p>\n        </div>\n      </details>\n\n    </div>\n\n    <!-- ========== Shipping & Delivery ========== -->\n    <h2>Shipping &amp; Delivery</h2>\n\n    <div class=\"faq-list\">\n\n      <details class=\"faq-item\">\n        <summary>Where are COLAMY products shipped?</summary>\n        <div class=\"faq-answer\">\n          <p>Free standard shipping is available within most regions of Canada. Remote areas may incur additional charges.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Can I ship to a PO Box address?</summary>\n        <div class=\"faq-answer\">\n          <p>We currently do not support shipping to PO BOX addresses. To ensure you receive your order smoothly, please provide a complete and valid street address when placing your order.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Can I ship to an address outside the US?</summary>\n        <div class=\"faq-answer\">\n          <p>If your shipping address is located outside Canada (such as the U.S., the UK, or the European Union) please refer to the list of deliverable addresses in the corresponding shipping policy on our respective sites.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>How to Estimate the Delivery Date?</summary>\n        <div class=\"faq-answer\">\n          <p>Order processing usually takes 1-2 business days, and shipping takes approximately 5-10 business days after dispatch.</p>\n          <p>Note: Pre-sale products are out of stock; for estimated shipping times, please refer to the product page.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Why did my order arrive in multiple boxes or from multiple carriers?</summary>\n        <div class=\"faq-answer\">\n          <p>We may ship your order to you in multiple boxes or via multiple carriers due to:</p>\n          <ul class=\"plain-list\">\n            <li>The order size — large orders often are split into multiple boxes for more efficient delivery.</li>\n            <li>The product's storage location — some products will come to you from our different warehouses.</li>\n          </ul>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>How do I track my order?</summary>\n        <div class=\"faq-answer\">\n          <p>You can track your order through the link in the shipping notification email, or copy the tracking number and check the details on the carrier's official website. If you cannot find the tracking number, please contact us at <a href=\"mailto:hello@colamyhome.com\">hello@colamyhome.com</a> for further assistance.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>What if my parcel is delayed, missing, incorrect, or damaged?</summary>\n        <div class=\"faq-answer\">\n          <p>If you find your parcel is delayed, missing, incorrect, or damaged, please contact us at <a href=\"mailto:hello@colamyhome.com\">hello@colamyhome.com</a> and describe your situation in time. We may need your assistance in providing some pictures to investigate the status of the package, and then arrange a reshipment or exchange for you accordingly. For specific steps, please refer to our Shipping &amp; Delivery and Return &amp; Refunds page.</p>\n        </div>\n      </details>\n\n    </div>\n\n    <!-- ========== Return & Refunds ========== -->\n    <h2>Return &amp; Refunds</h2>\n\n    <div class=\"faq-list\">\n\n      <details class=\"faq-item\">\n        <summary>Can I return or exchange items?</summary>\n        <div class=\"faq-answer\">\n          <p>If you wish to return or exchange an item, please contact us at <a href=\"mailto:hello@colamyhome.com\">hello@colamyhome.com</a> or submit your return request through our Contact Form. Kindly provide the reason for the return or exchange, along with the relevant details, and we will assist you with the process.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>What is the return process?</summary>\n        <div class=\"faq-answer\">\n          <p>Please refer to the following steps for the return process:</p>\n          <ol>\n            <li>Contact us at <a href=\"mailto:hello@colamyhome.com\">hello@colamyhome.com</a> and describe your issue in detail.</li>\n            <li>If you meet the return conditions, we will provide you with a free shipping label for the return.</li>\n            <li>After sending the return package, please notify us as soon as possible.</li>\n            <li>Once we have verified the effective return shipment, we will immediately initiate the refund process for you.</li>\n          </ol>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Will there be any additional fees for returns?</summary>\n        <div class=\"faq-answer\">\n          <p>For eligible orders within Canada, return shipping fees will be covered by COLAMY– COLAMY will cover the costs. Feel free to shop with confidence!</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>When will I receive my refund?</summary>\n        <div class=\"faq-answer\">\n          <p>We will initiate your refund as soon as a valid return tracking number is provided and shows an active shipping status. Funds will be processed back to your original form of payment (e.g., Credit Card, PayPal).</p>\n          <p>After that, the time it takes to reach you depends on your payment method and bank:</p>\n\n          <div class=\"refund-table-wrap\">\n            <table class=\"refund-table\">\n              <thead>\n                <tr>\n                  <th>Payment Method</th>\n                  <th>When will I receive my refund?</th>\n                </tr>\n              </thead>\n              <tbody>\n                <tr>\n                  <td>PayPal</td>\n                  <td>For PayPal payments, the refund will typically appear in your PayPal account immediately after it is processed.</td>\n                </tr>\n                <tr>\n                  <td>Credit Card (including: Visa, Mastercard, American Express, Apple Pay, Google, Affirm, etc.)</td>\n                  <td>For credit cards or other methods, please note that it may take additional time for your bank or credit card provider to reflect the refund on your statement.</td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n\n          <p>If you have not received your refund for an extended period, please contact us for further assistance.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>What should I do if I still haven't received my refund?</summary>\n        <div class=\"faq-answer\">\n          <p>If you have not received your refund after it was approved, please first confirm that we have already processed your refund (check our refund notification email), and that the normal processing time for your bank has passed.</p>\n          <p>Then:</p>\n          <ul class=\"plain-list\">\n            <li>Check your bank/card statement or PayPal/online wallet history</li>\n            <li>Contact your bank or payment provider with our refund confirmation, and ask about the status of the refund</li>\n          </ul>\n          <p>If you still cannot locate it, please contact us with your order number and refund details, and we will help you check the status.</p>\n        </div>\n      </details>\n\n    </div>\n\n    <!-- ========== Warranty ========== -->\n    <h2>Warranty</h2>\n\n    <div class=\"faq-list\">\n\n      <details class=\"faq-item\">\n        <summary>How long is the warranty period?</summary>\n        <div class=\"faq-answer\">\n          <p>COLAMY warrants that, as long as you (the original purchaser) still own the chair, if any material or workmanship defects are found within one year from the original purchase date (three years for the Atlas Chair, Atlas-01 Chair and VELlA Chair), COLAMY will repair or replace it.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Do I need to register to activate the warranty?</summary>\n        <div class=\"faq-answer\">\n          <p>You can enjoy our warranty service without registering an account. However, we recommend creating one, as it allows you to conveniently view and manage your orders in the user center.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>For a replacement product, how long is the remaining warranty period?</summary>\n        <div class=\"faq-answer\">\n          <p>If a product is replaced during the warranty period, the remaining warranty coverage will continue based on the warranty period of the original order.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>How do I File a warranty claim?</summary>\n        <div class=\"faq-answer\">\n          <p>If you believe you are eligible to file a warranty claim, please contact us at <a href=\"mailto:hello@colamyhome.com\">hello@colamyhome.com</a> or fill out the Contact Form to describe your problem in detail. Please be sure to provide all necessary information related to the claim, including the original order details, a complete description of the issue, and photographic or video evidence clearly showing the problem.</p>\n        </div>\n      </details>\n\n    </div>\n\n    <!-- ========== Product Questions ========== -->\n    <h2>Product Questions</h2>\n\n    <div class=\"faq-list\">\n\n      <details class=\"faq-item\">\n        <summary>Are products fully assembled?</summary>\n        <div class=\"faq-answer\">\n          <p>No. Products include easy-to-follow assembly instructions (typically takes minutes). If you run into any issues, please email us at <a href=\"mailto:hello@colamyhome.com\">hello@colamyhome.com</a> and we'll be happy to help.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Where can I find product dimensions and weight?</summary>\n        <div class=\"faq-answer\">\n          <p>You can find detailed size and weight information on each product page, listed under the product specifications.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Do you have any local physical stores?</summary>\n        <div class=\"faq-answer\">\n          <p>We don't have physical retail stores at the moment. However, all orders are shipped from our local warehouses, so you can enjoy fast and reliable delivery.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Will my item look exactly like the pictures?</summary>\n        <div class=\"faq-answer\">\n          <p>Due to differences in production batches, there may be slight variations in color and dimensions. This is normal and does not affect product quality.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>What is the difference between ATLAS and ATLAS-01?</summary>\n        <div class=\"faq-answer\">\n          <p>The differences between these two chairs are as follows:</p>\n          <ul class=\"plain-list\">\n            <li>The colors are different.</li>\n            <li>The material of the base and armrests is different: ATLAS uses mainly aluminum alloy, while ATLAS-01 uses plastic nylon.</li>\n          </ul>\n          <p>Apart from these points, there is no difference in functionality.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>How do I adjust the headrest angle of ATLAS?</summary>\n        <div class=\"faq-answer\">\n          <p>Since the rotating part has been fixed with adhesive, it may be somewhat difficult to adjust at first. We recommend that you try the following methods several times:</p>\n          <ul class=\"plain-list\">\n            <li>Hold the backrest with one hand to stabilize it, then gently but firmly adjust the headrest with your other hand.</li>\n            <li>Or, sit in the chair and use both hands to adjust the headrest while keeping your upper body steady.</li>\n          </ul>\n          <p>Because of the strong adhesive, it may require more force than expected. Please try multiple times; several firm adjustments may gradually loosen the mechanism and make it easier to move.</p>\n\n          <div class=\"doc-image\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0685/2739/1017/files/adjustmentInstructions.png?v=1779950518\" alt=\"ATLAS Headrest Adjustment\" width=\"100%\" height=\"100%\">\n          </div>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>How do I adjust the reclining position of ATLAS?</summary>\n        <div class=\"faq-answer\">\n          <p>You can unlock the backrest by using the adjustment lever on the right rear side of the seat, and adjust the recline position by applying some force backward. For specific operation steps and precautions, please refer to the user manual included with the product.</p>\n\n          <div class=\"doc-image\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0685/2739/1017/files/tiltlockAdjustment.png?v=1779950518\" alt=\"ATLAS Reclining Position Adjustment\" width=\"100%\" height=\"100%\">\n          </div>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>How do I adjust the seat height of ATLAS?</summary>\n        <div class=\"faq-answer\">\n          <p>You can adjust the seat height using the adjustment lever located at the front right of the seat. For detailed operating steps and precautions, please refer to the user manual included with the product.</p>\n\n          <div class=\"doc-image\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0685/2739/1017/files/seatHeightAdjustment.png?v=1779950518\" alt=\"ATLAS Seat Height Adjustment\" width=\"100%\" height=\"100%\">\n          </div>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>How do I adjust the tilt tension of ATLAS?</summary>\n        <div class=\"faq-answer\">\n          <p>You can adjust the tilt tension by turning the adjustment knob on the right side of the seat forward or backward. For detailed operating steps and precautions, please refer to the user manual included with the product.</p>\n\n          <div class=\"doc-image\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0685/2739/1017/files/tiltTensionAdjustment.png?v=1779950518\" alt=\"ATLAS Tilt Tension Adjustment\" width=\"100%\" height=\"100%\">\n          </div>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Do you offer fabric samples for NOYA dining chair?</summary>\n        <div class=\"faq-answer\">\n          <p>We're sorry, but we currently do not offer fabric samples.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>How do I clean my NOYA dining chair?</summary>\n        <div class=\"faq-answer\">\n          <p>The following are recommendations for seat surface cleaning:</p>\n          <ul class=\"plain-list\">\n            <li>For daily cleaning, simply wipe the surface with a soft dry towel.</li>\n            <li>If spills or stains occur, it is recommended to clean them as soon as possible with mild soapy water, then dry promptly to avoid mold caused by prolonged dampness.</li>\n            <li>This fabric is durable and stain-resistant, but like all light-colored fabrics, it is best to avoid leaving strong dyes (such as red wine, coffee, or markers) on the surface for extended periods.</li>\n          </ul>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>How do you distinguish the left and right legs of the NOYA during installation?</summary>\n        <div class=\"faq-answer\">\n          <p>Before installation, please distinguish the left and right legs of the chair according to the direction of the groove on the chair legs. The groove facing upward is the left leg, and the groove facing downward is the right leg.</p>\n          <p>If installed incorrectly, the angle between the left and right legs of the chair increases, which causes the holes in the chair legs to be misaligned with the bottom of the seat cushion and the backrest, making installation impossible.</p>\n          <p>Please refer to the example in the figure below for the correct installation angle.</p>\n\n          <div class=\"doc-image\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0685/2739/1017/files/step1.png?v=1779950518\" alt=\"NOYA Leg Installation\" width=\"100%\" height=\"100%\">\n          </div>\n        </div>\n      </details>\n\n    </div>\n\n    <p class=\"last-updated\">Last updated: April 15, 2026</p>\n\n  </div>\n</div>",
        "color_scheme": "",
        "padding_top": 50,
        "padding_bottom": 50
      }
    },
