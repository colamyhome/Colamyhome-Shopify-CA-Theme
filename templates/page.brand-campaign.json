    "multicolumn_4yrgHh": {
      "type": "multicolumn",
      "blocks": {
        "column_CigTrW": {
          "type": "column",
          "settings": {
            "title": "<strong>Designed for Real Life</strong>",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h4",
            "text": "<p>Designed for how you actually live. We don’t design for showrooms. We design for pieces that feel effortless in the home—silhouettes that feel easy to style, details that work across spaces, and pieces that stay useful long after the room is finished. Good furniture shouldn’t ask too much from the room around it.</p>",
            "text_size": "text-base",
            "button_label": "",
            "button_link": "",
            "button_style": "btn--underline",
            "button_icon": "none"
          }
        },
        "column_fDFpY7": {
          "type": "column",
          "settings": {
            "title": "<strong>Built to Feel Reliable</strong>",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h4",
            "text": "<p>A piece should feel good the day it arrives—and keep feeling solid over time.That’s why we pay attention to the parts you don’t always see: balanced construction, tested performance, and dependable support designed for daily living.</p>",
            "text_size": "text-base",
            "button_label": "",
            "button_link": "",
            "button_style": "btn--underline",
            "button_icon": "none"
          }
        },
        "column_3hiKib": {
          "type": "column",
          "settings": {
            "title": "<strong>Comfort in Every Layer</strong>",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h4",
            "text": "<p>grain of the wood to the density of the foam, every layer is chosen for one purpose: to feel as good years from now as it does today.</p>",
            "text_size": "text-base",
            "button_label": "",
            "button_link": "",
            "button_style": "btn--underline",
            "button_icon": "none"
