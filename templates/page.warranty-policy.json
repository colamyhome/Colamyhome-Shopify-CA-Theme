        "custom_liquid": "<style>\n  .colamy-warranty-page {\n    --cw-text: #111111;\n    --cw-muted: #333333;\n    --cw-blue: #2f6df6;\n    --cw-border: #e5e5e5;\n    font-family: Arial, Helvetica, sans-serif;\n    color: var(--cw-text);\n    background: #ffffff;\n    line-height: 1.62;\n    font-size: 18px;\n  }\n  .colamy-warranty-page * { box-sizing: border-box; }\n  .colamy-warranty-inner {\n\n    width: 100%;\n    max-width: 1600px;\n    margin: 0 auto;\n    padding: 92px 22px 72px;\n  }\n  .colamy-warranty-page p { margin: 0 0 30px; }\n  .colamy-warranty-page .lead p { font-size: 19px; line-height: 1.52; margin-bottom: 14px; }\n  .colamy-warranty-page .lead strong { font-weight: 500; }\n  .colamy-warranty-page h1 {\n    text-align: center;\n    font-size: 36px;\n    line-height: 1.25;\n    margin: 0px 0 26px;\n    font-weight: 700;\n    letter-spacing: -0.02em;\n  }\n  .colamy-warranty-page h2 {\n    font-size: 30px;\n    line-height: 1.25;\n    margin: 70px 0 26px;\n    font-weight: 500;\n    letter-spacing: -0.02em;\n  }\n  .colamy-warranty-page h3 {\n    font-size: 28px;\n    line-height: 1.28;\n    margin: 56px 0 20px;\n    font-weight: 500;\n    letter-spacing: -0.015em;\n  }\n  .colamy-warranty-page .section-title { margin-top: 46px; }\n  .colamy-warranty-page .spacer-large { height: 34px; }\n  .colamy-warranty-page .doc-image-placeholder { margin: 2px 0 54px; text-align: center; }\n  .colamy-warranty-page .doc-image-placeholder-box {\n    width: 100%;\n    min-height: 220px;\n    border: 1px dashed #d9d9d9;\n    background: #fafafa;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #777;\n    font-size: 15px;\n  }\n  .colamy-warranty-page .image-caption {\n    margin-top: 34px;\n    text-align: center;\n    font-size: 21px;\n    line-height: 1.4;\n    font-weight: 500;\n    color: #000;\n  }\n  .colamy-warranty-page ul,\n  .colamy-warranty-page ol { margin: 0 0 42px 0; padding-left: 0; list-style: none; }\n  .colamy-warranty-page li {\n    position: relative;\n    margin: 0 0 13px 0;\n    padding-left: 42px;\n    line-height: 1.72;\n  }\n  .colamy-warranty-page ul li::before {\n    content: \"•\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: #111111;\n    font-size: 23px;\n    line-height: 1.35;\n  }\n  .colamy-warranty-page ol { counter-reset: warranty-counter; }\n  .colamy-warranty-page ol > li { counter-increment: warranty-counter; }\n  .colamy-warranty-page ol > li::before {\n    content: counter(warranty-counter) \".\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: #111111;\n    font-size: 17px;\n    line-height: 1.75;\n  }\n  .colamy-warranty-page .plain-list { margin-bottom: 30px; }\n  .colamy-warranty-page .plain-list li { padding-left: 26px; margin-bottom: 2px; line-height: 1.52; }\n  .colamy-warranty-page .plain-list li::before { color: #111; font-size: 18px; line-height: 1.52; }\n  .colamy-warranty-page .tight-list li { margin-bottom: 2px; line-height: 1.56; }\n  .colamy-warranty-page .note { margin-top: 14px; }\n  .colamy-warranty-page .faq-title { margin-top: 55px; margin-bottom: 18px; }\n  .colamy-warranty-page .faq-list { border-top: 1px solid var(--cw-border); }\n  .colamy-warranty-page .faq-item {\n    border-bottom: 1px solid var(--cw-border);\n    margin: 0;\n  }\n  .colamy-warranty-page .faq-item summary {\n    list-style: none;\n    cursor: pointer;\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 20px;\n    padding: 18px 0;\n    font-size: 18px;\n    line-height: 1.45;\n    font-weight: 400;\n  }\n  .colamy-warranty-page .faq-item summary::-webkit-details-marker { display: none; }\n  .colamy-warranty-page .faq-item summary::after {\n    content: \"+\";\n    flex: 0 0 auto;\n    font-weight: 400;\n    font-size: 24px;\n    line-height: 1;\n    color: #111;\n  }\n  .colamy-warranty-page .faq-item[open] summary::after { content: \"−\"; }\n  .colamy-warranty-page .faq-answer {\n    padding: 0 42px 20px 0;\n    font-size: 18px;\n    line-height: 1.62;\n    color: var(--cw-muted);\n  }\n  .colamy-warranty-page .faq-answer p { margin: 0 0 14px; }\n  .colamy-warranty-page .support-title { margin-top: 42px; margin-bottom: 14px; }\n  .colamy-warranty-page .contact-line { margin: 0 0 2px; line-height: 1.48; }\n  .colamy-warranty-page a {\n    color: var(--cw-blue);\n    text-decoration: none;\n  }\n  .colamy-warranty-page a:hover {\n    text-decoration: underline;\n  }\n  .colamy-warranty-page .last-updated { margin-top: 34px; }\n  .last-updated{\n    font-weight: 700;\n  }\n  .colamy-warranty-page .warranty-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin: 30px 0 42px;\n    font-size: 16px;\n    line-height: 1.55;\n  }\n  .colamy-warranty-page .warranty-table th,\n  .colamy-warranty-page .warranty-table td {\n    border: 1px solid var(--cw-border);\n    padding: 14px 16px;\n    text-align: left;\n    vertical-align: top;\n  }\n  .colamy-warranty-page .warranty-table th {\n    background: #f8f8f8;\n    font-weight: 600;\n    color: var(--cw-text);\n    font-size: 16px;\n  }\n  .colamy-warranty-page .warranty-table td:first-child,\n  .colamy-warranty-page .warranty-table th:first-child {\n    white-space: nowrap;\n  }\n  .colamy-warranty-page .warranty-table-wrap {\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n  }\n  @media (max-width: 749px) {\n    .colamy-warranty-page { font-size: 16px; line-height: 1.62; }\n    .colamy-warranty-inner { padding: 46px 18px 48px; }\n    .colamy-warranty-page .lead p { font-size: 16px; }\n    .colamy-warranty-page h2 { font-size: 25px; margin: 44px 0 19px; }\n    .colamy-warranty-page h3 { font-size: 23px; margin: 38px 0 15px; }\n    .colamy-warranty-page li { padding-left: 28px; margin-bottom: 9px; }\n    .colamy-warranty-page .image-caption { font-size: 17px; margin-top: 20px; }\n    .colamy-warranty-page .doc-image-placeholder { margin-bottom: 38px; }\n    .colamy-warranty-page .faq-item summary,\n    .colamy-warranty-page .faq-answer { font-size: 16px; }\n  }\n</style>\n\n<div class=\"colamy-warranty-page\">\n  <div class=\"colamy-warranty-inner\">\n    <h1>Warranty Policy</h1>\n    <div class=\"lead\">\n      <p><strong>We do not believe good furniture ends at checkout.</strong></p>\n      <p><strong>We believe good service is part of the product.</strong></p>\n      <p>So you'll never find us compromising on the product quality you're purchasing today,<br>as well as our after-sales customer service.</p>\n    </div>\n\n    <h2>Warranty Overview</h2>\n    <p>COLAMY hereby warrants that the products distributed by it shall be free of all defects in original material and workmanship for the life of the product provided the product has only been used under Normal Commercial Use. COLAMY will repair or replace, at our option any product or component that is defective in material or workmanship. This warranty only applies to products purchased directly from an authorized COLAMY reseller and is valid for the original purchaser only. lf your product is no longer in stock or discontinued, your product may be replaced with a comparable or improved model. All COLAMY warranty replacements and repairs will be done at our sole discretion. Proof of purchase will be required for any warranty claims requiring replacements.</p>\n\n    <p>COLAMY promises that, as long as you (the original purchaser) still own the chair, if any material or workmanship defects are found within <strong>3-Year</strong> from the original purchase date, COLAMY will repair or replace it. This is your sole and exclusive remedy. To take advantage of this warranty, you must notify COLAMY by sending relevant pictures or videos of the defect along with a valid order number to <a href=\"mailto:hello@colamyhome.com\">hello&#64;colamyhome.com</a> <strong>within 14 days</strong> of the defect occurring, and notify COLAMY after inspection ano acceptance.</p>\n\n    <p>See below for warranty coverage details by product category.</p>\n\n    <div class=\"warranty-table-wrap\">\n    <table class=\"warranty-table\">\n      <thead>\n        <tr>\n          <th>Category</th>\n          <th>Applicable Products</th>\n          <th>Coverage Details</th>\n          <th>Exclusions</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td>Functional Seating</td>\n          <td>Office chairs, task chairs, ergonomic chairs, gaming chairs</td>\n          <td>Structural frame, mechanical components (gas lift, casters, armrest mechanisms, tilt/recline mechanisms), smart/electrical components</td>\n          <td>Normal wear and tear, foam softening, cosmetic damage, commercial use</td>\n        </tr>\n        <tr>\n          <td>Dining &amp; Accent Seating</td>\n          <td>Dining chairs, accent chairs, ottomans, benches</td>\n          <td>Structural stability, welded joints, internal frame integrity</td>\n          <td>Normal wear and tear, fabric stains, sun fading, pet damage, commercial use</td>\n        </tr>\n        <tr>\n          <td>Upholstered Furniture</td>\n          <td>Sofas, loveseats, sectionals, beds</td>\n          <td>Upholstery defects, structural frame/foundation</td>\n          <td>Normal wear and tear, foam softening, fabric stains, sun fading, pet damage, improper assembly, commercial use</td>\n        </tr>\n        <tr>\n          <td>Tables &amp; Storage Furniture</td>\n          <td>Desks, tables, cabinets, shelves</td>\n          <td>Drawer slides, hinges, hardware functionality</td>\n          <td>Normal wear and tear, surface scratches, heat damage, water damage, dragging damage, improper assembly, excessive impact, commercial use</td>\n        </tr>\n      </tbody>\n    </table>\n    </div>\n\n    <h3>Covered:</h3>\n    <ul>\n      <li>All authentic COLAMY furniture products</li>\n      <li>Products purchased through authorized retailers or official channels</li>\n    </ul>\n\n    <h3>This warranty covers:</h3>\n    <ol>\n      <li>Missing materials from the product at the time of delivery</li>\n      <li>Defects in the manufacturing of materials used for the products at the time of delivery</li>\n      <li>Failure of the products to correspond with the description in the applicable contract of sale at the time of delivery; and major defects in the functional department, such as:</li>\n    </ol>\n    <ul class=\"tight-list\">\n      <li>Casters Mechanism failure</li>\n      <li>Recline Mechanism failure</li>\n      <li>Tilt Mechanism failure</li>\n      <li>Gas lift failure</li>\n      <li>Armrest mechanism failure</li>\n    </ul>\n\n    <h3>Possible warranty solutions may include:</h3>\n    <ul class=\"tight-list\">\n      <li>Replacement parts</li>\n      <li>Repair assistance</li>\n      <li>Product replacement</li>\n      <li>Store credit</li>\n      <li>Partial reimbursement</li>\n    </ul>\n    <p>Warranty solutions will be determined by COLAMY based on product condition, inspection results, photos, or supporting evidence.</p>\n\n    <h3>What our warranty does not cover:</h3>\n    <p>All warranties listed on this page exclude the following where permited under the applicable Federal and State<br>law of the United States of America:</p>\n    <ol>\n      <li>Excludes normal wear and tear of surfaces that are not aributable to manufacturing, including but not limited to la) degradation of upholstery (PU leather/fabric/mesh), the top portion of armrests, pillows, casters exterior or mesh stitching, (b) damage to plastic coverings, (c) variance of tightness of mechanisms, and (d) excludes damage from accidents, natural disasters, physical damage from pets, fire and flood, and non-manufacturing incidents covered under insurance policies (regardless of whether you are in possession of the relevant insurance),(e)excludes any variations in dimensions and color.</li>\n      <li>Shipping Damage: Must be inspected upon receipt and reported within 48 hours.</li>\n      <li>Any claims for indirect, consequential, or incidental losses</li>\n      <li>Damage caused to all COLAMY products during selfassembly due to failure to adhere to the relevant self<br>assembly manual instructions provided.</li>\n      <li>Any commercial use of our products. This includes but is not limited to the following: landlords and leasing<br>companies as well as contracors, remodelers, and private or public businesses that purchase and /or install the<br>product in a dwelling that will be leased, used as a rental unit, or used for any other commercial or industrial use.</li>\n    </ol>\n\n    <p>To ensure your product enioyment and safety, and protection under the \"Warranty Period\", please ensure you<br>have COLAMY assembly and care guidelines for this product, and follow them for the correct assembly and care<br>for your item. Contact our customer service team to obtain these guidelines if you do not have them.</p>\n    <p class=\"note\">*Please do not dispose of any original packing materials, boxes, and parts until the issue is resolyed</p>\n\n    <h3>Assembly &amp; Installation</h3>\n    <p>To ensure safety and long-term performance:</p>\n    <ul class=\"plain-list\">\n      <li>Follow assembly instructions carefully</li>\n      <li>Do not overtighten hardware</li>\n      <li>Recheck hardware periodically</li>\n      <li>Use products only as intended</li>\n    </ul>\n    <p>Improper assembly may affect warranty eligibility.</p>\n\n    <h3>Weight Capacity &amp; Intended Use</h3>\n    <p>All COLAMY products are designed for intended residential use.</p>\n    <p>Damage caused by:</p>\n    <ul class=\"plain-list\">\n      <li>Standing on furniture</li>\n      <li>Jumping</li>\n      <li>Excessive force</li>\n      <li>Improper use</li>\n      <li>Exceeding weight recommendations</li>\n    </ul>\n    <p>is not covered under warranty.</p>\n\n    <h3>Product Care &amp; Maintenance</h3>\n\n    <div class=\"warranty-table-wrap\">\n    <table class=\"warranty-table\">\n      <thead>\n        <tr>\n          <th>Category</th>\n          <th>Care Instructions</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td>General Care</td>\n          <td>\n            <ul class=\"plain-list\">\n              <li>Avoid prolonged direct sunlight</li>\n              <li>Avoid excessive moisture</li>\n              <li>Use soft cloths for cleaning</li>\n              <li>Tighten hardware periodically</li>\n            </ul>\n          </td>\n        </tr>\n        <tr>\n          <td>Fabric Care</td>\n          <td>\n            <ul class=\"plain-list\">\n              <li>Vacuum regularly</li>\n              <li>Clean spills immediately</li>\n            </ul>\n          </td>\n        </tr>\n        <tr>\n          <td>Faux Leather Care</td>\n          <td>\n            <ul class=\"plain-list\">\n              <li>Use soft damp cloth only</li>\n              <li>Avoid alcohol-based cleaners</li>\n            </ul>\n          </td>\n        </tr>\n        <tr>\n          <td>Wood Surface Care</td>\n          <td>\n            <ul class=\"plain-list\">\n              <li>Use coasters and placemats</li>\n              <li>Avoid standing water</li>\n            </ul>\n          </td>\n        </tr>\n      </tbody>\n    </table>\n    </div>\n\n    <h3>What Is Considered Normal</h3>\n    <p>The following are considered normal and are not defects:</p>\n    <ul class=\"plain-list\">\n      <li>Minor color variation</li>\n      <li>Natural wood grain differences</li>\n      <li>Cushion softening</li>\n      <li>Packaging wrinkles</li>\n      <li>Slight assembly tolerance</li>\n      <li>Minor sound during mechanism adjustment</li>\n    </ul>\n\n    <h3 class=\"faq-title\">Frequently Q&amp;A</h3>\n    <div class=\"faq-list\">\n      <details class=\"faq-item\">\n        <summary>How long is the warranty period?</summary>\n        <div class=\"faq-answer\"><p>COLAMY promises that, as long as you (the original purchaser) still own the chair, if any material or workmanship defects are found within one year from the original purchase date (three years for the Atlas Chair, Atlas-01 Chair and VELlA Chair), COLAMY will repair or replace it.</p></div>\n      </details>\n      <details class=\"faq-item\">\n        <summary>Do I need to register to activate the warranty?</summary>\n        <div class=\"faq-answer\"><p>You can enjoy our warranty service without registering an account. However, we recommend creating one, as it allows you to conveniently view and manage your orders in the user center.</p></div>\n      </details>\n      <details class=\"faq-item\">\n        <summary>For a replacement product, how long is the remaining warranty period?</summary>\n        <div class=\"faq-answer\"><p>If a product is replaced during the warranty period, the remaining warranty coverage will continue based on the warranty period of the original order.</p></div>\n      </details>\n      <details class=\"faq-item\">\n        <summary>How do I file a warranty claim ?</summary>\n        <div class=\"faq-answer\"><p>If you believe you are eligible to file a warranty claim, please contact us at <a href=\"mailto:hello@colamyhome.com\">hello&#64;colamyhome.com</a> or fill out the Contact Form to describe your problem in detail.</p><p>Please be sure to provide all necessary information related to the claim, including the original order details, a complete description of the issue, and photographic or video evidence clearly showing the problem.</p></div>\n      </details>\n      <details class=\"faq-item\">\n        <summary>How can I purchase spare parts after the warranty period?</summary>\n        <div class=\"faq-answer\"><p>If your order is out of warranty and you wish to purchase additional accessories, please contact us at <a href=\"mailto:hello@colamyhome.com\">hello&#64;colamyhome.com</a>, providing your order number and the model of the accessory you need (refer to the manual). We will check the stock and quotation for you and provide further instructions.</p></div>\n      </details>\n    </div>\n\n    <h3 class=\"support-title\">Customer Support Contact Information</h3>\n    <p class=\"contact-line\">📧&nbsp;&nbsp; <a href=\"mailto:hello@colamyhome.com\">hello&#64;colamyhome.com</a></p>\n    <p class=\"contact-line\">☎️&nbsp;&nbsp; +1 (888) 886-1743</p>\n    <p class=\"contact-line\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Monday to Friday 9:00-17:00 Pacific Standard Time</p>\n\n    <p class=\"last-updated\">Last updated: April 15, 2026</p>\n  </div>\n</div>",
