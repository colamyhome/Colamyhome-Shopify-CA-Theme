          "type": "column",
          "settings": {
            "image": "shopify://shop_images/07_cb19b905-9be2-4c8d-9870-dc01a4278047.jpg",
            "title": "<strong>Designed for Real Life</strong>",
            "highlight_style": "none",
            "highlight_font_style": "italic",
            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h4",
            "text": "<p>Designed for how you actually live. We don’t design for showrooms. We design for pieces that feel effortless in the home—silhouettes that feel easy to style, details that work across spaces, and pieces that stay useful long after the room is finished. Good furniture shouldn’t ask too much from the room around it.</p>",
            "text_size": "text-base",
            "button_label": "",
            "button_link": "",
            "button_style": "btn--underline",
            "button_icon": "none"
          }
        },
        "column_fDFpY7": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/08_eeb1520c-efa7-444e-869e-dbc804c47e67.jpg",
