        "text_Rt3igP": {
          "type": "text",
          "settings": {
            "text": "<p>Today, COLAMY stands for a<em>curated</em>approach to modern living. We’re still the seating experts, but now we’re your partners in creating a home that’s comfortable, functional, and uniquely yours — without the overwhelm.</p>",
