      "settings": {
        "custom_liquid": "<style>\n  .colamy-warranty-page {\n    --cw-text: #111111;\n    --cw-muted: #333333;\n    --cw-blue: #2f6df6;\n    --cw-border: #e5e5e5;\n    font-family: Arial, Helvetica, sans-serif;\n    color: var(--cw-text);\n    background: #ffffff;\n    line-height: 1.25;\n    font-size: 18px;\n  }\n  .colamy-warranty-page * { box-sizing: border-box; }\n  .colamy-warranty-inner {\n    width: 100%;\n    max-width: 1600px;\n    margin: 0 auto;\n    padding: 92px 22px 72px;\n  }\n  .colamy-warranty-page p { margin: 0 0 10px; }\n  .colamy-warranty-page .lead p { font-size: 19px; line-height: 1.25; margin-bottom: 14px; }\n  .colamy-warranty-page .lead strong { font-weight: 500; }\n  .colamy-warranty-page h1 {\n    text-align: center;\n    font-size: 36px;\n    line-height: 1.25;\n    margin: 0px 0 26px;\n    font-weight: 700;\n    letter-spacing: -0.02em;\n  }\n  .colamy-warranty-page h2 {\n    font-size: 30px;\n    line-height: 1.25;\n    margin: 0px 0 26px;\n    font-weight: 500;\n    letter-spacing: -0.02em;\n  }\n  .colamy-warranty-page h3 {\n    font-size: 28px;\n    line-height: 1.25;\n    margin: 56px 0 20px;\n    font-weight: 500;\n    letter-spacing: -0.015em;\n  }\n  .colamy-warranty-page .section-title { margin-top: 46px; }\n  .colamy-warranty-page .spacer-large { height: 34px; }\n  .colamy-warranty-page .doc-image-placeholder { margin: 2px 0 54px; text-align: center; }\n  .colamy-warranty-page .doc-image-placeholder-box {\n    width: 100%;\n    min-height: 220px;\n    border: 1px dashed #d9d9d9;\n    background: #fafafa;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #777;\n    font-size: 15px;\n  }\n  .colamy-warranty-page .image-caption {\n    margin-top: 34px;\n    text-align: center;\n    font-size: 21px;\n    line-height: 1.25;\n    font-weight: 500;\n    color: #000;\n  }\n  .colamy-warranty-page ul,\n  .colamy-warranty-page ol { margin: 0 0 42px 0; padding-left: 0; list-style: none; }\n  .colamy-warranty-page li {\n    position: relative;\n    margin: 0 0 0px 0;\n    padding-left: 42px;\n    line-height: 1.25;\n  }\n  .colamy-warranty-page ul li::before {\n    content: \"•\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: #111111;\n    font-size: 23px;\n    line-height: 1.25;\n  }\n  .colamy-warranty-page ol { counter-reset: warranty-counter; }\n  .colamy-warranty-page ol > li { counter-increment: warranty-counter; }\n  .colamy-warranty-page ol > li::before {\n    content: counter(warranty-counter) \".\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: #111111;\n    font-size: 17px;\n    line-height: 1.25;\n  }\n  .colamy-warranty-page .plain-list { margin-bottom: 30px; }\n  .colamy-warranty-page .plain-list li { padding-left: 26px; margin-bottom: 2px; line-height: 1.25; }\n  .colamy-warranty-page .plain-list li::before { color: #111; font-size: 18px; line-height: 1.25; }\n  .colamy-warranty-page .tight-list li { margin-bottom: 2px; line-height: 1.25; }\n  .colamy-warranty-page .note { margin-top: 14px; }\n  .colamy-warranty-page .faq-title { margin-top: 55px; margin-bottom: 18px; }\n  .colamy-warranty-page .faq-list { border-top: 1px solid var(--cw-border); }\n  .colamy-warranty-page .faq-item {\n    border-bottom: 1px solid var(--cw-border);\n    margin: 0;\n  }\n  .colamy-warranty-page .faq-item summary {\n    list-style: none;\n    cursor: pointer;\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 20px;\n    padding: 18px 0;\n    font-size: 18px;\n    line-height: 1.25;\n    font-weight: 400;\n  }\n  .colamy-warranty-page .faq-item summary::-webkit-details-marker { display: none; }\n  .colamy-warranty-page .faq-item summary::after {\n    content: \"+\";\n    flex: 0 0 auto;\n    font-weight: 400;\n    font-size: 24px;\n    line-height: 1.25;\n    color: #111;\n  }\n  .colamy-warranty-page .faq-item[open] summary::after { content: \"−\"; }\n  .colamy-warranty-page .faq-answer {\n    padding: 0 42px 20px 0;\n    font-size: 18px;\n    line-height: 1.25;\n    color: var(--cw-muted);\n  }\n  .colamy-warranty-page .faq-answer p { margin: 0 0 14px; }\n  .colamy-warranty-page .support-title { margin-top: 42px; margin-bottom: 14px; }\n  .colamy-warranty-page .contact-line { margin: 0 0 2px; line-height: 1.25; }\n  .colamy-warranty-page a {\n    color: var(--cw-blue);\n    text-decoration: none;\n  }\n  .colamy-warranty-page a:hover {\n    text-decoration: underline;\n  }\n  .colamy-warranty-page .last-updated { margin-top: 34px; }\n  .last-updated{\n    font-weight: 700;\n  }\n  .colamy-warranty-page .refund-faq-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin: 14px 0;\n    font-size: 16px;\n    line-height: 1.25;\n  }\n  .colamy-warranty-page .refund-faq-table th,\n  .colamy-warranty-page .refund-faq-table td {\n    border: 1px solid var(--cw-border);\n    padding: 14px 16px;\n    text-align: left;\n    vertical-align: top;\n  }\n  .colamy-warranty-page .refund-faq-table th {\n    background: #f8f8f8;\n    font-weight: 600;\n    color: var(--cw-text);\n  }\n  @media (max-width: 749px) {\n    .colamy-warranty-page { font-size: 16px; line-height: 1.25; }\n    .colamy-warranty-inner { padding: 46px 18px 48px; }\n    .colamy-warranty-page .lead p { font-size: 16px; }\n    .colamy-warranty-page h2 { font-size: 25px; margin: 44px 0 19px; }\n    .colamy-warranty-page h3 { font-size: 23px; margin: 38px 0 15px; }\n    .colamy-warranty-page li { padding-left: 28px; margin-bottom: 9px; }\n    .colamy-warranty-page .image-caption { font-size: 17px; margin-top: 20px; }\n    .colamy-warranty-page .doc-image-placeholder { margin-bottom: 38px; }\n    .colamy-warranty-page .faq-item summary,\n    .colamy-warranty-page .faq-answer { font-size: 16px; }\n  }\n\n  .colamy-warranty-page .doc-image {\n    margin: 2px 0 24px;\n    text-align: left;\n  }\n  .colamy-warranty-page .doc-image img {\n    max-width: 500px;\n    width: auto;\n    height: auto;\n    display: block;\n    margin: 0;\n  }\n\n</style>\n\n<div class=\"colamy-warranty-page\">\n  <div class=\"colamy-warranty-inner\">\n    <h1>Return & Refunds</h1>\n\n    <h2>30-Day Satisfaction Guarantee</h2>\n\n    <p>Thank you for shopping at COLAMY! We want you to love our products and offer a 30-Day Satisfaction Guarantee. During this period, if you decide your piece isn't quite right, we're here to help at <a href=\"mailto:hello@colamyhome.com\">hello@colamyhome.com</a>. You can initiate a return or exchange request within 30 days of the item's delivery date by providing proof of purchase.</p>\n\n    <p>As with any shopping experience, there are terms and conditions that apply to transactions at COLAMY. By placing an order or making a purchase at COLAMY, you agree to the terms set forth below along with the COLAMY Return Policy.</p>\n\n    <p>For more details, please refer to the tables below.</p>\n\n    <h3 class=\"section-title\">Policy Details</h3>\n    <div class=\"faq-list\">\n      <details class=\"faq-item\">\n        <summary>Quality Issues / Shipping Damage</summary>\n        <div class=\"faq-answer\">\n          <p><strong>Submission Window:</strong> ≤ 7 days</p>\n          <p><strong>Resolution Process:</strong></p>\n          <ul class=\"plain-list\">\n            <li>Provide your order number and a brief description of the specific issue.</li>\n            <li>Upload clear photos or videos demonstrating the actual issue or the condition of the packaging.</li>\n            <li>Provide the batch number printed on the side of the carton.</li>\n          </ul>\n          <p class=\"note\">Please retain the original packaging for subsequent verification purposes.</p>\n          <p><strong>What We Offer:</strong> Free refunds, exchanges, or repairs.</p>\n          <p><strong>Any Cost:</strong> 0</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Incorrect / Missing Items</summary>\n        <div class=\"faq-answer\">\n          <p><strong>Submission Window:</strong> ≤ 7 days</p>\n          <p><strong>Processing Procedure:</strong></p>\n          <p>Please provide your Order Number and a brief description of the specific issue.</p>\n          <ul class=\"plain-list\">\n            <li>For incorrect items: clear photo of the outer packaging box (showing model/batch number)</li>\n            <li>Clear photo of the shipping label/waybill</li>\n            <li>Clear photo of the received incorrect product</li>\n            <li>For missing items: photos of the package and its contents (if possible)</li>\n          </ul>\n          <p class=\"note\">Please retain the original packaging for subsequent verification purposes.</p>\n          <p><strong>What We Offer:</strong> We’ll verify the issue and promptly send the correct or missing item(s), or offer a refund or exchange where applicable.</p>\n          <p><strong>Any Cost:</strong> 0</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Change Your Mind / Not Fully Satisfied</summary>\n        <div class=\"faq-answer\">\n          <p><strong>Submission Window:</strong> ≤ 30 days</p>\n          <p><strong>What To Do:</strong></p>\n          <ul class=\"plain-list\">\n            <li>Ensure the item is unused, unassembled, and in its original condition</li>\n            <li>Keep the original packaging (required for returns)</li>\n            <li>Submit your order number along with a brief reason for return</li>\n            <li>Upload photos or videos to confirm the item’s condition</li>\n          </ul>\n          <p><strong>What We Offer:</strong> We will process a refund or exchange once the item is received and inspected.</p>\n          <p><strong>Any Cost:</strong> 0</p>\n        </div>\n      </details>\n    </div>\n\n    <h3 class=\"section-title\">Returns</h3>\n    <p>Return requests can only be made within 30 days of the date you received the item. To initiate this request, please contact us so that we can facilitate the return.</p>\n    <p>Please note: All returns and exchanges should be made with the original COLAMY packaging.</p>\n    <p>Only items in like-new condition can be returned, with no missing parts. We do not accept returns with stains, scratches, drilling, or any other modifications made to the product. Products must be completely disassembled; we do not accept partially assembled products.</p>\n    <p>Please return the items in the original packaging, which is designed to avoid shipping damage. If you no longer have the original packaging, use suitable packing material to protect the item during transit back to us.</p>\n    <p>We reserve the right not to refund a product that, in our reasonable opinion, has become of unacceptable quality due to wear and tear, misuse, or failure to take reasonable care of the product.</p>\n    <p>For all U.S. orders, shipping will be covered by COLAMY and we will provide a pre-paid return label; please contact us for a label before sending the item back.</p>\n    <p>We are unable to accommodate returns/exchanges/refunds for the following items:</p>\n    <ul class=\"plain-list\">\n      <li>Clearance (Non-Quality Issues)</li>\n      <li>Final Sale</li>\n      <li>Large item</li>\n    </ul>\n    <p>For large items (&gt;200 lbs), we do not accept returns or exchanges within 30 days unless the item is defective or damaged.</p>\n    <p>Please ensure you have reviewed all product details, including dimensions and specifications, before placing your order. If you have any questions, feel free to contact our customer support team.</p>\n\n    <h3 class=\"section-title\">How to Start a Return</h3>\n    <p>Please refer to the following steps for the return process:</p>\n\n    {% comment %} <div class=\"doc-image\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0685/2739/1017/files/return_process.png?v=1779349735\" alt=\"How to Start a Return\" width=\"100%\" height=\"100%\">\n    </div> {% endcomment %}\n\n    <ol>\n        <li>Contact us at <a href=\"mailto:hello@colamyhome.com\">hello@colamyhome.com</a> or fill out the Contact Form to describe your issue in detail:\n            <ul class=\"plain-list\">\n            <li>Take photos or videos showing the defective parts of the product or the package.</li>\n            <li>Take photos of the shipping label, batch number, and package box to help us identify the status.</li>\n            <li>Contact us with the photos, videos, and the order number. Also, make a short description of your concerns. Our customer service will get back to you within 24 business hours.</li>\n            </ul>\n        </li>\n        <li>If you meet the return conditions, we will provide a free shipping label for the return.</li>\n        <li>After sending the return package, please notify us as soon as possible so we can process your refund promptly.</li>\n        <li>Once you have completed the return, please notify us immediately so that we can process your refund promptly.</li>\n    </ol>\n\n    <h3 class=\"section-title\">Notice</h3>\n    <p>Products that suffer from defects during their usable lifetime, as outlined in the COLAMY Warranty Policy, qualify for repair or replacement at no cost to the customer, inclusive of shipping costs. Please review the COLAMY Warranty Policy for further details.</p>\n\n    <h3 class=\"section-title\">Refund Timeline</h3>\n    <p>We will initiate your refund as soon as a valid return tracking number is provided and shows an active shipping status. Funds will be processed back to your original form of payment (e.g., Credit Card, PayPal).</p>\n    <p>For credit cards, please allow 3 to 5 business days for the refund to post to your account; some banks may reflect it on your next statement.</p>\n\n    <h3 class=\"section-title\">Cancellation of Orders with Promotional Code</h3>\n    <p>If you cancel any item(s) in your order with a discount voucher/coupon applied, you will be refunded only the final paid price after the applied discount. Please contact us to process this request.</p>\n\n    <h3 class=\"section-title\">Return Address</h3>\n    <p>COLAMY Inc Warehouse<br>10985 Oleander Ave, Fontana CA 92337</p>\n    <p>For safety and security reasons, we do not accept personal drop-offs.</p>\n\n    <h3 class=\"faq-title\">Frequently Q&amp;A</h3>\n    <div class=\"faq-list\">\n      <details class=\"faq-item\">\n        <summary>Can the order still be cancelled after it has been shipped?</summary>\n        <div class=\"faq-answer\">\n          <p>If your order has already been shipped and you wish to cancel it, please contact us immediately. We will attempt to intercept the package on your behalf; however, we cannot guarantee success. If we are unable to intercept it, you may need to contact the shipping carrier to refuse delivery.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Why should I keep the original packaging?</summary>\n        <div class=\"faq-answer\">\n          <p>Our packaging is tailored to each product to ensure safe transit. Returning products without the original packaging increases the risk of damage during transit, which can affect refund eligibility. We recommend keeping all packaging to ensure a smooth return process and protect your refund eligibility.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>When will I receive my refund?</summary>\n        <div class=\"faq-answer\">\n          <table class=\"refund-faq-table\">\n            <thead>\n              <tr>\n                <th>Payment Method</th>\n                <th>When to Initiate a Refund?</th>\n                <th>When Will I Receive My Refund?</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <td>PayPal</td>\n                <td>—</td>\n                <td>For PayPal payments, the refund will typically appear in your PayPal account immediately after it is processed.</td>\n              </tr>\n              <tr>\n                <td>Credit Card (including: Apple Pay, Google Pay, Affirm, etc.)</td>\n                <td>We will initiate your refund as soon as a valid return tracking number is provided and shows an active shipping status.</td>\n                <td>For credit cards or other methods, please note that it may take additional time for your bank or credit card provider to reflect the refund on your statement.</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>What should I do if I still haven't received my refund?</summary>\n        <div class=\"faq-answer\">\n          <p>If you have not received your refund after it was approved, first confirm that we have processed it (check our refund notification email) and allow your bank's normal processing time. Then:</p>\n          <ul class=\"plain-list\">\n            <li>Check your bank/card statement or PayPal/online wallet history</li>\n            <li>Contact your bank or payment provider with our refund confirmation</li>\n            <li>If you still cannot locate it, contact us with your order number and refund details and we will help you check the status</li>\n          </ul>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Will there be any additional fees for returns?</summary>\n        <div class=\"faq-answer\">\n          <p>For all orders within the U.S., you won’t incur any fees for returns — COLAMY will cover the costs.</p>\n        </div>\n      </details>\n    </div>\n\n    <p class=\"last-updated\">Last updated: April 15, 2026</p>\n\n  </div>\n</div>",
