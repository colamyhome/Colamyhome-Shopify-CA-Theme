    "custom_liquid_HgDW7R": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "custom_liquid": "<section class=\"colamy-countdown\" data-cycle-hours=\"24\">\n  <div class=\"countdown-inner\">\n    <div class=\"countdown-text\">\n      <p class=\"countdown-eyebrow\">Limited-Time Summer Sale</p>\n      <h2>Summer Deals End Soon</h2>\n      <p class=\"countdown-subtitle\">\n        Refresh your dining room and workspace with extra savings before this offer resets.\n      </p>\n    </div>\n\n    <div class=\"countdown-timer\">\n      <div class=\"time-box\">\n        <span class=\"cd-days\">00</span>\n        <small>Days</small>\n      </div>\n      <div class=\"time-box\">\n        <span class=\"cd-hours\">00</span>\n        <small>Hours</small>\n      </div>\n      <div class=\"time-box\">\n        <span class=\"cd-minutes\">00</span>\n        <small>Min</small>\n      </div>\n      <div class=\"time-box\">\n        <span class=\"cd-seconds\">00</span>\n        <small>Sec</small>\n      </div>\n    </div>\n  </div>\n</section>\n\n<style>\n  .colamy-countdown {\n    width: 100%;\n    padding: 28px 20px;\n    border: 1px solid rgba(200, 161, 101, 0.35);\n  }\n\n  .countdown-inner {\n    max-width: 1200px;\n    margin: 0 auto;\n    display: grid;\n    grid-template-columns: 1.5fr auto;\n    align-items: center;\n    gap: 28px;\n  }\n\n  .countdown-eyebrow {\n    margin: 0 0 6px;\n    font-size: 13px;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: #98361a;\n    font-weight: 600;\n  }\n\n  .countdown-text h2 {\n    margin: 0;\n    font-size: 30px;\n    line-height: 1.2;\n    color: #2b2118;\n  }\n\n  .countdown-subtitle {\n    margin: 8px 0 0;\n    font-size: 15px;\n    line-height: 1.5;\n    color: #6f6258;\n    max-width: 560px;\n  }\n\n  .countdown-timer {\n    display: flex;\n    gap: 10px;\n  }\n\n  .time-box {\n    min-width: 72px;\n    padding: 12px 10px;\n    background: #ffffff;\n    border: 1px solid rgba(43, 33, 24, 0.1);\n    text-align: center;\n  }\n\n  .time-box span {\n    display: block;\n    font-size: 26px;\n    line-height: 1;\n    font-weight: 700;\n    color: #98361a;\n  }\n\n  .time-box small {\n    display: block;\n    margin-top: 6px;\n    font-size: 12px;\n    color: #6f6258;\n    text-transform: uppercase;\n    letter-spacing: 0.04em;\n  }\n\n  @media (max-width: 768px) {\n    .colamy-countdown {\n      padding: 24px 16px;\n    }\n\n    .countdown-inner {\n      grid-template-columns: 1fr;\n      gap: 18px;\n      text-align: center;\n    }\n\n    .countdown-text h2 {\n      font-size: 24px;\n    }\n\n    .countdown-subtitle {\n      margin-left: auto;\n      margin-right: auto;\n      font-size: 14px;\n    }\n\n    .countdown-timer {\n      justify-content: center;\n      gap: 8px;\n    }\n\n    .time-box {\n      min-width: 64px;\n      padding: 10px 6px;\n    }\n\n    .time-box span {\n      font-size: 22px;\n    }\n  }\n</style>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n    const countdown = document.querySelector(\".colamy-countdown\");\n    if (!countdown) return;\n\n    const cycleHours = Number(countdown.dataset.cycleHours) || 24;\n    const cycleMs = cycleHours * 60 * 60 * 1000;\n\n    const daysEl = countdown.querySelector(\".cd-days\");\n    const hoursEl = countdown.querySelector(\".cd-hours\");\n    const minutesEl = countdown.querySelector(\".cd-minutes\");\n    const secondsEl = countdown.querySelector(\".cd-seconds\");\n\n    function pad(num) {\n      return String(num).padStart(2, \"0\");\n    }\n\n    function updateCountdown() {\n      const now = Date.now();\n      const startPoint = new Date(\"2026-07-01T00:00:00-07:00\").getTime();\n      const elapsed = now - startPoint;\n      const remaining = cycleMs - (elapsed % cycleMs);\n\n      const days = Math.floor(remaining / (1000 * 60 * 60 * 24));\n      const hours = Math.floor((remaining / (1000 * 60 * 60)) % 24);\n      const minutes = Math.floor((remaining / (1000 * 60)) % 60);\n      const seconds = Math.floor((remaining / 1000) % 60);\n\n      daysEl.textContent = pad(days);\n      hoursEl.textContent = pad(hours);\n      minutesEl.textContent = pad(minutes);\n      secondsEl.textContent = pad(seconds);\n    }\n\n    updateCountdown();\n    setInterval(updateCountdown, 1000);\n  });\n</script>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
