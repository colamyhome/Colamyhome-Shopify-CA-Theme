      "settings": {
        "custom_liquid": "<style>\n  .colamy-warranty-page {\n    --cw-text: #111111;\n    --cw-muted: #333333;\n    --cw-blue: #2f6df6;\n    --cw-border: #e5e5e5;\n    font-family: Arial, Helvetica, sans-serif;\n    color: var(--cw-text);\n    background: #ffffff;\n    line-height: 1.25;\n    font-size: 18px;\n  }\n  .colamy-warranty-page * { box-sizing: border-box; }\n  .colamy-warranty-page img { max-width: 400px; width: auto; height: auto; display: block; margin: 0; }\n  .colamy-warranty-inner {\n    width: 100%;\n    max-width: 1600px;\n    margin: 0 auto;\n    padding: 92px 22px 72px;\n  }\n  .colamy-warranty-page p { margin: 0 0 10px; }\n  .colamy-warranty-page .lead p { font-size: 19px; line-height: 1.52; margin-bottom: 14px; }\n  .colamy-warranty-page .lead strong { font-weight: 500; }\n  .colamy-warranty-page h1 {\n    text-align: center;\n    font-size: 36px;\n    line-height: 1.25;\n    margin: 0px 0 26px;\n    font-weight: 700;\n    letter-spacing: -0.02em;\n  }\n  .colamy-warranty-page h2 {\n    font-size: 30px;\n    line-height: 1.25;\n    margin: 0px 0 26px;\n    font-weight: 500;\n    letter-spacing: -0.02em;\n  }\n  .colamy-warranty-page h3 {\n    font-size: 28px;\n    line-height: 1.25;\n    margin: 30px 0 10px;\n    font-weight: 500;\n    letter-spacing: -0.015em;\n  }\n  .colamy-warranty-page .section-title { margin-top: 46px; }\n  .colamy-warranty-page .spacer-large { height: 34px; }\n  .colamy-warranty-page .doc-image-placeholder { margin: 2px 0 54px; text-align: center; }\n  .colamy-warranty-page .doc-image-placeholder-box {\n    width: 100%;\n    min-height: 220px;\n    border: 1px dashed #d9d9d9;\n    background: #fafafa;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #777;\n    font-size: 15px;\n  }\n  .colamy-warranty-page .image-caption {\n    margin-top: 34px;\n    text-align: center;\n    font-size: 21px;\n    line-height: 1.25;\n    font-weight: 500;\n    color: #000;\n  }\n  .colamy-warranty-page ul,\n  .colamy-warranty-page ol { margin: 0 0 42px 0; padding-left: 0; list-style: none; }\n  .colamy-warranty-page li {\n    position: relative;\n    margin: 0 0 13px 0;\n    padding-left: 42px;\n    line-height: 1.72;\n  }\n  .colamy-warranty-page ul li::before {\n    content: \"•\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: #111111;\n    font-size: 23px;\n    line-height: 1.35;\n  }\n  .colamy-warranty-page ol { counter-reset: warranty-counter; }\n  .colamy-warranty-page ol > li { counter-increment: warranty-counter; }\n  .colamy-warranty-page ol > li::before {\n    content: counter(warranty-counter) \".\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: #111111;\n    font-size: 17px;\n    line-height: 1.25;\n  }\n  .colamy-warranty-page .plain-list { margin-bottom: 30px; }\n  .colamy-warranty-page .plain-list li { padding-left: 26px; margin-bottom: 2px; line-height: 1.52; }\n  .colamy-warranty-page .plain-list li::before { color: #111; font-size: 18px; line-height: 1.52; }\n  .colamy-warranty-page .tight-list li { margin-bottom: 2px; line-height: 1.56; }\n  .colamy-warranty-page .note { margin-top: 14px; }\n  .colamy-warranty-page .faq-title { margin-top: 55px; margin-bottom: 18px; }\n  .colamy-warranty-page .faq-list { border-top: 1px solid var(--cw-border); }\n  .colamy-warranty-page .faq-item {\n    border-bottom: 1px solid var(--cw-border);\n    margin: 0;\n  }\n  .colamy-warranty-page .faq-item summary {\n    list-style: none;\n    cursor: pointer;\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 20px;\n    padding: 18px 0;\n    font-size: 18px;\n    line-height: 1.25;\n    font-weight: 400;\n  }\n  .colamy-warranty-page .faq-item summary::-webkit-details-marker { display: none; }\n  .colamy-warranty-page .faq-item summary::after {\n    content: \"+\";\n    flex: 0 0 auto;\n    font-weight: 400;\n    font-size: 24px;\n    line-height: 1;\n    color: #111;\n  }\n  .colamy-warranty-page .faq-item[open] summary::after { content: \"−\"; }\n  .colamy-warranty-page .faq-answer {\n    padding: 0 42px 20px 0;\n    font-size: 18px;\n    line-height: 1.25;\n    color: var(--cw-muted);\n  }\n  .colamy-warranty-page .faq-answer p { margin: 0 0 14px; }\n  .colamy-warranty-page .support-title { margin-top: 42px; margin-bottom: 14px; }\n  .colamy-warranty-page .contact-line { margin: 0 0 2px; line-height: 1.25; }\n  .colamy-warranty-page a {\n    color: var(--cw-blue);\n    text-decoration: none;\n  }\n  .colamy-warranty-page a:hover {\n    text-decoration: underline;\n  }\n  .colamy-warranty-page .last-updated { margin-top: 34px; }\n  .last-updated{\n    font-weight: 700;\n  }\n  @media (max-width: 749px) {\n    .colamy-warranty-page { font-size: 16px; line-height: 1.62; }\n    .colamy-warranty-inner { padding: 46px 18px 48px; }\n    .colamy-warranty-page .lead p { font-size: 16px; }\n    .colamy-warranty-page h2 { font-size: 25px; margin: 44px 0 19px; }\n    .colamy-warranty-page h3 { font-size: 23px; margin: 38px 0 15px; }\n    .colamy-warranty-page li { padding-left: 28px; margin-bottom: 9px; }\n    .colamy-warranty-page .image-caption { font-size: 17px; margin-top: 20px; }\n    .colamy-warranty-page .doc-image-placeholder { margin-bottom: 38px; }\n    .colamy-warranty-page .faq-item summary,\n    .colamy-warranty-page .faq-answer { font-size: 16px; }\n  }\n\n  .colamy-warranty-page .doc-image {\n    margin: 2px 0 24px;\n    text-align: left;\n  }\n  .colamy-warranty-page .doc-image img {\n    max-width: 500px;\n    width: auto;\n    height: auto;\n    display: block;\n    margin: 0;\n  }\n\n</style>\n\n<div class=\"colamy-warranty-page\">\n  <div class=\"colamy-warranty-inner\">\n    <h1>Shipping &amp; Delivery</h1>\n\n    <p>COLAMY accepts U.S. orders temporarily.</p>\n    <p>COLAMY provides free shipping on all U.S. orders.</p>\n    <p>COLAMY ships all U.S. orders from local warehouses in California, Texas &amp; New Jersey.</p>\n    <p>95% of COLAMY orders arrive within one week, which includes 1–2 days for order processing.</p>\n    <p>Pre-sale items will be shipped according to the estimated delivery time indicated on the product page.</p>\n\n    <h2>Where We Ship</h2>\n\n    <h3 class=\"section-title\">Standard Products</h3>\n    <ul class=\"plain-list\">\n      <li><strong>Delivery Method:</strong> FedEx</li>\n      <li><strong>Deliverable Area:</strong> Contiguous 48 U.S. states</li>\n      <li><strong>Shipping Cost:</strong> Free</li>\n      <li><strong>Shipping Time:</strong> 5 – 7 business days</li>\n    </ul>\n\n    <h3 class=\"section-title\">Oversized Items (e.g.Sofas)</h3>\n    <ul class=\"plain-list\">\n      <li><strong>Delivery Method:</strong> Truck Delivery</li>\n      <li><strong>Deliverable Area:</strong> Contiguous 48 U.S. states</li>\n      <li><strong>Shipping Cost:</strong> Free</li>\n      <li><strong>Shipping Time:</strong> 2 – 4 weeks</li>\n    </ul>\n\n    <p class=\"note\">For U.S. orders, free shipping is applied for all COLAMY products purchased directly on the website only for the 48 contiguous states (EXCEPT Hawaii, Alaska, Puerto Rico, and Guam).</p>\n    <p class=\"note\">Due to the restrictions on our partner carrier, we currently do not deliver to PO BOX addresses and APO/FPO Military addresses.</p>\n\n    <h3 class=\"section-title\">Order Change / Cancellation</h3>\n    <p>If you decide to change or cancel your order, please contact us at <a href=\"mailto:hello@colamyhome.com\">hello@colamyhome.com</a> in time before you receive the shipment notification email. You will have 24 hours or less to request changes or cancellations without incurring charges, since we work to have all orders dispatched to you as soon as possible. Therefore, we always recommend that you check your address at the checkout page.</p>\n    <p>After that, your shipment will be processed and any changes or cancellations from thereon may not be accepted successfully and may need to be handled according to the return procedure. For more details, please visit our Return &amp; Refunds policy page.</p>\n\n    <h3 class=\"section-title\">Processing Time &amp; Shipping Time</h3>\n    <p>Before shipping, the warehouse usually needs 1–2 business days to process the packing and outbound of the package.</p>\n    <p>The shipping time frame is how long it takes for the product to reach your location. It is calculated from the estimated shipping date to the delivery date. For the contiguous 48 U.S. states, the shipping time is usually around 5–7 business days.</p>\n    <p>Please note that each item in one order may have different estimated shipping dates due to its availability in stock.</p>\n    <p>For pre-sale orders, please refer to the estimated shipping time on the product page.</p>\n\n    <h3 class=\"section-title\">Track My Order</h3>\n    <p>You will receive a shipment notification email when your order departs our local warehouse. After that, you can track your parcel via the methods below:</p>\n    <ol>\n      <li>Check the order details from My Account &gt; Order History</li>\n      <li>Check the link from the shipment notification email sent by COLAMY</li>\n      <li>Use the tracking number to check from the express website: <a href=\"https://www.fedex.com\" target=\"_blank\" rel=\"noopener\">https://www.fedex.com</a></li>\n    </ol>\n\n    <p>For more shipping information, please contact us at <a href=\"mailto:hello@colamyhome.com\">hello@colamyhome.com</a> for help.</p>\n\n    <h2>Delivery Exceptions</h2>\n    <p>If you are experiencing any issues with your delivery, please contact us at <a href=\"mailto:hello@colamyhome.com\">hello@colamyhome.com</a>, so we can help resolve the problem as quickly as possible.</p>\n\n    <h3 class=\"section-title\">Delayed / Missed Delivery</h3>\n    <p>If your order is late or seems to be missing, please:</p>\n    <ul class=\"plain-list\">\n      <li>Check the latest tracking information</li>\n      <li>Allow a little extra time in case of carrier delays</li>\n    </ul>\n    <p>Contact us if:</p>\n    <ul class=\"plain-list\">\n      <li>Your order has not arrived after the expected delivery date, or</li>\n      <li>There have been repeated unsuccessful delivery attempts</li>\n    </ul>\n    <p>When you contact us, please provide your Order Number and briefly describe the specific issue. We will check the status with the partner carrier and help arrange an update, redelivery, or next steps.</p>\n\n    <h3 class=\"section-title\">Delivered but Not Received</h3>\n    <p>If the tracking shows \"Delivered\" but you have not received your package, please first:</p>\n    <ul class=\"plain-list\">\n      <li>Check with family members, neighbors, or building management/front desk.</li>\n      <li>Look around any common or safe locations (mailroom, parcel locker, reception, garage, porch, etc.).</li>\n    </ul>\n    <p>If you still cannot locate the package, please contact us with:</p>\n    <ul class=\"plain-list\">\n      <li>Your order number</li>\n      <li>Confirmation that you have checked the above locations</li>\n    </ul>\n    <p>We will assist you in investigating the issue with the partner carrier and advise you on the next steps.</p>\n\n    <h3 class=\"section-title\">Incorrect / Damaged / Missing Items</h3>\n    <p>If there is any problem with the items you received, such as:</p>\n    <ul class=\"plain-list\">\n      <li>Wrong item: size, color, or model</li>\n      <li>Items or accessories missing from your order</li>\n      <li>Items or packaging damaged on arrival</li>\n    </ul>\n    <p>Please contact us within 7 days of delivery, provide your Order Number, and briefly describe the specific issue. We may need your assistance in providing some pictures to investigate the status of the package, and then arrange a reshipment, exchange, or refund for you accordingly. For specific steps, please refer to our Return &amp; Refunds policy.</p>\n\n    <h3 class=\"faq-title\">Shipping Q&amp;A</h3>\n    <div class=\"faq-list\">\n      <details class=\"faq-item\">\n        <summary>Where are COLAMY products shipped?</summary>\n        <div class=\"faq-answer\">\n          <p>Free domestic ground shipping for destinations within the contiguous United States 48 states (EXCEPT Hawaii, Alaska, Puerto Rico, and Guam).</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Can I ship to a PO Box address?</summary>\n        <div class=\"faq-answer\">\n          <p>We currently do not support shipping to PO BOX addresses. To ensure you receive your order smoothly, please provide a complete and valid street address when placing your order.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Can I ship to an address outside the US?</summary>\n        <div class=\"faq-answer\">\n          <p>If your shipping address is located in Canada, the UK, or the European Union, please refer to the list of deliverable addresses in the corresponding shipping policy on our respective sites.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Can I cancel my order?</summary>\n        <div class=\"faq-answer\">\n          <p>If your order has not yet been shipped, please contact us in time to change or cancel your order.</p>\n          <p>If the order has already been shipped and you have received a shipping confirmation email, the order cannot be changed or canceled directly and may involve intercepting the package and returning it, etc. Please contact our customer service team for advice on the next steps.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Why did my order arrive in multiple boxes or from multiple carriers?</summary>\n        <div class=\"faq-answer\">\n          <p>We may ship your order to you in multiple boxes or via multiple carriers due to:</p>\n          <ul class=\"plain-list\">\n            <li>The order size — large orders often are split into multiple boxes for more efficient delivery.</li>\n            <li>The product's storage location — some products will come to you from our different warehouses.</li>\n          </ul>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Why is the tracking number not working?</summary>\n        <div class=\"faq-answer\">\n          <p>The courier may not have picked up or scanned the package yet. You might need to wait 1–2 days and then check the tracking number again. If there are still no updates, please contact us at <a href=\"mailto:hello@colamyhome.com\">hello@colamyhome.com</a>, and we'll be happy to assist you.</p>\n        </div>\n      </details>\n    </div>\n\n    <div class=\"doc-image\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0685/2739/1017/files/COLAMY_Warehouse_Description.png?v=1779346470\" alt=\"COLAMY Warehouse Description\" width=\"100%\" height=\"100%\">\n    </div>\n    <div class=\"doc-image\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0685/2739/1017/files/COLAMY_Warehouse.png?v=1779346473\" alt=\"COLAMY Warehouse\" width=\"100%\" height=\"100%\">\n    </div>\n    <p>COLAMY Warehouse in California, Texas &amp; New Jersey</p>\n\n    <div class=\"doc-image\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0685/2739/1017/files/Fast_Front_Door_Delivery_Description.png?v=1779346471\" alt=\"Fast Front Door Delivery Description\" width=\"100%\" height=\"100%\">\n    </div>\n    <div class=\"doc-image\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0685/2739/1017/files/Contactless_Fast_Front_Door_Delivery.png?v=1779346472\" alt=\"Contactless Fast Front Door Delivery\" width=\"100%\" height=\"100%\">\n    </div>\n    <p>4–6 Days Contactless &amp; Fast Front Door Delivery</p>\n\n    <p class=\"last-updated\">Last updated: April 15, 2026</p>\n\n  </div>\n</div>",
