age ul,\n  .colamy-warranty-page ol { margin: 0 0 42px 0; padding-left: 0; list-style: none; }\n  .colamy-warranty-page li {\n    position: relative;\n    margin: 0 0 0px 0;\n    padding-left: 42px;\n    line-height: 1.25;\n  }\n  .colamy-warranty-page ul li::before {\n    content: \"•\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: #111111;\n    font-size: 23px;\n    line-height: 1.25;\n  }\n  .colamy-warranty-page ol { counter-reset: warranty-counter; }\n  .colamy-warranty-page ol > li { counter-increment: warranty-counter; }\n  .colamy-warranty-page ol > li::before {\n    content: counter(warranty-counter) \".\";\n    position: absolute;\n    left: 0;\n    top: 0;\n    color: #111111;\n    font-size: 17px;\n    line-height: 1.25;\n  }\n  .colamy-warranty-page .plain-list { margin-bottom: 30px; }\n  .colamy-warranty-page .plain-list li { padding-left: 26px; margin-bottom: 2px; line-height: 1.25; }\n  .colamy-warranty-page .plain-list li::before { color: #111; font-size: 18px; line-height: 1.25; }\n  .colamy-warranty-page .tight-list li { margin-bottom: 2px; line-height: 1.25; }\n  .colamy-warranty-page .note { margin-top: 14px; }\n  .colamy-warranty-page .faq-title { margin-top: 55px; margin-bottom: 18px; }\n  .colamy-warranty-page .faq-list { border-top: 1px solid var(--cw-border); }\n  .colamy-warranty-page .faq-item {\n    border-bottom: 1px solid var(--cw-border);\n    margin: 0;\n  }\n  .colamy-warranty-page .faq-item summary {\n    list-style: none;\n    cursor: pointer;\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 20px;\n    padding: 18px 0;\n    font-size: 18px;\n    line-height: 1.25;\n    font-weight: 400;\n  }\n  .colamy-warranty-page .faq-item summary::-webkit-details-marker { display: none; }\n  .colamy-warranty-page .faq-item summary::after {\n    content: \"+\";\n    flex: 0 0 auto;\n    font-weight: 400;\n    font-size: 24px;\n    line-height: 1.25;\n    color: #111;\n  }\n  .colamy-warranty-page .faq-item[open] summary::after { content: \"−\"; }\n  .colamy-warranty-page .faq-answer {\n    padding: 0 42px 20px 0;\n    font-size: 18px;\n    line-height: 1.25;\n    color: var(--cw-muted);\n  }\n  .colamy-warranty-page .faq-answer p { margin: 0 0 14px; }\n  .colamy-warranty-page .support-title { margin-top: 42px; margin-bottom: 14px; }\n  .colamy-warranty-page .contact-line { margin: 0 0 2px; line-height: 1.25; }\n  .colamy-warranty-page a {\n    color: var(--cw-blue);\n    text-decoration: none;\n  }\n  .colamy-warranty-page a:hover {\n    text-decoration: underline;\n  }\n  .colamy-warranty-page .last-updated { margin-top: 34px; }\n  .last-updated{\n    font-weight: 700;\n  }\n  .colamy-warranty-page .refund-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin: 30px 0 42px;\n    font-size: 17px;\n    line-height: 1.25;\n  }\n  .colamy-warranty-page .refund-table th,\n  .colamy-warranty-page .refund-table td {\n    border: 1px solid var(--cw-border);\n    padding: 16px 18px;\n    text-align: left;\n    vertical-align: top;\n  }\n  .colamy-warranty-page .refund-table th {\n    background: #f8f8f8;\n    font-weight: 600;\n    color: var(--cw-text);\n  }\n  @media (max-width: 749px) {\n    .colamy-warranty-page { font-size: 16px; line-height: 1.25; }\n    .colamy-warranty-inner { padding: 46px 18px 48px; }\n    .colamy-warranty-page .lead p { font-size: 16px; }\n    .colamy-warranty-page h2 { font-size: 25px; margin: 44px 0 19px; }\n    .colamy-warranty-page h3 { font-size: 23px; margin: 30px 0 10px; }\n    .colamy-warranty-page li { padding-left: 28px; margin-bottom: 9px; }\n    .colamy-warranty-page .image-caption { font-size: 17px; margin-top: 20px; }\n    .colamy-warranty-page .doc-image-placeholder { margin-bottom: 38px; }\n    .colamy-warranty-page .faq-item summary,\n    .colamy-warranty-page .faq-answer { font-size: 16px; }\n  }\n\n  .colamy-warranty-page .doc-image {\n    margin: 2px 0 24px;\n    text-align: left;\n  }\n  .colamy-warranty-page .doc-image img {\n    max-width: 500px;\n    width: auto;\n    height: auto;\n    display: block;\n    margin: 0;\n  }\n\n</style>\n\n<div class=\"colamy-warranty-page\">\n  <div class=\"colamy-warranty-inner\">\n    <h1>Pricing & Payments</h1>\n\n    <h2>Accepted Payment Methods</h2>\n\n    <p>We support the following payment methods:</p>\n\n    <ol>\n      <li>PayPal</li>\n      <li>Credit card</li>\n      <li>Afterpay</li>\n    </ol>\n\n    <div class=\"doc-image\">\n      <img src=\"https://cdn.shopify.com/s/files/1/0685/2739/1017/files/payments.png?v=1779348697\" alt=\"Accepted Payment Methods\" width=\"100%\" height=\"100%\">\n    </div> \n\n    <h3>Coupons &amp; Promotions</h3>\n\n    <p>You can subscribe on our website to get the new subscription coupon, then apply it on the right side of the checkout page in the coupon section. You can only use one discount code per order.</p>\n\n    <p>If the products you have selected are subject to automatic discounts during the promotion period, other discounts cannot be combined. Coupons may not apply to limited-time sales or clearance items.</p>\n\n    <p>If you have any other questions regarding the price and coupon, please contact us at <a href=\"mailto:hello@colamyhome.com\">hello&#64;colamyhome.com</a> for help.</p>\n\n    <h3>Sales Tax/ Duties</h3>\n\n    <p>We collect sales tax in accordance with applicable state laws in the United States; please refer to the tax amount shown on the checkout page for the exact charges.</p>\n\n    <h3>Payment Secure</h3>\n\n    <p>COLAMY employs strict security measures. Your payment details are never shared with third parties.</p>\n\n    <h3>Refund Timeline</h3>\n\n    <p>Once we approve and process your refund, we will complete the issuance within 1-2 business days, and a refund notification email will be sent to you after issuance.</p>\n\n    <p>The final time for the refund to be credited will depend on your payment method and the processing speed of your bank:</p>\n\n    <ul>\n      <li>Credit/debit card: usually 3-5 business days</li>\n      <li>PayPal: immediately</li>\n    </ul>\n\n    <table class=\"refund-table\">\n      <thead>\n        <tr>\n          <th>Payment Method</th>\n          <th>When will I receive my refund?</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td>PayPal</td>\n          <td>For PayPal payments, the refund will typically appear in your PayPal account immediately after it is processed.</td>\n        </tr>\n        <tr>\n          <td>Credit Card (including: Apple Pay, Google Pay, Affirm, etc.)</td>\n          <td>For credit cards or other methods, please note that it may take additional time for your bank or credit card provider to reflect the refund on your statement.</td>\n        </tr>\n      </tbody>\n    </table>\n\n    <p>If you have not received your refund for an extended period, please contact us for further assistance.</p>\n\n    <h3 class=\"faq-title\">Payment Q&amp;A</h3>\n\n    <div class=\"faq-list\">\n      <details class=\"faq-item\">\n        <summary>Why can't I use my coupon?</summary>\n        <div class=\"faq-answer\">\n          <p>If you find that the coupon cannot be used on the checkout page, it may be due to the following reasons:</p>\n          <ul class=\"plain-list\">\n            <li>Expired coupon code</li>\n            <li>Non-stackable discounts</li>\n            <li>Special products not supporting discounts</li>\n            <li>Coupon input error</li>\n          </ul>\n          <p>If you still cannot successfully apply the discount, please contact us and provide a screenshot of the error message.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Why does the price change at checkout?</summary>\n        <div class=\"faq-answer\">\n          <p>After you enter your shipping address at checkout, applicable sales tax will be calculated based on your location.</p>\n          <p>Tax rates vary by region, so the final order amount may differ from the product price shown earlier.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>When will I be charged?</summary>\n        <div class=\"faq-answer\">\n          <p>You are charged when you confirm and complete payment at checkout.</p>\n          <p>Our orders are prepaid. Some payment methods such as Net Term (Pay by invoice) are currently not supported.</p>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>Why did my payment fail?</summary>\n        <div class=\"faq-answer\">\n          <p>Payment failure may happen for the following reasons:</p>\n          <ul class=\"plain-list\">\n            <li>Insufficient funds or credit limit</li>\n            <li>Incorrect card information</li>\n            <li>Bank security restrictions</li>\n            <li>Temporary system issues</li>\n          </ul>\n          <p>Please try:</p>\n          <ul class=\"plain-list\">\n            <li>Checking your card details</li>\n            <li>Using another payment method</li>\n            <li>Contacting your bank</li>\n          </ul>\n        </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>When will I receive my refund?</summary>\n        <div class=\"faq-answer\">\n          <p>Refunds are usually issued within 1-2 business days after approval.</p>\n          <ul class=\"plain-list\">\n            <li>Credit/debit card: 3-5 business days</li>\n            <li>PayPal: immediately</li>\n          </ul>\n\n          <table class=\"refund-table\">\n            <thead>\n              <tr>\n                <th>Payment Method</th>\n                <th>When will I receive my refund?</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <td>PayPal</td>\n                <td>For PayPal payments, the refund will typically appear in your PayPal account immediately after it is processed.</td>\n              </tr>\n              <tr>\n                <td>Credit Card (including: Apple Pay, Google Pay, Affirm, etc.)</td>\n                <td>For credit cards or other methods, please note that it may take additional time for your bank or credit card provider to reflect the refund on your statement.</td>\n              </tr>\n            </tbody>\n          </table>\n\n          </div>\n      </details>\n\n      <details class=\"faq-item\">\n        <summary>What should I do if I still haven't received my refund?</summary>\n        <div class=\"faq-answer\">\n          <p>Please first confirm that your refund has already been processed.</p>\n          <ul class=\"plain-list\">\n            <li>Check your bank/card statement</li>\n            <li>Contact your payment provider</li>\n            <li>Contact us with your order number</li>\n          </ul>\n        </div>\n      </details>\n    </div>\n\n    <p class=\"last-updated\">Last updated: April 15, 2026</p>\n\n  </div>\n</div>",
