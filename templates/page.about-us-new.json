    "multicolumn_aboutus_JhUAjH": {
      "type": "multicolumn-aboutus",
      "blocks": {
        "column_ExRkPh": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/07_ad9dd24f-2c99-4479-b4a4-bc49e0a277ca.jpg",
