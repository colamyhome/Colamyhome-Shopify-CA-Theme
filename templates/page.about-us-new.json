            "highlight_style_color": "",
            "highlight_text_color": "",
            "heading_size": "h4",
            "text": "",
            "text_size": "text-base",
            "overlay_text": "<p>A piece should feel good the day it arrives—and keep feeling solid over time.That’s why we pay attention to the parts you don’t always see: balanced construction, tested performance, and dependable support designed for daily living.</p>",
            "button_label": "",
            "button_link": "",
            "button_style": "btn--underline",
            "button_icon": "none"
          }
        },
        "column_TrXeTF": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/09_25c3dc33-0b7b-4351-8c7e-ecced266bbd0.jpg",
            "title": "<strong>Comfort in Every Layer</strong>",
            "highlight_style": "none",
