      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Coupon label"
    },
    {
      "type": "inline_richtext",
      "id": "coupon_text",
      "label": "Coupon text"
    },
    {
      "type": "color",
      "id": "coupon_bg_color",
