    },
    {
      "type": "header",
      "content": "Sale badge"
    },
    {
      "type": "select",
      "id": "sale_badge_type",
      "label": "Sale badge type",
      "options": [
        {
          "value": "text",
          "label": "Text"
        },
        {
          "value": "percentage",
          "label": "Percentage"
        },
        {
          "value": "amount",
          "label": "Amount"
        }
      ],
      "default": "text"
    },
    {
      "type": "inline_richtext",
      "id": "sale_badge_text",
      "label": "Sale badge text",
      "default": "SALE"
    },
    {
      "type": "color",
      "id": "sale_badge_bg_color",
      "label": "Background",
      "default": "#c4301c"
    },
    {
      "type": "color",
      "id": "sale_badge_text_color",
