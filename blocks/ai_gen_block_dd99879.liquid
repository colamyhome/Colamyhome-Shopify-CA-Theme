{% doc %}
  @prompt
    我想写一个可以调用分类为自己选的 一行放四个，手机端是滑动的 也是放四个, 样式可以帮我改成这样么 放5个
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    display: block;
  }

  .ai-collection-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-collection-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: {{ block.settings.text_color }};
  }

  .ai-collection-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f4f4f4;
  }

  .ai-collection-image-wrapper-{{ ai_gen_id }}::before {
    content: '';
    display: block;
    padding-bottom: 100%;
  }

  .ai-collection-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-collection-item-{{ ai_gen_id }}:hover .ai-collection-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-collection-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-collection-image-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-collection-info-{{ ai_gen_id }} {
    margin-top: {{ block.settings.text_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-collection-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    margin: 0 0 4px 0;
    color: {{ block.settings.text_color }};
  }

  .ai-collection-count-{{ ai_gen_id }} {
    font-size: {{ block.settings.count_size }}px;
    color: {{ block.settings.subtext_color }};
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid-container-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: {{ block.settings.mobile_gap }}px;
      padding-bottom: 10px;
    }

    .ai-collection-item-{{ ai_gen_id }} {
      flex: 0 0 calc(20% - {{ block.settings.mobile_gap | times: 0.8 }}px);
      scroll-snap-align: start;
      min-width: 70px;
    }

    .ai-collection-grid-container-{{ ai_gen_id }}::-webkit-scrollbar {
      height: 4px;
    }

    .ai-collection-grid-container-{{ ai_gen_id }}::-webkit-scrollbar-track {
      background: #f1f1f1;
      border-radius: 2px;
    }

    .ai-collection-grid-container-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
      background: #888;
      border-radius: 2px;
    }

    .ai-collection-grid-container-{{ ai_gen_id }}::-webkit-scrollbar-thumb:hover {
      background: #555;
    }
  }
{% endstyle %}

<collection-grid-{{ ai_gen_id }}
  class="ai-collection-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-grid-container-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign collection = block.settings[collection_key]
      %}

      {% if collection != blank %}
        <a
          href="{{ collection.url }}"
          class="ai-collection-item-{{ ai_gen_id }}"
        >
          <div class="ai-collection-image-wrapper-{{ ai_gen_id }}">
            {% if collection.image %}
              <img
                src="{{ collection.image | image_url: width: 400 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
                width="400"
                height="400"
                class="ai-collection-image-{{ ai_gen_id }}"
              >
            {% elsif collection.products.first and collection.products.first.featured_image %}
              <img
                src="{{ collection.products.first.featured_image | image_url: width: 400 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
                width="400"
                height="400"
                class="ai-collection-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-collection-image-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-collection-info-{{ ai_gen_id }}">
            <h3 class="ai-collection-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
            {% if block.settings.show_product_count %}
              <p class="ai-collection-count-{{ ai_gen_id }}">
                {{ collection.products_count }}
                {% if collection.products_count == 1 %}
                  {{ block.settings.product_text }}
                {% else %}
                  {{ block.settings.products_text }}
                {% endif %}
              </p>
            {% endif %}
          </div>
        </a>
      {% else %}
        <div class="ai-collection-item-{{ ai_gen_id }}">
          <div class="ai-collection-image-wrapper-{{ ai_gen_id }}">
            <div class="ai-collection-image-placeholder-{{ ai_gen_id }}">
              {{ 'collection-1' | placeholder_svg_tag }}
            </div>
          </div>
          <div class="ai-collection-info-{{ ai_gen_id }}">
            <h3 class="ai-collection-title-{{ ai_gen_id }}">Collection {{ i }}</h3>
            {% if block.settings.show_product_count %}
              <p class="ai-collection-count-{{ ai_gen_id }}">0 {{ block.settings.products_text }}</p>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const container = this.querySelector('.ai-collection-grid-container-{{ ai_gen_id }}');
        
        if (window.innerWidth <= 749) {
          let isDown = false;
          let startX;
          let scrollLeft;

          container.addEventListener('mousedown', (e) => {
            isDown = true;
            startX = e.pageX - container.offsetLeft;
            scrollLeft = container.scrollLeft;
          });

          container.addEventListener('mouseleave', () => {
            isDown = false;
          });

          container.addEventListener('mouseup', () => {
            isDown = false;
          });

          container.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - container.offsetLeft;
            const walk = (x - startX) * 2;
            container.scrollLeft = scrollLeft - walk;
          });
        }
      }
    }

    customElements.define('collection-grid-{{ ai_gen_id }}', CollectionGrid{{ ai_gen_id }});
  })();
</script>

