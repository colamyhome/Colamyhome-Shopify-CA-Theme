{% doc %}
  @prompt
    为 Tab product collection 区块的标签导航栏添加横向滑动功能：在移动端，标签不换行排列，用户可以左右滑动浏览所有标签。实现方式：标签容器设置 overflow-x: auto，标签不换行（white-space: nowrap），支持触摸滑动，隐藏滚动条保持美观。
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-tab-collection-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-tab-collection__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-tab-collection__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    margin: 0;
    color: {{ block.settings.heading_color }};
  }

  .ai-tab-collection__tabs-wrapper-{{ ai_gen_id }} {
    position: relative;
    margin-bottom: {{ block.settings.tabs_spacing }}px;
  }

  .ai-tab-collection__tabs-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.tab_gap }}px;
    border-bottom: 1px solid {{ block.settings.tab_border_color }};
    overflow-x: auto;
    overflow-y: hidden;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-tab-collection__tabs-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-tab-collection__tab-{{ ai_gen_id }} {
    flex-shrink: 0;
    padding: {{ block.settings.tab_padding_vertical }}px {{ block.settings.tab_padding_horizontal }}px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    font-size: {{ block.settings.tab_font_size }}px;
    color: {{ block.settings.tab_color }};
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .ai-tab-collection__tab-{{ ai_gen_id }}:hover {
    color: {{ block.settings.tab_hover_color }};
  }

  .ai-tab-collection__tab-{{ ai_gen_id }}.active {
    color: {{ block.settings.tab_active_color }};
    border-bottom-color: {{ block.settings.tab_active_border_color }};
  }

  .ai-tab-collection__content-{{ ai_gen_id }} {
    display: none;
  }

  .ai-tab-collection__content-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-tab-collection__products-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.products_per_row_desktop }}, 1fr);
    gap: {{ block.settings.product_gap }}px;
  }

  .ai-tab-collection__product-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-tab-collection__product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    margin-bottom: 12px;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-tab-collection__product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-tab-collection__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    margin: 0 0 8px;
    color: {{ block.settings.product_title_color }};
  }

  .ai-tab-collection__product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
  }

  .ai-tab-collection__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: {{ block.settings.tab_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-tab-collection__products-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.products_per_row_mobile }}, 1fr);
    }

    .ai-tab-collection__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-tab-collection__tab-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.tab_font_size }}px * 0.9);
    }
  }
{% endstyle %}

<tab-collection-{{ ai_gen_id }}
  class="ai-tab-collection-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <div class="ai-tab-collection__header-{{ ai_gen_id }}">
      <h2 class="ai-tab-collection__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="ai-tab-collection__tabs-wrapper-{{ ai_gen_id }}">
    <div class="ai-tab-collection__tabs-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign tab_label_key = 'tab_label_' | append: i
          assign collection = block.settings[collection_key]
          assign tab_label = block.settings[tab_label_key]
        %}

        {% if collection != blank %}
          <button
            class="ai-tab-collection__tab-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
            data-tab="{{ i }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            {% if tab_label != blank %}
              {{ tab_label }}
            {% else %}
              {{ collection.title }}
            {% endif %}
          </button>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="ai-tab-collection__contents-{{ ai_gen_id }}">
    {% for i in (1..5) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign collection = block.settings[collection_key]
      %}

      {% if collection != blank %}
        <div
          class="ai-tab-collection__content-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          data-content="{{ i }}"
        >
          {% if collection.products.size > 0 %}
            <div class="ai-tab-collection__products-{{ ai_gen_id }}">
              {% for product in collection.products limit: block.settings.products_limit %}
                <div class="ai-tab-collection__product-{{ ai_gen_id }}">
                  <a href="{{ product.url }}">
                    <div class="ai-tab-collection__product-image-wrapper-{{ ai_gen_id }}">
                      {% if product.featured_image %}
                        <img
                          src="{{ product.featured_image | image_url: width: 600 }}"
                          alt="{{ product.featured_image.alt | escape }}"
                          class="ai-tab-collection__product-image-{{ ai_gen_id }}"
                          loading="lazy"
                          width="600"
                          height="600"
                        >
                      {% else %}
                        <div class="ai-tab-collection__product-image-placeholder-{{ ai_gen_id }}">
                          {{ 'product-1' | placeholder_svg_tag }}
                        </div>
                      {% endif %}
                    </div>
                    <h3 class="ai-tab-collection__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                    <div class="ai-tab-collection__product-price-{{ ai_gen_id }}">
                      {{ product.price | money }}
                    </div>
                  </a>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <div class="ai-tab-collection__empty-{{ ai_gen_id }}">
              No products in this collection
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</tab-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class TabCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-tab-collection__tab-{{ ai_gen_id }}');
        this.contents = this.querySelectorAll('.ai-tab-collection__content-{{ ai_gen_id }}');
        this.tabsContainer = this.querySelector('.ai-tab-collection__tabs-{{ ai_gen_id }}');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const tabId = tab.getAttribute('data-tab');
            this.switchTab(tabId);
            this.scrollTabIntoView(tab);
          });
        });
      }

      switchTab(tabId) {
        this.tabs.forEach((tab) => {
          const isActive = tab.getAttribute('data-tab') === tabId;
          tab.classList.toggle('active', isActive);
          tab.setAttribute('aria-selected', isActive);
        });

        this.contents.forEach((content) => {
          const isActive = content.getAttribute('data-content') === tabId;
          content.classList.toggle('active', isActive);
        });
      }

      scrollTabIntoView(tab) {
        const container = this.tabsContainer;
        const tabLeft = tab.offsetLeft;
        const tabWidth = tab.offsetWidth;
        const containerWidth = container.offsetWidth;
        const scrollLeft = container.scrollLeft;

        if (tabLeft < scrollLeft) {
          container.scrollTo({
            left: tabLeft - 20,
            behavior: 'smooth'
          });
        } else if (tabLeft + tabWidth > scrollLeft + containerWidth) {
          container.scrollTo({
            left: tabLeft + tabWidth - containerWidth + 20,
            behavior: 'smooth'
          });
        }
      }
    }

    customElements.define('tab-collection-{{ ai_gen_id }}', TabCollection{{ ai_gen_id }});
  })();
</script>

