    display: block;
    width: 100%;
    padding-bottom: 40px;
  }

  .ai-tab-collection-container-{{ ai_gen_id }} {
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-tab-collection-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 24px;
    padding-top: 20px;
  }

  .ai-tab-collection-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    margin: 0;
    color: {{ block.settings.heading_color }};
  }

  .ai-tab-collection-tabs-wrapper-{{ ai_gen_id }} {
    position: sticky;
    top: {{ block.settings.sticky_top_offset }}px;
    z-index: 100;
    background-color: {{ block.settings.tabs_background_color }};
    padding: 0;
    margin-right: -20px;
    margin-bottom: 32px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-tab-collection-tabs-container-{{ ai_gen_id }} {
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
  }

  .ai-tab-collection-tabs-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    white-space: nowrap;
    justify-content:center;
  }

  .ai-tab-collection-tabs-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-tab-collection-tab-{{ ai_gen_id }} {
    flex-shrink: 0;
    padding: 10px 20px;
    border: 1px solid {{ block.settings.tab_inactive_border_color }};
    background-color: {{ block.settings.tab_inactive_bg_color }};
    color: {{ block.settings.tab_inactive_text_color }};
    border-radius: {{ block.settings.tab_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: {{ block.settings.tab_font_size }}px;
    font-weight: 500;
    white-space: nowrap;
  }

  .ai-tab-collection-tab-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-tab-collection-tab-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.tab_active_bg_color }};
    color: {{ block.settings.tab_active_text_color }};
    border-color: {{ block.settings.tab_active_border_color }};
  }

  .ai-tab-collection-content-{{ ai_gen_id }} {
    display: none;
  }

  .ai-tab-collection-content-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-tab-collection-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.products_per_row_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-tab-collection-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.products_per_row_mobile }}, 1fr);
    }
      .ai-tab-collection-tab-{{ ai_gen_id }} {
    padding: 10px 6px;
    transition: all 0.3s ease;
    font-size: 12px;
  }
  .ai-tab-collection-tabs-{{ ai_gen_id }} {justify-content: : normal;
  }
  }

  .ai-tab-collection-product-card-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .ai-tab-collection-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.product_image_border_radius }}px;
    margin-bottom: 12px;
  }

  .ai-tab-collection-product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-tab-collection-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 8px;
    left: 8px;
    background-color: {{ block.settings.badge_bg_color }};
    color: {{ block.settings.badge_text_color }};
    padding: 4px 10px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 600;
    z-index: 2;
  }

  .ai-tab-collection-product-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-tab-collection-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    margin: 0;
    color: {{ block.settings.product_title_color }};
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.4;
    font-weight:500;
  }

  .ai-tab-collection-product-title-{{ ai_gen_id }} a {
    color: inherit;
    text-decoration: none;
  }

  .ai-tab-collection-product-title-{{ ai_gen_id }} a:hover {
    opacity: 0.7;
  }

  .ai-tab-collection-coupon-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.coupon_bg_color }};
    color: {{ block.settings.coupon_text_color }};
    padding: 4px 12px;
    border-radius: {{ block.settings.coupon_border_radius }}px;
    font-size: {{ block.settings.coupon_font_size }}px;
    font-weight: 600;
    align-self: flex-start;
  }

  .ai-tab-collection-product-price-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: {{ block.settings.price_font_size }}px;
  }

  .ai-tab-collection-sale-price-{{ ai_gen_id }} {
    color: {{ block.settings.sale_price_color }};
    font-weight: 700;
  }

  .ai-tab-collection-original-price-{{ ai_gen_id }} {
    color: {{ block.settings.original_price_color }};
    text-decoration: line-through;
    font-weight: 400;
  }

  .ai-tab-collection-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #999;
    font-size: 14px;
  }
{% endstyle %}

<tab-collection-{{ ai_gen_id }}
  class="ai-tab-collection-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-tab-collection-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-tab-collection-header-{{ ai_gen_id }}">
        <h2 class="ai-tab-collection-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      </div>
    {% endif %}
  </div>

  <div class="ai-tab-collection-tabs-wrapper-{{ ai_gen_id }}">
    <div class="ai-tab-collection-tabs-container-{{ ai_gen_id }}">
      <div class="ai-tab-collection-tabs-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign tab_label_key = 'tab_' | append: i | append: '_label'
            assign tab_collection_key = 'tab_' | append: i | append: '_collection'
            assign tab_label = block.settings[tab_label_key]
            assign tab_collection = block.settings[tab_collection_key]
          %}
          {% if tab_label != blank and tab_collection != blank %}
            <button
              class="ai-tab-collection-tab-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
              data-tab-index="{{ i }}"
              aria-label="{{ tab_label }}"
            >
              {{ tab_label }}
            </button>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="ai-tab-collection-container-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign tab_collection_key = 'tab_' | append: i | append: '_collection'
        assign tab_badge_key = 'tab_' | append: i | append: '_badge'
        assign tab_coupon_key = 'tab_' | append: i | append: '_coupon'
        assign tab_collection = block.settings[tab_collection_key]
        assign tab_badge = block.settings[tab_badge_key]
        assign tab_coupon = block.settings[tab_coupon_key]
      %}
      {% if tab_collection != blank %}
        <div
          class="ai-tab-collection-content-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          data-tab-content="{{ i }}"
        >
          {% if tab_collection.products.size > 0 %}
            <div class="ai-tab-collection-grid-{{ ai_gen_id }}">
              {% for product in tab_collection.products limit: block.settings.products_limit %}
                <div class="ai-tab-collection-product-card-{{ ai_gen_id }}">
                  <div class="ai-tab-collection-product-image-wrapper-{{ ai_gen_id }}">
                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | image_url: width: 600 }}"
                        alt="{{ product.featured_image.alt | escape }}"
                        class="ai-tab-collection-product-image-{{ ai_gen_id }}"
                        loading="lazy"
                        width="600"
                        height="600"
                      >
                    {% else %}
                      <div class="ai-tab-collection-product-image-{{ ai_gen_id }}">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                    {% if tab_badge != blank %}
                      <div class="ai-tab-collection-badge-{{ ai_gen_id }}">{{ tab_badge }}</div>
                    {% endif %}
                  </div>
                  <div class="ai-tab-collection-product-info-{{ ai_gen_id }}">
                    <h3 class="ai-tab-collection-product-title-{{ ai_gen_id }}">
                      <a href="{{ product.url }}">{{ product.title }}</a>
                    </h3>
                    {% if tab_coupon != blank %}
                      <div class="ai-tab-collection-coupon-{{ ai_gen_id }}">{{ tab_coupon }}</div>
                    {% endif %}
                    <div class="ai-tab-collection-product-price-{{ ai_gen_id }}">
                      {% if product.compare_at_price > product.price %}
                        <span class="ai-tab-collection-sale-price-{{ ai_gen_id }}">
                          {{ product.price | money }}
                        </span>
                        <span class="ai-tab-collection-original-price-{{ ai_gen_id }}">
                          {{ product.compare_at_price | money }}
                        </span>
                      {% else %}
                        <span class="ai-tab-collection-sale-price-{{ ai_gen_id }}">
                          {{ product.price | money }}
                        </span>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% else %}
            <div class="ai-tab-collection-empty-{{ ai_gen_id }}">
              No products found in this collection
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</tab-collection-{{ ai_gen_id }}>

<script>
  (function() {
    class TabCollection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-tab-collection-tab-{{ ai_gen_id }}');
        this.contents = this.querySelectorAll('.ai-tab-collection-content-{{ ai_gen_id }}');
        this.tabsWrapper = this.querySelector('.ai-tab-collection-tabs-wrapper-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const tabIndex = tab.getAttribute('data-tab-index');

            this.switchTab(tabIndex);
            this.scrollTabIntoView(tab);

            requestAnimationFrame(() => {
              this.scrollToFirstProduct(tabIndex);
            });
          });
        });
      }

      switchTab(tabIndex) {
        this.tabs.forEach((tab) => {
          if (tab.getAttribute('data-tab-index') === tabIndex) {
            tab.classList.add('active');
          } else {
            tab.classList.remove('active');
          }
        });

        this.contents.forEach((content) => {
          if (content.getAttribute('data-tab-content') === tabIndex) {
            content.classList.add('active');
          } else {
            content.classList.remove('active');
          }
        });
      }

      scrollToFirstProduct(tabIndex) {
        const activeContent = this.querySelector(
          `.ai-tab-collection-content-{{ ai_gen_id }}[data-tab-content="${tabIndex}"]`
        );

        const firstProduct = activeContent?.querySelector(
          '.ai-tab-collection-product-card-{{ ai_gen_id }}'
        );

        if (!firstProduct || !this.tabsWrapper) return;

        const stickyTopOffset = {{ block.settings.sticky_top_offset | default: 0 }};
        const tabsHeight = this.tabsWrapper.offsetHeight;
        const scrollGap = {{ block.settings.switch_scroll_gap | default: 16 }};

        const targetTop =
          firstProduct.getBoundingClientRect().top +
          window.pageYOffset -
          stickyTopOffset -
          tabsHeight -
          scrollGap;

        window.scrollTo({
          top: Math.max(0, targetTop),
          behavior: 'smooth'
        });
      }

      scrollTabIntoView(tab) {
        const tabsContainer = tab.parentElement;
        if (!tabsContainer) return;

        const tabLeft = tab.offsetLeft;
        const tabRight = tabLeft + tab.offsetWidth;
        const visibleLeft = tabsContainer.scrollLeft;
        const visibleRight = visibleLeft + tabsContainer.clientWidth;

        if (tabLeft < visibleLeft || tabRight > visibleRight) {
          tab.scrollIntoView({
            behavior: 'smooth',
            block: 'nearest',
            inline: 'center'
          });
        }
      }
    }

    customElements.define('tab-collection-{{ ai_gen_id }}', TabCollection{{ ai_gen_id }});
  })();
</script>

