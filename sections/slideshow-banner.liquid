{%- liquid
  assign slide_height = section.settings.slide_height
  assign text_alignment_mobile = section.settings.text_alignment_mobile
  assign show_text_below = section.settings.show_text_below

  assign enable_slider = false

  if section.blocks.size > 1
    assign show_controls = section.settings.show_controls
    assign enable_slider = true
  endif

  assign first_block = section.blocks.first
  if first_block.type == 'video'
    assign aspect_ratio = first_block.settings.video.aspect_ratio | default: '16/9'
    assign aspect_ratio_mobile = 0.75
  else
    assign aspect_ratio = first_block.settings.background.aspect_ratio | default: 2.333
    assign aspect_ratio_mobile = 0.75
  endif

  assign autoplay = 0
  if section.settings.autoplay
    assign autoplay = section.settings.autoplay_delay | times: 1000
  endif

  assign blocks_radius = 0

  case settings.blocks_corner_radius
    when 'slightly'
      assign blocks_radius = 10
    when 'round'
      assign blocks_radius = 20
  endcase
-%}
{% style %}

  /* Make the whole banner image clickable whenever a button link is set. */
  #shopify-section-{{ section.id }} .slideshow__item-wrap {
    position: relative;
  }

  #shopify-section-{{ section.id }} .slideshow__image-link {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: block;
    cursor: pointer;
  }

  /* Let clicks pass through the text layer to the image link. */
  #shopify-section-{{ section.id }} .slideshow__content {
    z-index: 6;
    pointer-events: none;
  }

  /* Keep the real CTA button clickable. */
  #shopify-section-{{ section.id }} .slideshow__content a,
  #shopify-section-{{ section.id }} .slideshow__content button {
    pointer-events: auto;
  }
  #shopify-section-{{ section.id }} .page-width--full {
    --page-padding: 0;
  }

  #shopify-section-{{ section.id }} .slideshow-wrapper .slideshow__item-wrap {
    aspect-ratio: {{ section.settings.desktop_media_ratio | default: '21/9' }};
    height: auto;
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .slideshow-wrapper .slideshow__item-wrap {
      aspect-ratio: {{ section.settings.mobile_media_ratio | default: '3/4' }};
    }
  }

