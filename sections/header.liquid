<link
  rel="stylesheet"
  href="{{ 'component-custom-card.css' | asset_url }}"
  media="print"
  fetchpriority="low"
  onload="this.media='all'"
>
<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'recently-viewed-products.js' | asset_url }}" defer="defer"></script>
{%- if request.page_type != 'search' -%}
  <script src="{{ 'search.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- liquid
  assign header_layout = section.settings.header_layout
  assign sticky_header = section.settings.sticky_header
  assign menu = section.settings.menu
  assign menu_mobile = section.settings.menu_mobile
  assign classes = 'header items-center'
  assign classes = classes | append: ' color-' | append: section.settings.color_scheme

  if request.page_type == 'product'
    assign sticky_header = 'none'
  endif

  if section.settings.show_sperator_line
    assign classes = classes | append: ' header--show-sperator-line'
  endif

  if menu_mobile == blank
    assign menu_mobile = menu
  endif

  assign custom_link = section.blocks | where: 'type', 'custom_link' | first
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --logo-width: {{ settings.logo_width }}px;
    --logo-width-mobile: {{ settings.logo_width_mobile }}px;
  }
  #shopify-section-{{ section.id }} .header__bottom {
    --section-padding-top: {{ section.settings.navigation_padding_top }}px;
    --section-padding-bottom: {{ section.settings.navigation_padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .header__top {
    --section-padding-top: {{ section.settings.header_top_padding_top }}px;
    --section-padding-bottom: {{ section.settings.header_top_padding_bottom }}px;
  }
  @media (max-width: 1023px) {
    #shopify-section-{{ section.id }} .header__bottom {
      --section-padding-top: 0;
      --section-padding-bottom: 0;
    }
    #shopify-section-{{ section.id }} .header__top {
      --section-padding-top: 1.6rem;
      --section-padding-bottom: 1.6rem;
    }
  }
  /* Announcement bar separator line */
  #shopify-section-{{ section.id }} .header__announcement--show-separator-line {
    border-top: 1px solid rgba(var(--color-foreground), 0.08);
  }
  /* Announcement bar styles */
  #shopify-section-{{ section.id }} .header__announcement {
    padding-block: 0.6rem;
    --announcement-gap: {{ section.settings.items_padding | default: 12 }}px;
    --announcement-height: {{ section.settings.announcement_height | default: 40 }}px;
    min-height: var(--announcement-height, 0px);
    background: #ffffff;
    color: #1c1c1c;
    z-index: 50;

  }
  #shopify-section-{{ section.id }} .header__announcement .announcement__list,
  #shopify-section-{{ section.id }} .header__announcement .announcement__item,
  #shopify-section-{{ section.id }} .header__announcement .announcement__summary,
  #shopify-section-{{ section.id }} .header__announcement .announcement__link {
    color: #1c1c1c;
    font-size: 14px;
    font-weight: 500;
  }
  #shopify-section-{{ section.id }} .header__announcement .announcement__list {
    display: flex;
    justify-content: var(--announcement-justify, center);
    gap: var(--announcement-gap, 12px);
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .header__announcement .announcement__item {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .header__announcement .announcement__item:not(:last-child)::after {
    content: "";
    display: block;
    width: 1px;
    height: 1.2rem;
    margin-inline-start: var(--announcement-gap, 12px);
    background: currentColor;
    opacity: 0.65;
    flex: 0 0 auto;
  }
  #shopify-section-{{ section.id }} .header__announcement .announcement__item > details {
    position: relative;
  }
  #shopify-section-{{ section.id }} .header__announcement .announcement__item > details > .dropdown {
    inset-block-start: 100%;
    padding-block-start: 0.6rem;
    z-index: 40;
  }
  #shopify-section-{{ section.id }} .header__announcement .announcement__item > details .dropdown__nav a,
  #shopify-section-{{ section.id }} .header__announcement .announcement__item > details .dropdown__nav .link-no-script,
  #shopify-section-{{ section.id }} .header__announcement .announcement__item > details .dropdown__nav .reversed-link__text {
    font-size: 14px;
    font-weight: 400;
    color: #1c1c1c;
  }
  #shopify-section-{{ section.id }} .header__announcement .announcement__summary {
    display: flex;
    align-items: center;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .header__announcement .announcement__item > .announcement__link,
  #shopify-section-{{ section.id }} .header__announcement .announcement__item > details > summary .announcement__link {
    color: inherit;
    text-decoration: none;
    font-weight: 400;
    transition: color 200ms ease;
  }
  #shopify-section-{{ section.id }} .header__announcement .announcement__item:hover > .announcement__link,
  #shopify-section-{{ section.id }} .header__announcement .announcement__item > details > summary:hover .announcement__link,
  #shopify-section-{{ section.id }} .header__announcement .announcement__item > details > summary:focus-visible .announcement__link,
  #shopify-section-{{ section.id }} .header__announcement .announcement__item > details[open] > summary .announcement__link {
    color: #1c1c1c;
    font-weight: 400;
  }
  #shopify-section-{{ section.id }} .header__navigation .header__menu > ul {
    justify-content: center;
    column-gap: 3vw;
  }
  #shopify-section-{{ section.id }} .header__navigation .header__menu > ul > li > a,
  #shopify-section-{{ section.id }} .header__navigation .header__menu > ul > li > a.menu__item,
  #shopify-section-{{ section.id }} .header__navigation .header__menu > ul > li > a.menu__item .reversed-link,
  #shopify-section-{{ section.id }} .header__navigation .header__menu > ul > li > a.menu__item .btn,
  #shopify-section-{{ section.id }} .header__navigation .header__menu > ul > li > a.menu__item .btn__text,
  #shopify-section-{{ section.id }} .header__navigation .header__menu > ul > li > a .menu__item-text,
  #shopify-section-{{ section.id }} .header__navigation .header__menu > ul > li > details > summary .menu__item,
  #shopify-section-{{ section.id }} .header__navigation .header__menu > ul > li > details > summary .font-navigation,
  #shopify-section-{{ section.id }} .header__navigation .header__menu > ul > li > details > summary .menu__item-text {
    color: #1c1c1c;
    font-size: 14px;
    font-weight: 400 !important;
  }
  #shopify-section-{{ section.id }} .header__navigation .header__menu .dropdown__nav a,
  #shopify-section-{{ section.id }} .header__navigation .header__menu .dropdown__nav .reversed-link__text,
  #shopify-section-{{ section.id }} .header__navigation .mega-menu__link--top,
  #shopify-section-{{ section.id }} .header__navigation .mega-menu__item-child a,
  #shopify-section-{{ section.id }} .header__navigation .mega-menu__item-child .reversed-link__text,
  #shopify-section-{{ section.id }} .header__navigation .menu-sidebar__toggle,
  #shopify-section-{{ section.id }} .header__navigation .menu-sidebar__toggle h6,
  #shopify-section-{{ section.id }} .menu-drawer__item-link,
  #shopify-section-{{ section.id }} .menu-drawer__item-link-heading,
  #shopify-section-{{ section.id }} .menu-drawer__item-link-heading .btn__text,
  #shopify-section-{{ section.id }} .menu-drawer__item-link-heading .menu-item-sale__link,
  #shopify-section-{{ section.id }} .menu-drawer__item-back-link {
    color: #1c1c1c;
    font-size: 14px;
    font-weight: 400 !important;
  }
  #shopify-section-{{ section.id }} .header__navigation .mega-menu__link--top,
  #shopify-section-{{ section.id }} .header__navigation .header__menu > ul > li > details[level="top"] > .dropdown > .dropdown__container > .dropdown__nav > li > a,
  #shopify-section-{{ section.id }} .header__navigation .header__menu > ul > li > details[level="top"] > .dropdown > .dropdown__container > .dropdown__nav > li > a .reversed-link__text,
  #shopify-section-{{ section.id }} .header__navigation .header__menu > ul > li > details[level="top"] > .dropdown > .dropdown__container > .dropdown__nav > li > details[level="child"] > summary > a,
  #shopify-section-{{ section.id }} .header__navigation .header__menu > ul > li > details[level="top"] > .dropdown > .dropdown__container > .dropdown__nav > li > details[level="child"] > summary > a .reversed-link__text,
  #shopify-section-{{ section.id }} .header__navigation .header__menu > ul > li > details[level="top"] > .dropdown > .dropdown__container > .dropdown__nav > li > details[level="child"] > summary .link-no-script,
  #shopify-section-{{ section.id }} .header__navigation .header__menu > ul > li > details[level="top"] > .dropdown > .dropdown__container > .dropdown__nav > li > details[level="child"] > summary .link-no-script .reversed-link__text {
    font-size: 16px;
    font-weight: 500 !important;
  }
  #shopify-section-{{ section.id }} .header__top {
    z-index: 70;
  }
  #shopify-section-{{ section.id }} .header__search {
    position: relative;
    z-index: 80;
  }
  #shopify-section-{{ section.id }} .header__search predictive-search.predictive-search-open,
  #shopify-section-{{ section.id }} .header__search .search__content--compact {
    z-index: 90;
  }
  #shopify-section-{{ section.id }} .header__bottom {
    z-index: 20;
  }
  #shopify-section-{{ section.id }} header.search-open .header__announcement,
  #shopify-section-{{ section.id }} header.search-open .header__bottom {
    z-index: 10;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .header__search .search__content--compact {
      position: fixed;
      top: var(--search-dropdown-top, 0px);
      left: var(--search-dropdown-left, 0px);
      width: var(--search-dropdown-width, 100%);
      max-height: min(36rem, calc(100vh - var(--search-dropdown-top, 0px) - 1.6rem));
    }
  }
  #shopify-section-{{ section.id }} {
    --sale-menu-color: #d40000;
  }
  #shopify-section-{{ section.id }} .header__menu > ul > li.menu-item-sale > a,
  #shopify-section-{{ section.id }} .header__menu > ul > li.menu-item-sale > a .menu__item-text,
  #shopify-section-{{ section.id }} .header__menu > ul > li.menu-item-sale > details > summary .menu__item,
  #shopify-section-{{ section.id }} .header__menu > ul > li.menu-item-sale > details > summary .menu__item-text,
  #shopify-section-{{ section.id }} .menu-drawer .menu-item-sale.menu-item-sale__link,
  #shopify-section-{{ section.id }} .menu-drawer .menu-item-sale > .menu-item-sale__link {
    color: var(--sale-menu-color);
  }
  #shopify-section-{{ section.id }} .header__menu > ul > li.menu-item-sale > a:hover,
  #shopify-section-{{ section.id }} .header__menu > ul > li.menu-item-sale > a:focus-visible,
  #shopify-section-{{ section.id }} .header__menu > ul > li.menu-item-sale > details > summary:hover,
  #shopify-section-{{ section.id }} .header__menu > ul > li.menu-item-sale > details > summary:focus-visible,
  #shopify-section-{{ section.id }} .menu-drawer .menu-item-sale.menu-item-sale__link:hover,
  #shopify-section-{{ section.id }} .menu-drawer .menu-item-sale.menu-item-sale__link:focus-visible,
  #shopify-section-{{ section.id }} .menu-drawer .menu-item-sale > .menu-item-sale__link:hover,
  #shopify-section-{{ section.id }} .menu-drawer .menu-item-sale > .menu-item-sale__link:focus-visible {
    color: var(--sale-menu-color);
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .header__announcement { padding-block: 0.4rem; }
    #shopify-section-{{ section.id }} .header__announcement .announcement__list { gap: calc(var(--announcement-gap,12px) * 0.7); }
  }
  @media (max-width: 1023px) {
    #shopify-section-{{ section.id }} .header__top {
      --header-grid-template: "icons-left logo icons" / 1fr auto 1fr;
    }
    /* #shopify-section-{{ section.id }} .header__top {
      background-color: rgba(var(--color-background), 0.6);
    }
    #shopify-section-{{ section.id }} .header__bottom::after {
      background-color: rgba(var(--color-background), 0.6);
    } */
    #shopify-section-{{ section.id }} .header__icons .icon--large {
      --icon-size: 2rem;
    }
    #shopify-section-{{ section.id }} .header__icons .cart-icon {
      --cart-icon-size: 2.1rem;
    }
    #shopify-section-{{ section.id }} .header__icons .menu-drawer-button {
      width: 2.1rem;
      height: 2.1rem;
    }
    #shopify-section-{{ section.id }} .header__logo {
      justify-self: center;
    }
    #shopify-section-{{ section.id }} .header__search {
      grid-area: auto;
      position: fixed;
      top: 0;
      inset-inline: 0;
      height: 10rem;
      padding: 0 1.6rem;
      background-color: rgb(var(--color-background));
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-0.8rem);
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;
      z-index: 80;
      align-items: center;
    }
    #shopify-section-{{ section.id }} .header__search .search__form {
      flex: 1 1 auto;
      min-width: 0;
      width: 100%;
    }
    #shopify-section-{{ section.id }} .header__search .search__input {
      padding-inline-end: 9rem;
    }
    #shopify-section-{{ section.id }} .header__search .search__field-icon {
      inset-inline-end: 5.2rem;
    }
    #shopify-section-{{ section.id }} .header__search .search__content--compact {
      top: calc(100% + 0.8rem);
      max-height: calc(100vh - 10.8rem);
    }
    body.search-open #shopify-section-{{ section.id }} .header__search {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
      transition-delay: 0s;
    }
    body.search-open #shopify-section-{{ section.id }} .header__search-close {
      align-self: center;
      opacity: 1;
      visibility: visible;
      position: absolute;
      inset-inline-end: 2.4rem;
      top: 50%;
      transform: translateY(-50%);
      display: inline-flex;
      width: 3.2rem;
      height: 3.2rem;
      padding: 0;
      color: rgb(var(--color-foreground));
      z-index: 100;
    }
    body.search-open #shopify-section-{{ section.id }} .header__logo,
    body.search-open #shopify-section-{{ section.id }} .header__icons {
      opacity: 0;
      pointer-events: none;
    }
  }
{% endstyle %}

<header
  data-section-id="{{ section.id }}"
  class="{{ classes }}"
  {% if sticky_header != 'none' %}
    is="sticky-header" data-sticky-type="{{ sticky_header }}"
    data-collapse-on-scroll="{{ section.settings.enable_collapse_on_scroll }}"
  {% else %}
    is="basic-header"
  {% endif %}
>
  <div class="header__top header__top--{{ header_layout }} items-center relative section--padding page-width page-width--{{ section.settings.container }}"
    style="padding-inline: 3vw"
  >
    {%- if menu_mobile != blank -%}
      <div class="header__icons header__icons--left lg:justify-start z-1 lg:hidden no-js-hidden">
        <div class="header__buttons flex items-center">
          <button
            class="menu-drawer-button btn btn--inherit flex flex-col items-center justify-center lg:hidden"
            aria-controls="MenuDrawer"
            aria-label="{{ 'accessibility.menu_drawer' | t }}"
          >
            <span class="hamburger-line"></span>
          </button>
          <button
            type="button"
            class="search-drawer-button header__mobile-search-button btn btn--inherit flex items-center justify-center lg:hidden"
            aria-label="{{ 'general.search.search' | t }}"
          >
            {%- render 'icon-search', size: 'large' -%}
          </button>
        </div>
      </div>
    {%- endif -%}

    {%- if request.page_type == 'index' -%}
      <h1 class="header__logo flex justify-center items-center z-1">
    {%- else -%}
      <div class="header__logo flex justify-center items-center z-1">
    {%- endif -%}
    {%- if section.settings.header_layout == 'logo-left' or section.settings.header_layout == 'logo-left-search-center' and section.settings.enable_collapse_on_scroll -%}
      <button
        class="menu-drawer-button toggle-navigation-button btn btn--inherit flex-col items-center justify-center hidden lg:flex shrink-0"
        aria-label="{{ 'accessibility.menu_drawer' | t }}"
      >
        <span class="hamburger-line"></span>
      </button>
    {%- endif -%}
    <a
      href="{{ routes.root_url }}"
      class="h3 relative flex{% unless settings.logo %} header__logo--text{% else %} header__logo--image{% endunless %}"
    >
      {%- if settings.logo != blank -%}
        {%- liquid
          assign logo = settings.logo
          assign logo_width = settings.logo_width
          assign logo_width_2x = settings.logo_width | times: 2

          assign logo_mobile = settings.logo_mobile
          assign logo_width_mobile = settings.logo_width_mobile
          assign logo_width_mobile_2x = settings.logo_width_mobile | times: 2

          if logo_mobile == blank
            assign logo_mobile = logo
          endif
        -%}
        {%- if logo_mobile -%}
          <img
            srcset="{{ logo_mobile | image_url: width: logo_width_mobile }} 1x, {{ logo_mobile | image_url: width: logo_width_mobile_2x }} 2x"
            src="{{ logo_mobile | image_url: width: logo_width_mobile }}"
            loading="eager"
            width="{{ logo_mobile.width }}"
            height="{{ logo_mobile.height }}"
            alt="{{ logo_mobile.alt | default: shop.name | escape }}"
            class="logo header__logo--mobile md:hidden"
          >
        {%- endif -%}
        <img
          srcset="{{ logo | image_url: width: logo_width }} 1x, {{ logo | image_url: width: logo_width_2x }} 2x"
          src="{{ logo | image_url: width: logo_width }}"
          loading="eager"
          width="{{ logo.width }}"
          height="{{ logo.height }}"
          alt="{{ logo.alt | default: shop.name | escape }}"
          class="logo header__logo--desktop md:block hidden"
        >
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>
    {%- if request.page_type == 'index' -%}
      </h1>
    {%- else -%}
      </div>
    {%- endif -%}

    <div class="header__search flex items-center z-2">
      {%- if section.settings.header_layout == 'logo-center' and section.settings.enable_collapse_on_scroll -%}
        <button
          class="menu-drawer-button toggle-navigation-button btn btn--inherit flex-col items-center justify-center hidden lg:flex shrink-0"
          aria-label="{{ 'accessibility.menu_drawer' | t }}"
        >
          <span class="hamburger-line"></span>
        </button>
      {%- endif -%}
      {%- liquid
        assign search_recommendations = ''
        if section.settings.enable_search_recommendations
          assign recs = ''
          for i in (1..7)
            assign rec_key = 'search_recommendation_' | append: i
            assign rec_value = section.settings[rec_key] | strip
            if rec_value != blank
              if recs == ''
                assign recs = rec_value
              else
                assign recs = recs | append: '||' | append: rec_value
              endif
            endif
          endfor

          if recs == blank and settings.most_searched_keyworkds != blank
            assign keywords = settings.most_searched_keyworkds | split: ','
            for keyword in keywords limit: 7
              assign keyword_text = keyword | strip
              if keyword_text != blank
                if recs == ''
                  assign recs = keyword_text
                else
                  assign recs = recs | append: '||' | append: keyword_text
                endif
              endif
            endfor
          endif

          if recs == blank and menu != blank
            for link in menu.links limit: 7
              assign link_title = link.title | strip
              if link_title != blank
                if recs == ''
                  assign recs = link_title
                else
                  assign recs = recs | append: '||' | append: link_title
                endif
              endif
            endfor
          endif

          assign search_recommendations = recs
        endif
      -%}
      {%- render 'predictive-search', search_recommendations: search_recommendations, dropdown_style: 'compact' -%}
      <button
        class="btn btn--inherit header__search-close inline-flex btn-remove"
        aria-label="{{ 'general.search.close_search' | t }}"
      >
        {%- render 'icon-close', class: 'pointer-events-none' -%}
      </button>
    </div>

    {%- capture header_recently_viewed_cards_html -%}
      {%- if search.terms contains 'id:' -%}
        {%- assign parsed_terms = search.terms | split: ' OR ' -%}
        {%- for parsed_term in parsed_terms limit: 4 -%}
          {%- assign parsed_product_id = parsed_term | split: 'id:' | last | times: 1 -%}
          {%- for product in search.results -%}
            {%- if product.id == parsed_product_id -%}
              <a class="header-recently-viewed__card product-card" href="{{ product.url }}">
                <span class="header-recently-viewed__media">
                  {%- if product.featured_image != blank -%}
                    {{
                      product.featured_image
                      | image_url: width: 620
                      | image_tag:
                        loading: 'lazy',
                        sizes: '(min-width: 1024px) 25vw, 50vw',
                        widths: '240, 360, 480, 620',
                        class: 'header-recently-viewed__image'
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg header-recently-viewed__image' }}
                  {%- endif -%}
                </span>
                <span class="header-recently-viewed__product-title">{{ product.title | escape }}</span>
              </a>
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}

    <div class="header__icons header__icons--right flex justify-end z-1">
      <div class="header__buttons flex items-center justify-center">
        {%- if custom_link and custom_link.settings.link != blank or custom_link.settings.label != blank or custom_link.settings.custom_icon != blank or custom_link.settings.icon != 'none' -%}
          <a
            href="{{ custom_link.settings.link | default: "#" }}"
            class="cusstom-button flex items-center justify-center gap-2 reversed-link{% if custom_link.settings.label == blank %} reversed-link--icon-only{% endif %}"
            aria-label="{{ custom_link.settings.label }}"
          >
            {%- if custom_link.settings.custom_icon != blank -%}
              <span class="icon icon--{{ custom_link.settings.icon_size }}">
                {{-
                  custom_link.settings.custom_icon
                  | image_url: width: 30
                  | image_tag: loading: 'lazy', class: 'motion-reduce', is: 'image-lazy'
                -}}
              </span>
            {%- else -%}
              {%- render 'icons', icon: custom_link.settings.icon, size: custom_link.settings.icon_size -%}
            {%- endif -%}
            {% if custom_link.settings.label != blank %}
              <span class="reversed-link__text hidden sm:block lg:hidden xl:block whitespace-nowrap">
                {{ custom_link.settings.label }}
              </span>
            {% endif %}
          </a>
        {%- endif -%}
        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="account-button reversed-link flex items-center justify-center gap-2{% if section.settings.customer_account_style == 'icon-only' %} reversed-link--icon-only{% endif %}"
            aria-label="{{ 'customer.account.title' | t }}"
          >
            {%- render 'icon-account', size: 'large' -%}
            {% if section.settings.customer_account_style == 'icon-with-text' %}
              <span class="reversed-link__text hidden sm:block lg:hidden xl:block whitespace-nowrap">
                {%- liquid
                  if customer
                    echo 'customer.account_fallback' | t
                  else
                    echo 'customer.account_action' | t
                  endif
                -%}
              </span>
            {% endif %}
          </a>
          <header-recently-viewed class="header-recently-viewed">
            <button
              type="button"
              class="clock-button reversed-link flex items-center justify-center reversed-link--icon-only"
              aria-label="recently-viewed"
              aria-expanded="false"
              aria-controls="HeaderRecentlyViewed-{{ section.id }}"
            >
              {%- render 'icon-clock', size: 'large' -%}
            </button>
            <div id="HeaderRecentlyViewed-{{ section.id }}" class="header-recently-viewed__panel" hidden>
              <recently-viewed-products
                data-url="{{ routes.search_url }}?section_id={{ section.id }}&type=product&q="
                data-products-to-show="4"
                data-product-id="{{ product.id | default: 0 }}"
              >
                <div class="section header-recently-viewed__content hidden">
                  <h2 class="header-recently-viewed__title">Recently Viewed</h2>
                  <div class="header-recently-viewed__grid">
                    {{ header_recently_viewed_cards_html }}
                  </div>
                </div>
                <div class="header-recently-viewed__empty hidden">
                  <div class="header-recently-viewed__empty-copy">
                    <h2 class="header-recently-viewed__empty-title">You don't have any recently viewed items. </h2>
                    <p class="header-recently-viewed__empty-subtitle">Here are some of ourbestsellers!</p>
                  </div>
                  {%- assign header_best_seller_collection = collections['best-seller'] -%}
                  <div class="header-recently-viewed__grid header-recently-viewed__empty-grid">
                    {%- for product in header_best_seller_collection.products limit: 4 -%}
                      <a class="header-recently-viewed__card product-card" href="{{ product.url }}">
                        <span class="header-recently-viewed__media">
                          {%- if product.featured_image != blank -%}
                            {{
                              product.featured_image
                              | image_url: width: 620
                              | image_tag:
                                loading: 'lazy',
                                sizes: '(min-width: 1024px) 25vw, 50vw',
                                widths: '240, 360, 480, 620',
                                class: 'header-recently-viewed__image'
                            }}
                          {%- else -%}
                            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg header-recently-viewed__image' }}
                          {%- endif -%}
                        </span>
                        <span class="header-recently-viewed__product-title">{{ product.title | escape }}</span>
                      </a>
                    {%- endfor -%}
                  </div>
                </div>
              </recently-viewed-products>
            </div>
          </header-recently-viewed>
        {%- endif -%}
        {%- liquid
          assign cart_icon_inline_css = ''
          if settings.cart_icon_color != blank and settings.cart_icon_color != 'rgba(0,0,0,0)'
            assign cart_icon_inline_css = cart_icon_inline_css | append: '--cart-icon-color:' | append: settings.cart_icon_color | append: ';'
          endif
          if settings.cart_icon_background != blank and settings.cart_icon_background != 'rgba(0,0,0,0)'
            assign cart_icon_inline_css = cart_icon_inline_css | append: '--cart-icon-background:' | append: settings.cart_icon_background | append: ';'
          endif
        -%}
        <a
          href="{{ routes.cart_url }}"
          class="cart-drawer-button flex items-center justify-center relative cart-icon cart-icon--{{ settings.cart_style }}"
          {% if request.page_type != 'cart' and settings.cart_type == 'drawer' %}
            aria-controls="CartDrawer"
          {% endif %}
          {% if cart_icon_inline_css != blank %}
            style="{{ cart_icon_inline_css }}"
          {% endif %}
          style="background: transparent;"
        >
          {%- render 'icon-cart', size: 'large', name: settings.cart_icon -%}
          <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
          <cart-count
            class="cart-count cart-count--absolute{% if cart.item_count > 99 %} cart-count--small-medium{% endif %}"
            aria-label="{{ 'general.cart.cart_count' | t: count: cart.item_count | escape }}"
            {% if cart == empty %}
              hidden
            {% endif %}
          >
            {%- if cart.item_count < 100 -%}
              {{- cart.item_count -}}
            {%- else -%}
              <span class="text-sm-extra">99+</span>
            {%- endif -%}
          </cart-count>
        </a>
      </div>
    </div>
  </div>
  {%- if section.settings.enable_announcement_bar and section.settings.announcement_menu != blank -%}
    {% assign ann_color = section.settings.announcement_color_scheme %}
    {% if ann_color == blank %}
      {% assign ann_color = section.settings.color_scheme %}
    {% endif %}
    {% assign ann_align = section.settings.announcement_text_alignment | default: 'center' %}
    {% if ann_align == 'left' %}
      {% assign ann_justify = 'flex-start' %}
    {% elsif ann_align == 'right' %}
      {% assign ann_justify = 'flex-end' %}
    {% else %}
      {% assign ann_justify = 'center' %}
    {% endif %}
    <div class="header__announcement{% if section.settings.show_announcement_separator_line %} header__announcement--show-separator-line{% endif %}{% unless section.settings.show_announcement_bar_mobile %} hidden md:block{% endunless %} color-{{ ann_color }} relative page-width page-width--{{ section.settings.container }}" style="--announcement-gap: {{ section.settings.items_padding | default: 12 }}px; --announcement-height: {{ section.settings.announcement_height | default: 40 }}px; --announcement-justify: {{ ann_justify }}; background: #ffffff; color: #1c1c1c;">
      <div class="section--padding">
        <ul class="announcement__list">
          {% for menu_link in linklists[section.settings.announcement_menu].links %}
            <li class="announcement__item">
              {% if menu_link.links != blank %}
                <details is="details-dropdown" level="top" trigger="hover">
                  <summary data-link="{{ menu_link.url }}" class="announcement__summary">
                    <span class="announcement__link">{{ menu_link.title | escape }}</span>
                  </summary>
                  <div class="dropdown">
                    <div class="dropdown__container color-{{ settings.overlay_color_scheme }}">
                      <ul class="dropdown__nav" role="list">
                        {%- for childlink in menu_link.links -%}
                          {%- if childlink.links != blank -%}
                            <li class="relative text-subtext">
                              <details level="child" trigger="hover" is="details-dropdown">
                                <summary>
                                  <a
                                    href="{{ childlink.url }}"
                                    class="reversed-link flex items-center justify-between gap-x-1 no-js-hidden"
                                    tabindex="-1"
                                  >
                                    <span class="reversed-link__text">{{- childlink.title | escape -}}</span>
                                    {%- render 'icon-caret-right', size: '2xs' -%}
                                  </a>
                                  <noscript>
                                    <span
                                      class="link-no-script reversed-link flex items-center justify-between gap-x-1"
                                      tabindex="-1"
                                    >
                                      <span class="reversed-link__text">{{- childlink.title | escape -}}</span>
                                      {%- render 'icon-caret-right', size: '2xs' -%}
                                    </span>
                                  </noscript>
                                </summary>
                                <div class="dropdown">
                                  <div class="dropdown__container">
                                    <ul class="dropdown__nav" role="list">
                                      {%- for grandchildlink in childlink.links -%}
                                        <li class="reversed-link text-subtext">
                                          <a class="block" href="{{ grandchildlink.url }}">
                                            <span class="reversed-link__text">{{- grandchildlink.title | escape -}}</span>
                                          </a>
                                        </li>
                                      {%- endfor -%}
                                    </ul>
                                  </div>
                                </div>
                              </details>
                            </li>
                          {%- else -%}
                            <li class="reversed-link text-subtext">
                              <a href="{{ childlink.url }}" class="block">
                                <span class="reversed-link__text">{{ childlink.title | escape }}</span>
                              </a>
                            </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    </div>
                  </div>
                </details>
              {% else %}
                <a href="{{ menu_link.url }}" class="announcement__link">{{ menu_link.title | escape }}</a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  {%- endif -%}
  {%- if section.settings.menu != blank -%}
    <div class="header__bottom color-{{ section.settings.navigation_color_scheme }} relative page-width page-width--{{ section.settings.container }}">
      <div class="header__navigation section--padding hidden lg:flex w-full justify-{{ section.settings.navigation_content_alignment }}">
        {% render 'desktop-menu', menu: section.settings.menu, blocks: section.blocks %}
      </div>
    </div>
  {%- endif -%}

  {%- render 'menu-drawer', section: section, blocks: section.blocks, custom_link: custom_link -%}
</header>
<div class="fixed-overlay fixed-overlay--header-section z-10"></div>

<script>
  (() => {
    const sectionRoot = document.querySelector('#shopify-section-{{ section.id }}');
    if (!sectionRoot) return;

    const header = sectionRoot.querySelector('header[data-section-id="{{ section.id }}"]');
    const trigger = sectionRoot.querySelector('.header__mobile-search-button');
    const predictiveSearch = header?.querySelector('predictive-search');
    const searchInput = predictiveSearch?.querySelector('input[type="search"]');

    if (!trigger || !predictiveSearch || !searchInput) return;

    trigger.addEventListener('click', () => {
      if (typeof predictiveSearch.openSearch === 'function') {
        predictiveSearch.openSearch();
      } else {
        document.body.classList.add('search-open');
        predictiveSearch.classList.add('predictive-search-open');
      }
      requestAnimationFrame(() => searchInput.focus());
    });
  })();
</script>

{% comment %} <style>
  /* High-specificity, late-loaded override to ensure announcement hover works in runtime */
  #shopify-section-{{ section.id }} .header__announcement .announcement__item a:hover,
  #shopify-section-{{ section.id }} .header__announcement .announcement__item a:focus,
  #shopify-section-{{ section.id }} .header__announcement .announcement__item span:hover {
    color: #ffffff !important;
    cursor: pointer !important;
    pointer-events: auto !important;
  }
</style> {% endcomment %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}
