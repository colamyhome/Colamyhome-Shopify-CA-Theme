{%- liquid
  assign nav_button_class = 'tabs-horizontal__tab-item focus-inset'
  assign nav_button_text_class = 'tabs-horizontal__tab-name'

  assign image_with_text_blocks = section.blocks | where: 'type', 'image_with_text'
  assign quiet_luxury_card_blocks = section.blocks | where: 'type', 'quiet_luxury_card'
  assign dimension_blocks = section.blocks | where: 'type', 'dimension'
  assign sidebar = section.blocks | where: 'type', 'sidebar' | first
  assign assembly_care_blocks = section.blocks | where: 'type', 'assembly_care'
  assign questions_answers_blocks = section.blocks | where: 'type', 'questions_answers'
-%}
{{ 'component-tabs-horizontal.css' | asset_url | stylesheet_tag }}
{%- if sidebar -%}
  {{ 'component-help-sidebar.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if image_with_text_blocks != blank -%}
  {{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if quiet_luxury_card_blocks != blank -%}
  {{ 'component-quiet-luxury-card.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if dimension_blocks != blank -%}
  {{ 'component-dimension.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if assembly_care_blocks != blank -%}
  {{ 'component-assembly-care.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if questions_answers_blocks != blank -%}
  {{ 'component-questions-answers.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}

<div
  class="section section-tabs-content-horizontal tabs-content-horizontal section-{{ section.id }} section--padding page-width page-width--{{ section.settings.container }} color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-id="{{ section.id }}"
>
  {%- if section.blocks.size > 0 -%}
    <div class="flex flex-col md:flex-row{% if sidebar != blank %} help-sidebar__wrapper help-sidebar--{{ sidebar.settings.position }}{% endif %}">
      <tabs-content-horizontal class="flex-1 tabs-horizontal">
        <div
          class="tabs-horizontal__header flex justify-{{ section.settings.navigation_alignment }}"
          role="tablist"
        >
          <div class="tabs-horizontal__nav-wrap">
            <div class="tabs-horizontal__nav tabs-horizontal__nav-js">
              {%- liquid
                assign tab_number = 1
              -%}
              {%- for block in section.blocks -%}
                {%- liquid
                  if block.type == 'sidebar'
                    continue
                  endif
                  if block.settings.navigation_title != blank
                    assign tab_name = block.settings.navigation_title
                  else
                    assign tab_name = 'Tab ' | append: tab_number
                  endif

                  assign tab_number = tab_number | plus: 1
                -%}
                <button class="{{ nav_button_class }}" role="tab" id="{{- block.id -}}" {{ block.shopify_attributes }}>
                  <span class="tabs-horizontal__tab-icon" aria-hidden="true">
                    {%- if block.settings.navigation_icon != blank -%}
                      {{
                        block.settings.navigation_icon
                        | image_url: width: 96
                        | image_tag:
                          loading: 'lazy',
                          widths: '32, 48, 64, 96',
                          class: 'tabs-horizontal__tab-icon-image'
                      }}
                    {%- endif -%}
                  </span>
                  <span class="{{ nav_button_text_class }}">{{- tab_name -}}</span>
                  <span class="tabs-horizontal__tab-arrow" aria-hidden="true">&#x2795;</span>
                </button>
              {%- endfor -%}
            </div>
          </div>
        </div>
        <div class="tabs-horizontal__panel" style="padding-inline:0rem;">
          {%- liquid
            assign tab_index = 0
          -%}
          {%- for block in section.blocks -%}
            {%- liquid
              if block.type == 'sidebar'
                continue
              endif
            -%}
            <div
              class="tabs-horizontal__content{% if block.type == 'image_with_text' %} tabs-horizontal__content--image-with-text{% endif %}"
              id="tab-{{ block.id }}"
              data-index="{{ tab_index }}"
              role="tabpanel"
              {% unless tab_index == 0 %}
                hidden
              {% endunless %}
            >
              {%- case block.type -%}
                {%- when 'image_with_text' -%}
                  {%- liquid
                    assign image_position = 'left'
                    assign aspect_ratio = 1.7777777778

                    assign loading = 'eager'
                    assign fetchpriority = 'low'
                    if section.index < 2 and tab_index == 0
                      assign loading = 'eager'
                      assign fetchpriority = 'high'
                    endif
                    assign motion_delay = 50
                  -%}
                  {% capture sizes %}
                  (min-width: 768px) calc(min({{ settings.page_width }}px, 100vw) / 2), calc(100vw - 3rem)
                  {% endcapture %}
                  <div
                    class="image-with-text__wrapper image-with-text--image-{{ image_position }} flex flex-col md:flex-row gap-y-6"
                    style="--image-width: 75%;"
                  >
                    <div
                      class="image-with-text__media self-center{% if image_position == 'right' %} md:order-last{% endif %}"
                    >
                      <div class="block overlow-hidden blocks-radius">
                        <motion-element
                          data-motion="zoom-out"
                          data-motion-delay="{{ motion_delay }}"
                          class="block media-wrapper hover-wrapper blocks-radius{% if block.settings.image == blank %} bg-none{% endif %}"
                          style="--aspect-ratio: {{ aspect_ratio }};"
                        >
                          {%- if block.settings.image != blank -%}
                            {{
                              block.settings.image
                              | image_url: width: block.settings.image.width
                              | image_tag:
                                loading: loading,
                                fetchpriority: fetchpriority,
                                class: 'motion-reduce hover-scale-up',
                                widths: '375, 550, 670, 750, 1100, 1340, 1500, 1780, 2000, 3000, 3840',
                                sizes: sizes,
                                is: 'image-lazy'
                            }}
                          {%- else -%}
                            {{ 'image' | placeholder_svg_tag: 'placeholder-svg w-full h-full hover-scale-up' }}
                          {%- endif -%}
                        </motion-element>
                        {%- assign motion_delay = motion_delay | plus: 50 -%}
                      </div>
                    </div>
                    <div class="image-with-text__inner flex-1 md:flex items-center">
                      <div class="image-with-text__content w-full rich-text md:text-left text-left">
                        {%- if block.settings.subheading != blank -%}
                          <motion-element
                            data-motion="fade-up"
                            data-motion-delay="{{ motion_delay }}"
                            class="block rich-text__subheading text-subheading"
                          >
                            {{ block.settings.subheading }}
                          </motion-element>
                          {%- assign motion_delay = motion_delay | plus: 50 -%}
                        {%- endif -%}
                        {%- if block.settings.heading != blank -%}
                          <h2 class="rich-text__heading inline-richtext {{ block.settings.heading_size }}">
                            <motion-element class="block" data-motion="fade-up" data-motion-delay="{{ motion_delay }}">
                              {% render 'highlight-text',
                                hl_text: block.settings.heading,
                                hl_style: block.settings.highlight_style,
                                hl_font_style: block.settings.highlight_font_style,
                                hl_style_color: block.settings.highlight_style_color,
                                hl_text_color: block.settings.highlight_text_color
                              %}
                            </motion-element>
                          </h2>
                          {%- assign motion_delay = motion_delay | plus: 50 -%}
                        {%- endif -%}
                        {%- if block.settings.description != blank -%}
                          <motion-element
                            data-motion="fade-up"
                            data-motion-delay="{{ motion_delay }}"
                            class="block rich-text__text text-subtext rte {{ block.settings.description_size }}"
                          >
                            {{ block.settings.description }}
                          </motion-element>
                          {%- assign motion_delay = motion_delay | plus: 50 -%}
                        {%- endif -%}
                        {% if block.settings.heading_1 != blank or block.settings.heading_2 != blank or block.settings.heading_3 != blank   %}
                          <motion-element
                            class="block"
                            data-motion="fade-up"
                            data-motion-delay="{{ motion_delay }}"
                          >
                            {% render 'icon-with-text',
                              layout: 'vertical',
                              heading_1: block.settings.heading_1,
                              tooltip_1: block.settings.tooltip_text_1,
                              image_1: block.settings.image_1,
                              icon_1: block.settings.icon_1,
                              heading_2: block.settings.heading_2,
                              tooltip_2: block.settings.tooltip_text_2,
                              image_2: block.settings.image_2,
                              icon_2: block.settings.icon_2,
                              heading_3: block.settings.heading_3,
                              tooltip_3: block.settings.tooltip_text_3,
                              image_3: block.settings.image_3,
                              icon_3: block.settings.icon_3
                            %}
                          </motion-element>
                          {%- assign motion_delay = motion_delay | plus: 50 -%}
                        {% endif %}
                        {%- assign selected_product = block.settings.product -%}
                        {% if selected_product != blank or block.settings.product_text_1 != blank or block.settings.product_text_2 != blank %}
                          {%- assign product_image = block.settings.product_image -%}
                          {%- if product_image == blank and selected_product != blank -%}
                            {%- assign product_image = selected_product.featured_image -%}
                          {%- endif -%}
                          <motion-element
                            data-motion="fade-up"
                            data-motion-delay="{{ motion_delay }}"
                            class="block tabs-horizontal__product"
                          >
                            <div class="tabs-horizontal__product-card">
                              <div class="tabs-horizontal__product-image">
                                {%- if product_image != blank -%}
                                  {{
                                    product_image
                                    | image_url: width: 240
                                    | image_tag:
                                      loading: 'lazy',
                                      widths: '80, 120, 160, 240',
                                      class: 'tabs-horizontal__product-image-element'
                                  }}
                                {%- endif -%}
                              </div>
                              <div class="tabs-horizontal__product-details">
                                {%- if block.settings.product_text_1 != blank -%}
                                  <div class="tabs-horizontal__product-text tabs-horizontal__product-text--eyebrow">{{ block.settings.product_text_1 }}</div>
                                {%- endif -%}
                                {%- if block.settings.product_text_2 != blank -%}
                                  <div class="tabs-horizontal__product-text tabs-horizontal__product-text--title">{{ block.settings.product_text_2 }}</div>
                                {%- endif -%}
                                {%- if selected_product != blank -%}
                                  {%- assign product_variant = selected_product.selected_or_first_available_variant -%}
                                  {%- if product_variant != blank -%}
                                    <div class="tabs-horizontal__product-price">
                                      <span class="tabs-horizontal__product-price-current">{{ product_variant.price | money }}</span>
                                      {%- if product_variant.compare_at_price > product_variant.price -%}
                                        <s class="tabs-horizontal__product-price-compare">{{ product_variant.compare_at_price | money }}</s>
                                      {%- endif -%}
                                    </div>
                                  {%- endif -%}
                                {%- endif -%}
                              </div>
                            </div>
                          </motion-element>
                          {%- assign motion_delay = motion_delay | plus: 50 -%}
                        {% endif %}
                        {%- if block.settings.button_label != blank -%}
                          {%- assign product_button_link = block.settings.button_link -%}
                          {%- if product_button_link == blank and selected_product != blank -%}
                            {%- assign product_button_link = selected_product.url -%}
                          {%- endif -%}
                          <motion-element
                            data-motion="fade-up"
                            data-motion-delay="{{ motion_delay }}"
                            class="block rich-text__button"
                          >
                            {% render 'button',
                              button_style: block.settings.button_style,
                              button_link: product_button_link,
                              button_label: block.settings.button_label,
                              button_icon: block.settings.button_icon
                            %}
                          </motion-element>
                          {%- assign motion_delay = motion_delay | plus: 50 -%}
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {%- when 'tab' -%}
                  <div class="page__content rte text-subtext">
                    {{ block.settings.content }}
                    {{ block.settings.custom_liquid }}
                    {{ block.settings.page.content }}
                  </div>
                {%- when 'quiet_luxury_card' -%}
                  {% render 'quiet-luxury-card', block: block %}
                {%- when 'dimension' -%}
                  {% render 'dimension', block: block %}
                {%- when 'assembly_care' -%}
                  {% render 'assembly-care', block: block %}
                {%- when 'questions_answers' -%}
                  {% render 'questions-answers', block: block %}
              {%- endcase -%}
            </div>
            {%- assign tab_index = tab_index | plus: 1 -%}
          {%- endfor -%}
        </div>
      </tabs-content-horizontal>
      {%- if sidebar != blank -%}
        {% render 'help-sidebar', sidebar: sidebar %}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
<script src="{{ 'tabs-content-horizontal.js' | asset_url }}" defer="defer"></script>
{% schema %}
{
  "name": "Tabs content Horizontal",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.general.name"
    },
    {
      "type": "select",
      "id": "container",
      "options": [
        {
          "value": "full",
          "label": "t:general.container.options__full.label"
        },
        {
          "value": "fixed",
          "label": "t:general.container.options__fixed.label"
        }
      ],
      "default": "fixed",
      "label": "t:general.container.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.tabs-content.settings.tab_settings.content"
    },
    {
      "type": "select",
      "id": "navigation_alignment",
      "label": "t:general.text_alignment.label",
      "default": "center",
      "options": [
        {
          "value": "start",
          "label": "t:general.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:general.text_alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:general.text_alignment.options__3.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:general.padding.section_heading.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:general.padding.top.label",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:general.padding.bottom.label",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:general.divider.section_heading.content"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": false,
      "label": "t:general.divider.show_divider.label"
    },
    {
      "type": "select",
      "id": "divider_width",
      "options": [
        {
          "value": "fixed",
          "label": "t:general.container.options__fixed.label"
        },
        {
          "value": "full",
          "label": "t:general.container.options__full.label"
        }
      ],
      "default": "fixed",
      "label": "t:general.divider.width.label"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "t:sections.tabs-content.blocks.tab.name",
      "settings": [
        {
          "type": "text",
          "label": "t:sections.tabs-content.blocks.tab.settings.navigation_title.label",
          "id": "navigation_title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:general.tab_content.label",
          "default": "<p>Fill in the text content of the collapsible item here. You can provide details and explanation for the question here.</p>"
        },
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:general.custom_liquid.label"
        },
        {
          "id": "page",
          "type": "page",
          "label": "t:general.page.content.label"
        }
      ]
    },
    {
      "type": "image_with_text",
      "name": "t:sections.tabs-content.blocks.image_with_text.name",
      "settings": [
        {
          "type": "text",
          "label": "t:sections.tabs-content.blocks.tab.settings.navigation_title.label",
          "id": "navigation_title"
        },
        {
          "type": "image_picker",
          "id": "navigation_icon",
          "label": "Navigation icon"
        },
        {
          "type": "image_picker",
          "label": "t:general.image.label",
          "id": "image"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:general.heading.label",
          "default": "Talk about your brand",
          "info": "t:general.heading.info"
        },
        {
          "type": "select",
          "id": "highlight_style",
          "label": "t:general.highlight_text.highlight_style.label",
          "options": [
            {
              "value": "none",
              "label": "t:general.highlight_text.highlight_style.options.option__1.label"
            },
            {
              "value": "hand_drawn_circle",
              "label": "t:general.highlight_text.highlight_style.options.option__2.label"
            },
            {
              "value": "thick_underline",
              "label": "t:general.highlight_text.highlight_style.options.option__3.label"
            },
            {
              "value": "wave_underline",
              "label": "t:general.highlight_text.highlight_style.options.option__4.label"
            }
          ]
        },
        {
          "type": "select",
          "id": "highlight_font_style",
          "label": "t:general.highlight_text.highlight_font_style.label",
          "options": [
            {
              "value": "italic",
              "label": "t:general.highlight_text.highlight_font_style.options.option__1.label"
            },
            {
              "value": "normal",
              "label": "t:general.highlight_text.highlight_font_style.options.option__2.label"
            }
          ]
        },
        {
          "type": "color",
          "id": "highlight_style_color",
          "label": "t:general.highlight_text.highlight_style_color.label"
        },
        {
          "type": "color",
          "id": "highlight_text_color",
          "label": "t:general.highlight_text.highlight_text_color.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "t:general.text_size.heading.label",
          "default": "hd2",
          "options": [
            {
              "value": "h5",
              "label": "t:general.text_size.options__h5.label"
            },
            {
              "value": "h4",
              "label": "t:general.text_size.options__h4.label"
            },
            {
              "value": "h3",
              "label": "t:general.text_size.options__h3.label"
            },
            {
              "value": "h2",
              "label": "t:general.text_size.options__h2.label"
            },
            {
              "value": "h1",
              "label": "t:general.text_size.options__h1.label"
            },
            {
              "value": "hd2",
              "label": "t:general.text_size.options__hd2.label"
            },
            {
              "value": "hd1",
              "label": "t:general.text_size.options__hd1.label"
            }
          ]
        },
        {
          "type": "inline_richtext",
          "id": "subheading",
          "label": "t:general.subheading.label"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:general.text.label",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
        },
        {
          "type": "select",
          "id": "description_size",
          "label": "t:general.text_size.text.label",
          "default": "text-base",
          "options": [
            {
              "value": "text-sm",
              "label": "t:general.text_size.options__small.label"
            },
            {
              "value": "text-base",
              "label": "t:general.text_size.options__base.label"
            },
            {
              "value": "text-lg",
              "label": "t:general.text_size.options__large.label"
            },
            {
              "value": "text-inherit",
              "label": "t:general.text_size.options__inherit.label"
            }
          ]
        },
        {
          "type": "header",
          "content": "Product"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "White-background product image",
          "info": "Leave empty to use the selected product's featured image."
        },
        {
          "type": "inline_richtext",
          "id": "product_text_1",
          "label": "Custom text 1"
        },
        {
          "type": "inline_richtext",
          "id": "product_text_2",
          "label": "Custom text 2"
        },
        {
          "type": "header",
          "content": "t:general.button.header.content"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:general.button.button_label.label",
          "default": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:general.button.button_link.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "t:general.button.button_style.label",
          "options": [
            {
              "value": "btn--primary",
              "label": "t:general.button.button_style.options__1.label"
            },
            {
              "value": "btn--secondary",
              "label": "t:general.button.button_style.options__2.label"
            },
            {
              "value": "btn--underline",
              "label": "t:general.button.button_style.options__4.label"
            },
            {
              "value": "btn--plain",
              "label": "t:general.button.button_style.options__7.label"
            }
          ],
          "default": "btn--primary"
        },
        {
          "type": "select",
          "id": "button_icon",
          "label": "t:general.button.button_icon.label",
          "options": [
            {
              "value": "none",
              "label": "t:general.button.button_icon.options__1.label"
            },
            {
              "value": "caret-right",
              "label": "t:general.button.button_icon.options__2.label"
            },
            {
              "value": "caret-left",
              "label": "t:general.button.button_icon.options__22.label"
            },
            {
              "value": "arrow-right",
              "label": "t:general.button.button_icon.options__3.label"
            },
            {
              "value": "arrow-left",
              "label": "t:general.button.button_icon.options__23.label"
            },
            {
              "value": "close",
              "label": "t:general.button.button_icon.options__4.label"
            },
            {
              "value": "home",
              "label": "t:general.button.button_icon.options__5.label"
            },
            {
              "value": "search",
              "label": "t:general.button.button_icon.options__6.label"
            },
            {
              "value": "hamburger",
              "label": "t:general.button.button_icon.options__7.label"
            },
            {
              "value": "pencil",
              "label": "t:general.button.button_icon.options__8.label"
            },
            {
              "value": "plus",
              "label": "t:general.button.button_icon.options__9.label"
            },
            {
              "value": "cart",
              "label": "t:general.button.button_icon.options__10.label"
            },
            {
              "value": "account",
              "label": "t:general.button.button_icon.options__11.label"
            },
            {
              "value": "sign-in",
              "label": "t:general.button.button_icon.options__12.label"
            },
