{% liquid
  assign position = 'left,center,right' | split: ','
  assign enable_sticky_on_current_page = section.settings.enable_sticky
  assign topbar_sticky_offset = section.settings.topbar_height | plus: section.settings.padding_top | plus: section.settings.padding_bottom
  assign topbar_sticky_offset_mobile = section.settings.topbar_height_mobile | plus: section.settings.padding_top | plus: section.settings.padding_bottom

  if request.page_type == 'product'
    assign enable_sticky_on_current_page = false
  endif
%}
{% style %}
  #shopify-section-{{ section.id }}.topbar-section--sticky {
    position: sticky;
    top: 0;
    z-index: 31;
  }

  body.topbar-sticky-{{ section.id }} .header-sticky {
    top: {{ topbar_sticky_offset }}px;
  }

  #shopify-section-{{ section.id }} .topbar__inner {
    min-height: var(--topbar-height);
    align-items: center;
  }

  #shopify-section-{{ section.id }} .topbar__column--text-rotating .topbar__text-slide {
    display: none;
  }

  #shopify-section-{{ section.id }} .topbar__column--text-rotating .topbar__text-slide.is-active {
    display: block;
  }

  #shopify-section-{{ section.id }} .topbar__column--text-rotating {
    position: relative;
  }

  #shopify-section-{{ section.id }} .topbar__column--text-rotating.is-ready .topbar__text-slide {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    will-change: opacity;
  }

  #shopify-section-{{ section.id }} .topbar__column--text-rotating.is-ready .topbar__text-slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  @media (max-width: 767px) {
    body.topbar-sticky-{{ section.id }} .header-sticky {
      top: {{ topbar_sticky_offset_mobile }}px;
    }

    /* #shopify-section-{{ section.id }} .topbar {
      background-color: rgba(var(--color-background), 0.6);
    } */

    #shopify-section-{{ section.id }} .topbar__inner {
      min-height: var(--topbar-height-mobile, var(--topbar-height));
    }
  }
{% endstyle %}
<div
  class="topbar section--padding color-{{ section.settings.color_scheme }} page-width page-width--{{ section.settings.container }}{% if section.settings.show_separator_line %} topbar--show-separator-line{% endif %}{% if enable_sticky_on_current_page %} topbar--sticky{% endif %}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="topbar__inner grid items-center">
    {% for pos in position %}
      {% liquid
        assign text_block_count = 0
        assign non_text_block_count = 0
        for block in section.blocks
          if block.settings.position == pos
            if block.type == 'text'
              assign text_block_count = text_block_count | plus: 1
            else
              assign non_text_block_count = non_text_block_count | plus: 1
            endif
          endif
        endfor
      %}
      <div
        class="topbar__column topbar__{{ pos }}{% unless pos == 'center' %} hidden{% else %} flex{% endunless %} lg:flex flex-wrap flex-col lg:flex-row items-center lg:justify-{{ pos | replace: 'left','start' | replace: 'right','end' }} text-center lg:text-{{ pos }}{% if text_block_count > 1 and non_text_block_count == 0 %} topbar__column--text-rotating{% endif %}"
        {% if text_block_count > 1 and non_text_block_count == 0 %}
          data-text-rotate-interval="{{ section.settings.text_rotate_interval | times: 1000 }}"
        {% endif %}
      >
        {% assign text_block_index = 0 %}
        {% for block in section.blocks %}
          {% unless block.settings.position == pos %}
            {% continue %}
          {% endunless %}
          {%- case block.type -%}
            {% when 'link_list' %}
              <ul class="topbar__menu flex flex-wrap items-center justify-center lg:justify-{{ pos | replace: 'left','start' | replace: 'right','end' }}">
                {% for link in linklists[block.settings.menu].links %}
                  <li class="topbar__menu-item">
                    <a href="{{ link.url }}" class="block reversed-link">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            {% when 'text' %}
              <div class="topbar__text topbar__text-slide rte{% if text_block_count < 2 or text_block_index == 0 %} is-active{% endif %}" style="--highlight-text-color: {{ block.settings.highlight_text_color }}; --highlight-text-background-color: {{ block.settings.highlight_text_background_color }};">
                {% if block.settings.highlight_text != blank %}
                  <p class="highlight-text highlight-text--{{ block.settings.highlight_text_style }}">
                    {{- block.settings.highlight_text -}}
                  </p>
                {% endif %}
                <p>{{- block.settings.text -}}</p>
              </div>
              {% assign text_block_index = text_block_index | plus: 1 %}
            {% when 'language_country' %}
              <div class="topbar__country flex items-center gap-4">
                {% liquid
                  if block.settings.show_language_selector
                    render 'language-selector', plain: true, class: 'flex', form_id: block.id
                  endif
                  if block.settings.show_country_selector
                    render 'country-selector', plain: true, class: 'flex', form_id: block.id
                  endif
                %}
              </div>
            {% when 'social_links' %}
              {% liquid
                assign socials = 'facebook,instagram,youtube,tiktok,twitter,pinterest,snapchat,tumblr,vimeo' | split: ','
                assign show_social = false
                for social in socials
                  assign social_setting = 'show_' | append: social
                  assign social_link = 'social_' | append: social | append: '_link'
                  if block.settings[social_setting] and settings[social_link] != blank
                    assign show_social = true
                    break
                  endif
                endfor
              %}
              {% if show_social %}
                {% render 'social-icons',
                  class: 'topbar__social',
                  size: 'medium',
                  show_facebook: block.settings.show_facebook,
                  show_instagram: block.settings.show_instagram,
                  show_tiktok: block.settings.show_tiktok,
                  show_twitter: block.settings.show_twitter,
                  show_pinterest: block.settings.show_pinterest,
                  show_snapchat: block.settings.show_snapchat,
                  show_tumblr: block.settings.show_tumblr,
                  show_youtube: block.settings.show_youtube,
                  show_vimeo: block.settings.show_vimeo
                %}
              {% endif %}
          {%- endcase -%}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</div>

<script>
  (() => {
    const section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    if (section.querySelector('.topbar--sticky')) {
      section.classList.add('topbar-section--sticky');
      document.body.classList.add('topbar-sticky-{{ section.id }}');
    }

    section.querySelectorAll('.topbar__column--text-rotating').forEach((column) => {
      if (column.dataset.textRotatorInitialized === 'true') return;

      const slides = Array.from(column.querySelectorAll('.topbar__text-slide'));
      if (slides.length < 2) return;

      const interval = Number(column.dataset.textRotateInterval || 5000);
      let currentIndex = slides.findIndex((slide) => slide.classList.contains('is-active'));

      if (currentIndex < 0) {
        currentIndex = 0;
        slides[currentIndex].classList.add('is-active');
      }

      let maxHeight = 0;
      slides.forEach((slide) => {
        const originalDisplay = slide.style.display;
        const originalVisibility = slide.style.visibility;
        const originalPosition = slide.style.position;

        slide.style.display = 'block';
        slide.style.visibility = 'hidden';
        slide.style.position = 'static';

        maxHeight = Math.max(maxHeight, slide.offsetHeight);

        slide.style.display = originalDisplay;
        slide.style.visibility = originalVisibility;
        slide.style.position = originalPosition;
      });

      if (maxHeight > 0) {
        column.style.minHeight = `${maxHeight}px`;
      }

      column.classList.add('is-ready');

      window.setInterval(() => {
        slides[currentIndex].classList.remove('is-active');
        currentIndex = (currentIndex + 1) % slides.length;
        slides[currentIndex].classList.add('is-active');
      }, interval);

      column.dataset.textRotatorInitialized = 'true';
    });
  })();
</script>

