{%- liquid
  assign image_with_text_blocks = section.blocks | where: 'type', 'image_with_text'
  assign quiet_luxury_card_blocks = section.blocks | where: 'type', 'quiet_luxury_card'
  assign dimension_blocks = section.blocks | where: 'type', 'dimension'
  assign sidebar = section.blocks | where: 'type', 'sidebar' | first
  assign assembly_care_blocks = section.blocks | where: 'type', 'assembly_care'
  assign questions_answers_blocks = section.blocks | where: 'type', 'questions_answers'
  assign scrolling_gallery_image_blocks = section.blocks | where: 'type', 'scrolling_gallery_image'
  assign nav_title_alignment = section.settings.nav_title_alignment | default: 'left'
  assign nav_title_font_size = section.settings.nav_title_font_size | default: 14
  assign nav_title_font_size_mobile = section.settings.nav_title_font_size_mobile | default: 14
  assign nav_title_justify = nav_title_alignment | replace: 'left', 'flex-start' | replace: 'right', 'flex-end'
-%}
{{ 'section-scrollspy-nav-test-new-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-scrollspy-nav-test-new-product.js' | asset_url }}" defer="defer"></script>
{%- if sidebar -%}
  {{ 'component-help-sidebar.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if image_with_text_blocks != blank -%}
  {{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if quiet_luxury_card_blocks != blank -%}
  {{ 'component-quiet-luxury-card-test-new-product.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if dimension_blocks != blank -%}
  {{ 'component-dimension.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if assembly_care_blocks != blank -%}
  {{ 'component-assembly-care.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if questions_answers_blocks != blank -%}
  {{ 'component-questions-answers.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if scrolling_gallery_image_blocks != blank -%}
  {{ 'section-scrolling-gallery-image.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}

<div
  class="section section-scrollspy-nav section-{{ section.id }} section--padding page-width page-width--{{ section.settings.container }} color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;--scrollspy-nav-title-align: {{ nav_title_alignment }};--scrollspy-nav-title-justify: {{ nav_title_justify }};--scrollspy-nav-title-font-size: {{ nav_title_font_size }}px;--scrollspy-nav-title-font-size-mobile: {{ nav_title_font_size_mobile }}px;margin-top: {{ section.settings.margin_top }}px;margin-bottom: {{ section.settings.margin_bottom }}px;"
  data-id="{{ section.id }}"
>
  {%- if section.blocks.size > 0 -%}
    {%- unless request.page_type == 'product' -%}
      <div class="scrollspy-nav__nav">
        <div id="scrollspy-nav-scroll-{{ section.id }}" class="scrollspy-nav__nav-scroll">
          <div class="scrollspy-nav__nav-list" role="list">
            {%- liquid
              assign block_number = 1
            -%}
            {%- for block in section.blocks -%}
              {%- liquid
                if block.type == 'sidebar'
                  continue
                endif
                if block.type == '@app'
                  assign block_name = 'customer r'
                elsif block.settings.navigation_title != blank
                  assign block_name = block.settings.navigation_title
                else
                  assign block_name = 'sections.scrollspy-nav.navigation.block_fallback_prefix' | t | append: block_number
                endif

                assign block_number = block_number | plus: 1
              -%}
              <span
                class="btn btn--icon scrollspy-nav__nav-link"
                role="listitem"
              >
                <span class="btn__text subheading-font">{{- block_name -}}</span>
              </span>
            {%- endfor -%}
          </div>
        </div>
        <scroll-progress-bar class="scrollspy-nav__progress md:hidden" target="scrollspy-nav-scroll-{{ section.id }}">
          <div class="progress-container">
            <div class="progress-bar no-empty"></div>
          </div>
        </scroll-progress-bar>
      </div>
    {%- endunless -%}

    <div class="scrollspy-nav__layout flex flex-col md:flex-row{% if sidebar != blank %} help-sidebar__wrapper help-sidebar--{{ sidebar.settings.position }}{% endif %}">
      <div class="scrollspy-nav__blocks flex-1">
        {%- liquid
          assign block_index = 0
        -%}
        {%- for block in section.blocks -%}
          {%- liquid
            if block.type == 'sidebar'
              continue
            endif
            assign block_number = block_index | plus: 1
            if block.type == '@app'
              assign block_title = 'Loved by Thousands of Homeowners'
            elsif block.settings.navigation_title != blank
              assign block_title = block.settings.navigation_title
            else
              assign block_title = 'sections.scrollspy-nav.navigation.block_fallback_prefix' | t | append: block_number
            endif
          -%}
          <div
            class="scrollspy-nav__block scrollspy-nav__block--{{ block.type }}"
            id="scrollspy-nav-block-{{ block.id }}"
            data-index="{{ block_index }}"
            {{ block.shopify_attributes }}
          >
            <h2 class="scrollspy-nav__block-title rich-text__heading h3">
              {{- block_title -}}
            </h2>
            {%- case block.type -%}
              {%- when 'image_with_text' -%}
                {%- liquid
                  assign image_position = block.settings.desktop_image_position

                  assign aspect_ratio = block.settings.image_aspect_ratio | default: '1/1'
                  if aspect_ratio == 'adapt'
                    if block.settings.image != blank
                      assign aspect_ratio = block.settings.image.aspect_ratio
                    else
                      assign aspect_ratio = '1/1'
                    endif
                  endif

                  assign loading = 'lazy'
                  assign fetchpriority = 'low'
                  if section.index < 2 and block_index == 0
                    assign loading = 'eager'
                    assign fetchpriority = 'high'
                  endif
                  assign motion_delay = 50
                -%}
                  {% capture sizes %}
                  (min-width: 768px) calc(min({{ settings.page_width }}px, 100vw) / 2), calc(100vw - 3rem)
                  {% endcapture %}
                  <div
                    class="image-with-text__wrapper image-with-text--image-{{ image_position }} flex flex-col md:flex-row gap-y-6"
                    style="--image-width: 50%;"
                  >
                    <div
                      class="image-with-text__media self-center{% if image_position == 'right' %} md:order-last{% endif %}"
                    >
                      <div class="block overlow-hidden blocks-radius">
                        <motion-element
                          data-motion="zoom-out"
                          data-motion-delay="{{ motion_delay }}"
                          class="block media-wrapper hover-wrapper blocks-radius{% if block.settings.image == blank %} bg-none{% endif %}"
                          style="--aspect-ratio: {{ aspect_ratio }};"
                        >
                          {%- if block.settings.image != blank -%}
                            {{
                              block.settings.image
                              | image_url: width: block.settings.image.width
                              | image_tag:
                                loading: loading,
                                fetchpriority: fetchpriority,
                                class: 'motion-reduce hover-scale-up',
                                widths: '375, 550, 670, 750, 1100, 1340, 1500, 1780, 2000, 3000, 3840',
                                sizes: sizes,
                                is: 'image-lazy'
                            }}
                          {%- else -%}
                            {{ 'image' | placeholder_svg_tag: 'placeholder-svg w-full h-full hover-scale-up' }}
                          {%- endif -%}
                        </motion-element>
                        {%- assign motion_delay = motion_delay | plus: 50 -%}
                      </div>
                    </div>
                    <div class="image-with-text__inner flex-1 md:flex items-center">
                      <div class="image-with-text__content w-full rich-text md:text-left text-left">
                        {%- if block.settings.subheading != blank -%}
                          <motion-element
                            data-motion="fade-up"
                            data-motion-delay="{{ motion_delay }}"
                            class="block rich-text__subheading text-subheading"
                          >
                            {{ block.settings.subheading }}
                          </motion-element>
                          {%- assign motion_delay = motion_delay | plus: 50 -%}
                        {%- endif -%}
                        {%- if block.settings.heading != blank -%}
                          <h2 class="rich-text__heading inline-richtext {{ block.settings.heading_size }}">
                            <motion-element class="block" data-motion="fade-up" data-motion-delay="{{ motion_delay }}">
                              {% render 'highlight-text',
                                hl_text: block.settings.heading,
                                hl_style: block.settings.highlight_style,
                                hl_font_style: block.settings.highlight_font_style,
                                hl_style_color: block.settings.highlight_style_color,
                                hl_text_color: block.settings.highlight_text_color
                              %}
                            </motion-element>
                          </h2>
                          {%- assign motion_delay = motion_delay | plus: 50 -%}
                        {%- endif -%}
                        {%- if block.settings.description != blank -%}
                          <motion-element
                            data-motion="fade-up"
                            data-motion-delay="{{ motion_delay }}"
                            class="block rich-text__text text-subtext rte {{ block.settings.description_size }}"
                          >
                            {{ block.settings.description }}
                          </motion-element>
                          {%- assign motion_delay = motion_delay | plus: 50 -%}
                        {%- endif -%}
                        {%- if block.settings.button_label != blank -%}
                          <motion-element
                            data-motion="fade-up"
                            data-motion-delay="{{ motion_delay }}"
                            class="block rich-text__button"
                          >
                            {% render 'button',
                              button_style: block.settings.button_style,
                              button_link: block.settings.button_link,
                              button_label: block.settings.button_label,
                              button_icon: block.settings.button_icon
                            %}
                          </motion-element>
                          {%- assign motion_delay = motion_delay | plus: 50 -%}
                        {% endif %}
                        {% if block.settings.heading_1 != blank or block.settings.heading_2 != blank or block.settings.heading_3 != blank   %}
                          <motion-element
                            class="block"
                            data-motion="fade-up"
                            data-motion-delay="{{ motion_delay }}"
                          >
                            {% render 'icon-with-text',
                              layout: 'vertical',
                              heading_1: block.settings.heading_1,
                              tooltip_1: block.settings.tooltip_text_1,
                              image_1: block.settings.image_1,
                              icon_1: block.settings.icon_1,
                              heading_2: block.settings.heading_2,
                              tooltip_2: block.settings.tooltip_text_2,
                              image_2: block.settings.image_2,
                              icon_2: block.settings.icon_2,
                              heading_3: block.settings.heading_3,
                              tooltip_3: block.settings.tooltip_text_3,
                              image_3: block.settings.image_3,
                              icon_3: block.settings.icon_3
                            %}
                          </motion-element>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {%- when 'tab' -%}
                  {%- liquid
                    assign details_source_product = block.settings.source_product
                    assign details_source_product_handle = blank
                    assign details_description = blank

                    if details_source_product == blank and product != blank
                      assign details_source_product = product
                    endif

                    if details_source_product != blank and details_source_product.metafields == blank
                      assign details_source_product_handle = details_source_product.handle | default: details_source_product
                      if details_source_product_handle != blank and all_products[details_source_product_handle] != blank
                        assign details_source_product = all_products[details_source_product_handle]
                      endif
                    endif

                    if details_source_product != blank
                      assign details_description = details_source_product.description
                    endif
                  -%}
                  <div class="page__content rte text-subtext">
                    {%- if details_description != blank -%}
                      {{ details_description }}
                    {%- else -%}
                      {{ block.settings.content }}
                      {{ block.settings.custom_liquid }}
                      {{ block.settings.page.content }}
                    {%- endif -%}
                  </div>
                {%- when 'quiet_luxury_card' -%}
                  {% render 'quiet-luxury-card-test-new-product', block: block %}
                {%- when 'dimension' -%}
                  {% render 'dimension', block: block %}
                {%- when 'assembly_care' -%}
                  {% render 'assembly-care', block: block, translation_namespace: 'scrollspy-nav' %}
                {%- when 'questions_answers' -%}
                  {% render 'questions-answers', block: block %}
                {%- when 'scrolling_gallery_image' -%}
                  {% render 'scrollspy-scrolling-gallery-image', block: block, section: section %}
                {%- when '@app' -%}
                  {% render block %}
              {%- endcase -%}
            </div>
            {%- assign block_index = block_index | plus: 1 -%}
          {%- endfor -%}
        </div>
      {%- if sidebar != blank -%}
        {% render 'help-sidebar', sidebar: sidebar %}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "t:sections.scrollspy-nav.name",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.overlay"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:general.general.name"
    },
    {
      "type": "select",
      "id": "container",
      "options": [
        {
          "value": "full",
          "label": "t:general.container.options__full.label"
        },
        {
          "value": "fixed",
          "label": "t:general.container.options__fixed.label"
        }
      ],
      "default": "fixed",
      "label": "t:general.container.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:general.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.scrollspy-nav.settings.nav_settings.content"
    },
    {
      "type": "select",
      "id": "nav_title_alignment",
      "label": "Navigation title alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "range",
      "id": "nav_title_font_size",
      "label": "Desktop navigation title font size",
      "default": 14,
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "nav_title_font_size_mobile",
      "label": "Mobile navigation title font size",
      "default": 14,
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "t:sections.scrollspy-nav.settings.margin_top.label",
      "default": 0,
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "t:sections.scrollspy-nav.settings.margin_bottom.label",
      "default": 0,
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:general.padding.section_heading.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:general.padding.top.label",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:general.padding.bottom.label",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:general.divider.section_heading.content"
    },
    {
      "type": "checkbox",
      "id": "show_section_divider",
      "default": false,
      "label": "t:general.divider.show_divider.label"
    },
    {
      "type": "select",
      "id": "divider_width",
      "options": [
        {
          "value": "fixed",
          "label": "t:general.container.options__fixed.label"
        },
        {
          "value": "full",
          "label": "t:general.container.options__full.label"
        }
      ],
      "default": "fixed",
      "label": "t:general.divider.width.label"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "tab",
      "name": "t:sections.scrollspy-nav.blocks.tab.name",
      "settings": [
        {
          "type": "text",
          "label": "t:sections.scrollspy-nav.blocks.tab.settings.navigation_title.label",
          "id": "navigation_title"
        },
        {
          "type": "product",
          "id": "source_product",
          "label": "t:sections.scrollspy-nav.blocks.tab.settings.source_product.label"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:general.tab_content.label",
          "default": "<p>Fill in the text content of the collapsible item here. You can provide details and explanation for the question here.</p>"
        },
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:general.custom_liquid.label"
        },
        {
          "id": "page",
          "type": "page",
          "label": "t:general.page.content.label"
        }
      ]
    },
    {
      "type": "image_with_text",
      "name": "t:sections.scrollspy-nav.blocks.image_with_text.name",
      "settings": [
        {
          "type": "text",
          "label": "t:sections.scrollspy-nav.blocks.tab.settings.navigation_title.label",
          "id": "navigation_title"
        },
        {
          "type": "image_picker",
          "label": "t:general.image.label",
          "id": "image"
        },
        {
          "type": "select",
          "id": "desktop_image_position",
          "label": "t:general.image_position.desktop.label",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "t:general.image_position.options__left.label"
            },
            {
              "value": "right",
              "label": "t:general.image_position.options__right.label"
            }
          ]
        },
        {
          "type": "select",
          "id": "image_aspect_ratio",
          "label": "t:general.image_ratio.label",
          "default": "adapt",
          "options": [
            {
              "value": "adapt",
              "label": "t:general.image_ratio.options__1.label"
            },
            {
              "value": "1/1",
              "label": "t:general.image_ratio.options__2.label"
            },
            {
              "value": "3/4",
              "label": "t:general.image_ratio.options__3.label"
            },
            {
              "value": "4/3",
              "label": "t:general.image_ratio.options__4.label"
            }
          ]
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:general.heading.label",
          "default": "Talk about your brand",
          "info": "t:general.heading.info"
        },
        {
          "type": "select",
          "id": "highlight_style",
          "label": "t:general.highlight_text.highlight_style.label",
          "options": [
            {
              "value": "none",
              "label": "t:general.highlight_text.highlight_style.options.option__1.label"
            },
            {
              "value": "hand_drawn_circle",
              "label": "t:general.highlight_text.highlight_style.options.option__2.label"
            },
            {
              "value": "thick_underline",
              "label": "t:general.highlight_text.highlight_style.options.option__3.label"
            },
            {
              "value": "wave_underline",
              "label": "t:general.highlight_text.highlight_style.options.option__4.label"
            }
          ]
        },
        {
          "type": "select",
          "id": "highlight_font_style",
          "label": "t:general.highlight_text.highlight_font_style.label",
          "options": [
            {
              "value": "italic",
              "label": "t:general.highlight_text.highlight_font_style.options.option__1.label"
            },
            {
              "value": "normal",
              "label": "t:general.highlight_text.highlight_font_style.options.option__2.label"
            }
          ]
        },
        {
          "type": "color",
          "id": "highlight_style_color",
          "label": "t:general.highlight_text.highlight_style_color.label"
        },
        {
          "type": "color",
          "id": "highlight_text_color",
          "label": "t:general.highlight_text.highlight_text_color.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "t:general.text_size.heading.label",
          "default": "hd2",
          "options": [
            {
              "value": "h5",
              "label": "t:general.text_size.options__h5.label"
            },
            {
              "value": "h4",
              "label": "t:general.text_size.options__h4.label"
            },
            {
              "value": "h3",
              "label": "t:general.text_size.options__h3.label"
            },
            {
              "value": "h2",
              "label": "t:general.text_size.options__h2.label"
            },
            {
              "value": "h1",
              "label": "t:general.text_size.options__h1.label"
            },
            {
              "value": "hd2",
              "label": "t:general.text_size.options__hd2.label"
            },
            {
              "value": "hd1",
              "label": "t:general.text_size.options__hd1.label"
            }
          ]
        },
        {
          "type": "inline_richtext",
          "id": "subheading",
          "label": "t:general.subheading.label"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:general.text.label",
          "default": "<p>Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.</p>"
        },
        {
          "type": "select",
          "id": "description_size",
          "label": "t:general.text_size.text.label",
          "default": "text-base",
          "options": [
            {
              "value": "text-sm",
              "label": "t:general.text_size.options__small.label"
            },
            {
              "value": "text-base",
              "label": "t:general.text_size.options__base.label"
            },
            {
              "value": "text-lg",
              "label": "t:general.text_size.options__large.label"
            },
            {
              "value": "text-inherit",
              "label": "t:general.text_size.options__inherit.label"
            }
          ]
        },
        {
          "type": "header",
          "content": "t:general.button.header.content"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:general.button.button_label.label",
          "default": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:general.button.button_link.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "t:general.button.button_style.label",
          "options": [
            {
              "value": "btn--primary",
              "label": "t:general.button.button_style.options__1.label"
            },
            {
              "value": "btn--secondary",
              "label": "t:general.button.button_style.options__2.label"
            },
            {
              "value": "btn--underline",
              "label": "t:general.button.button_style.options__4.label"
            },
            {
              "value": "btn--plain",
              "label": "t:general.button.button_style.options__7.label"
            }
          ],
          "default": "btn--primary"
        },
        {
          "type": "select",
          "id": "button_icon",
          "label": "t:general.button.button_icon.label",
          "options": [
            {
              "value": "none",
              "label": "t:general.button.button_icon.options__1.label"
            },
            {
