{% comment %}
  Renders an image card for a selected collection.

  Usage:
  {{ 'component-card-img-with-product.css' | asset_url | stylesheet_tag }}

  {% render 'card-image-with-collection',
    collection: collection,
    image: image,
    image_ratio: image_ratio,
    subheading: subheading,
    heading: heading,
    heading_size: heading_size,
    description: description,
    image_bottom_text: image_bottom_text,
    image_bottom_text_size: image_bottom_text_size,
    image_bottom_text_weight: image_bottom_text_weight,
    image_bottom_text_color: image_bottom_text_color,
    image_bottom_text_alignment: image_bottom_text_alignment,
    image_bottom_text_padding_top: image_bottom_text_padding_top,
    color_scheme: color_scheme
  %}
{% endcomment %}

{%- liquid
  assign image_ratio = image_ratio
  if image_ratio == 'adapt'
    if image != blank
      assign image_ratio = image.aspect_ratio
    else
      assign image_ratio = '3/4'
    endif
  endif

  assign alt = image.alt | default: shop.name | escape

  assign collection_title = collection.title
  assign default_label = 'onboarding.collection_title' | t
  assign collection_title_default = collection_title | default: default_label

  assign featured_image = collection.image
  if featured_image == blank
    assign featured_image = collection.products.first.featured_media.preview_image
  endif

  assign motion_delay = 50
  assign image_bottom_text_size = image_bottom_text_size | default: 14
  assign image_bottom_text_weight = image_bottom_text_weight | default: 400
  assign image_bottom_text_color = image_bottom_text_color | default: '#0e0e0e'
  assign image_bottom_text_alignment = image_bottom_text_alignment | default: 'center'
  assign image_bottom_text_padding_top = image_bottom_text_padding_top | default: 16

  assign collection_thumbnail_ratio = settings.pcard_image_ratio
  if collection_thumbnail_ratio == 'adapt'
    if featured_image != blank
      assign collection_thumbnail_ratio = featured_image.aspect_ratio
    else
      assign collection_thumbnail_ratio = '1'
    endif
  endif
-%}
{%- if collection != blank -%}
  <a
    href="{{ collection.url }}"
    class="card-media--link focus-inset"
    aria-label="{{ collection_title_default | escape }}"
  >
{%- endif -%}
<div class="pr-img-card btn-hover-wrapper">
  <div class="relative z-0 blocks-radius color-{{ color_scheme }}">
    <motion-element class="block h-full" data-motion="zoom-out-sm">
      <picture
        class="card-media__media media-wrapper{% if image == blank %} bg-none{% endif %}"
        style="--aspect-ratio: {{ image_ratio }};"
      >
        {%- if image != blank -%}
          {{
            image
            | image_url: width: 1100
            | image_tag:
              loading: 'lazy',
              class: 'motion-reduce absolute inset-0 w-full h-full',
              widths: '165, 360, 535, 750, 940, 1100',
              is: 'image-lazy',
              alt: alt
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg w-full h-full' }}
        {%- endif -%}
        <div class="bg-overlay"></div>
      </picture>
    </motion-element>

    <div class="pr-img-card__contents z-1 flex flex-col">
      <div class="pr-img-card__contents-header rich-text shrink-0 rich-text--tight block">
        {% if subheading != blank %}
          <motion-element
            class="rich-text__subheading text-subheading block"
            data-motion="fade-up"
            data-motion-delay="{{ motion_delay }}"
          >
            {{- subheading -}}
          </motion-element>
          {% assign motion_delay = motion_delay | plus: 50 %}
        {% endif %}
        {% if heading != blank %}
          <h3 class="pr-img-card__contents-heading rich-text__heading inline-richtext {{ heading_size }}">
            <motion-element
              class="block"
              data-motion="fade-up"
              data-motion-delay="{{ motion_delay }}"
            >
              {% render 'highlight-text',
                hl_text: heading,
                hl_style: highlight_style,
                hl_font_style: highlight_font_style,
                hl_style_color: highlight_style_color,
                hl_text_color: highlight_text_color
              %}
            </motion-element>
          </h3>
          {% assign motion_delay = motion_delay | plus: 50 %}
        {% endif %}
        {%- if description != blank -%}
          <motion-element
            class="pr-img-card__description rich-text__text rte {{ description_size }} block"
            data-motion="fade-up"
            data-motion-delay="{{ motion_delay }}"
          >
            {{- description -}}
          </motion-element>
          {% assign motion_delay = motion_delay | plus: 50 %}
        {% endif %}
      </div>
      {%- if collection != blank -%}
        <div class="pr-img-card__product product-card product-card--list flex items-center gap-3">
          <div
            class="product-card__image blocks-radius-md shrink-0"
            aria-label="{{ collection_title_default | escape }}"
            tabindex="-1"
          >
            <div
              class="media-wrapper{% if featured_image == blank %} bg-none{% endif %}"
              style="--aspect-ratio: {{ collection_thumbnail_ratio }};"
            >
              {%- if featured_image != blank -%}
                {% assign alt = featured_image.alt | default: collection_title_default | escape %}
                {{
                  featured_image
                  | image_url: width: 355
                  | image_tag:
                    loading: 'lazy',
                    class: 'motion-reduce',
                    width: 70,
                    height: 70,
                    widths: '50, 70, 100, 140',
                    sizes: '(max-width:767px) 50px, 70px',
                    is: 'image-lazy',
                    alt: alt
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          </div>
          <div class="product-card__info flex-1">
            <p class="product-card__title text-pcard-title text-limit-1-line m-0">
              {{- collection_title_default -}}
            </p>
          </div>
          {% if button_label != blank %}
            {% render 'button',
              button_style: button_style,
              button_tag: 'button',
              button_label: button_label,
              button_size: 'btn--small',
              button_icon: button_icon,
              button_icon_size: 'extra-small',
              additional_classes: 'product-card__btn'
            %}
          {% endif %}
        </div>
      {%- else -%}
        <div class="pr-img-card__product product-card product-card--list flex items-center gap-3">
          <div class="product-card__image blocks-radius-md shrink-0">
            <div class="media-wrapper bg-none" style="--aspect-ratio: {{ collection_thumbnail_ratio }};">
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          </div>
          <div class="product-card__info flex-1">
            <p class="product-card__title text-pcard-title text-limit-1-line m-0">
              {{- default_label -}}
            </p>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{%- if collection != blank -%}
  </a>
{%- endif -%}
{%- if image_bottom_text != blank -%}
  <motion-element
    class="pr-img-card__bottom-text rte"
    data-motion="fade-up"
    data-motion-delay="{{ motion_delay }}"
    style="--image-bottom-text-size: {{ image_bottom_text_size }}px; --image-bottom-text-weight: {{ image_bottom_text_weight }}; --image-bottom-text-color: {{ image_bottom_text_color }}; --image-bottom-text-align: {{ image_bottom_text_alignment }}; --image-bottom-text-padding-top: {{ image_bottom_text_padding_top }}px;"
  >
    {{- image_bottom_text -}}
  </motion-element>
{%- endif -%}
