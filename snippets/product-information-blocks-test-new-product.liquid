                {%- if block.settings.text != blank -%}
                  <span class="product__delivery-time-label">{{ block.settings.text | escape }}</span>
                {%- endif -%}
                <span class="product__delivery-time-date" data-delivery-time-range></span>
              </span>
            </div>
            <script>
              (() => {
                const getOrdinalSuffix = (day) => {
                  if (day > 3 && day < 21) return 'th';
                  switch (day % 10) {
                    case 1:
                      return 'st';
                    case 2:
                      return 'nd';
                    case 3:
                      return 'rd';
                    default:
                      return 'th';
                  }
                };

                const formatDeliveryDate = (date, includeMonth = true) => {
                  const month = date.toLocaleString('en-US', { month: 'short' });
                  const day = date.getDate();
                  return `${includeMonth ? `${month} ` : ''}${day}${getOrdinalSuffix(day)}`;
                };

                const updateDeliveryTimes = () => {
                  const today = new Date();
                  const startDate = new Date(today);
                  const endDate = new Date(today);
                  startDate.setDate(today.getDate() + 2);
                  endDate.setDate(today.getDate() + 8);

                  const sameMonth = startDate.getMonth() === endDate.getMonth() && startDate.getFullYear() === endDate.getFullYear();
                  const dateRange = `${formatDeliveryDate(startDate)} - ${formatDeliveryDate(endDate, !sameMonth)}`;

                  document.querySelectorAll('[data-delivery-time-range]').forEach((element) => {
                    element.textContent = dateRange;
                  });
                };

                updateDeliveryTimes();
              })();
            </script>
          </div>
        {%- when 'delivery_time_by_bulky' -%}
