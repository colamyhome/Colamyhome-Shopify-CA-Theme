                </div>
              {%- endif -%}
            </div>
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
  {%- if context == 'quick-view' or context == 'featured-product' -%}
    <div class="product__view-details text-left z-1">
      <a
        {% if product == blank %}
          role="link" aria-disabled="true" disabled
        {% else %}
          href="{{ product.url }}"
        {% endif %}
        class="btn btn--plain btn--with-icon"
      >
        <span class="btn__text">{{- 'products.product.view_full_details' | t -}}</span>
        <span class="btn__icon inline-flex">
          {%- render 'icon-caret-right', size: '2xs' -%}
        </span>
      </a>
    </div>
  {%- endif -%}
</div>
<script>
  if (!window.colamyDiscountCodeInitialized) {
    window.colamyDiscountCodeInitialized = true;

    (function () {
      var LEGACY_STORAGE_KEY = 'colamy_selected_discount';
      var CHECKOUT_STORAGE_PREFIX = 'colamy_apply_coupon_checkout_v2:';
      var ACTIVE_CHECKOUT_STORAGE_KEY = 'colamy_apply_coupon_checkout_active_v2';
      var feedbackTimers = new WeakMap();

      var shopRoot =
        window.Shopify &&
        window.Shopify.routes &&
        window.Shopify.routes.root
          ? window.Shopify.routes.root
          : '/';

      /*
       * 保存用户最后点击的折扣码。
       * CLM08、CLM12、CLM15 只保留最后选择的一个。
       */
      function saveDiscountCode(code) {
        try {
          localStorage.setItem(LEGACY_STORAGE_KEY, code);
        } catch (error) {
          console.warn('Unable to save discount code:', error);
        }
      }

      function getSavedDiscountCode() {
        try {
          return localStorage.getItem(LEGACY_STORAGE_KEY) || '';
        } catch (error) {
          return '';
        }
      }

      function getCheckoutDiscountStorageKey(coupon) {
        var scope = [
          coupon.dataset.templateSuffix || 'default',
          coupon.dataset.productId || 'product',
          coupon.dataset.sectionId || 'section',
          coupon.dataset.blockId || coupon.dataset.couponCode || 'coupon'
        ].join(':');

        return CHECKOUT_STORAGE_PREFIX + encodeURIComponent(scope);
      }

      function saveCheckoutDiscountCode(coupon, code) {
        try {
          localStorage.setItem(getCheckoutDiscountStorageKey(coupon), code);
          localStorage.setItem(ACTIVE_CHECKOUT_STORAGE_KEY, code);
        } catch (error) {
          console.warn('Unable to save checkout discount code:', error);
        }
      }

      function getSavedCheckoutDiscountCode(coupon) {
        try {
          if (coupon) {
            return localStorage.getItem(getCheckoutDiscountStorageKey(coupon)) || '';
          }

          return localStorage.getItem(ACTIVE_CHECKOUT_STORAGE_KEY) || '';
        } catch (error) {
          return '';
        }
      }

      function removeSavedCheckoutDiscountCode(coupon) {
        try {
          if (coupon) {
            var removedCode = getSavedCheckoutDiscountCode(coupon);
            localStorage.removeItem(getCheckoutDiscountStorageKey(coupon));

            if (
              removedCode &&
              getSavedCheckoutDiscountCode().toLowerCase() === removedCode.toLowerCase()
            ) {
              localStorage.removeItem(ACTIVE_CHECKOUT_STORAGE_KEY);
            }
          } else {
            localStorage.removeItem(ACTIVE_CHECKOUT_STORAGE_KEY);
          }
        } catch (error) {
          console.warn('Unable to remove checkout discount code:', error);
        }
      }

      function getActiveDiscountCode() {
        var pageCoupon = document.querySelector(
          '[data-apply-coupon-checkout].is-applied:not([hidden])'
        );

        if (pageCoupon) {
          return pageCoupon.dataset.couponCode || '';
        }

        return getSavedCheckoutDiscountCode() || getSavedDiscountCode();
      }

      function activateLegacyDiscountCode(code) {
        saveDiscountCode(code);
        removeSavedCheckoutDiscountCode();

        document
          .querySelectorAll('[data-apply-coupon-checkout]')
          .forEach(function (coupon) {
            removeSavedCheckoutDiscountCode(coupon);
            setApplyCouponState(coupon, false);
          });
      }

      /*
       * 通过 Shopify Cart AJAX API
       * 把折扣码写入当前购物车。
       */
      function applyDiscountToCart(code) {
        var updateRequest = fetch(shopRoot + 'cart/update.js', {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json'
          },
          body: JSON.stringify({
            discount: code
          })
        }).then(function (response) {
          if (!response.ok) {
            throw new Error(
              'Unable to apply discount. Status: ' + response.status
            );
          }

          return response.json();
        });

        if (code) {
          updateRequest = updateRequest.catch(function () {
            var cartJsonUrl = shopRoot + 'cart.js';
            var discountUrl =
              shopRoot +
              'discount/' +
              encodeURIComponent(code) +
              '?redirect=' +
              encodeURIComponent(cartJsonUrl);

            return fetch(discountUrl, {
              credentials: 'same-origin',
              redirect: 'follow'
            }).then(function (response) {
              if (!response.ok) {
                throw new Error(
                  'Unable to apply discount fallback. Status: ' +
                    response.status
                );
              }

              return fetch(cartJsonUrl, {
                credentials: 'same-origin',
                headers: { Accept: 'application/json' }
              }).then(function (cartResponse) {
                if (!cartResponse.ok) {
                  throw new Error(
                    'Unable to reload cart. Status: ' +
                      cartResponse.status
                  );
                }

                return cartResponse.json();
              });
            });
          });
        }

        return updateRequest.then(function (cartState) {
          var eventDetail = {
            cart: cartState,
            source: 'discount-code'
          };

          document.dispatchEvent(
            new CustomEvent('cart:updated', {
              bubbles: true,
              detail: eventDetail
            })
          );

          document.dispatchEvent(
            new CustomEvent('cart:refresh', {
              bubbles: true,
              detail: eventDetail
            })
          );

          return cartState;
        });
      }

      function copyWithFallback(value) {
        return new Promise(function (resolve, reject) {
          var textarea = document.createElement('textarea');

          textarea.value = value;
          textarea.setAttribute('readonly', '');
          textarea.style.position = 'fixed';
          textarea.style.top = '-9999px';
          textarea.style.left = '-9999px';
          textarea.style.opacity = '0';
          textarea.style.pointerEvents = 'none';

          document.body.appendChild(textarea);
          textarea.focus();
          textarea.select();

          try {
            var copied = document.execCommand('copy');
            textarea.remove();

            if (copied) {
              resolve();
            } else {
              reject(new Error('Copy command failed.'));
            }
          } catch (error) {
            textarea.remove();
            reject(error);
          }
        });
      }

      function copyCoupon(value) {
        if (
          navigator.clipboard &&
          window.isSecureContext &&
          typeof navigator.clipboard.writeText === 'function'
        ) {
          return navigator.clipboard.writeText(value).catch(function () {
            return copyWithFallback(value);
          });
        }

        return copyWithFallback(value);
      }

      var applyCouponObservers = new WeakMap();

      function getApplyCouponVariantPrices(coupon) {
        if (coupon._variantPrices) {
          return coupon._variantPrices;
        }

        var dataElement = coupon.querySelector(
          '[data-coupon-variant-prices]'
        );

        var variantPrices = {};

        if (dataElement) {
          try {
            JSON.parse(dataElement.textContent || '[]').forEach(
              function (variant) {
                variantPrices[String(variant.id)] = Number(variant.price);
              }
            );
          } catch (error) {
            console.warn('Unable to read coupon variant prices:', error);
          }
        }

        coupon._variantPrices = variantPrices;
        return variantPrices;
      }

      function getApplyCouponSectionRoot(coupon) {
        var sectionId = coupon.dataset.sectionId || '';

        return (
          document.getElementById('MainProduct-' + sectionId) ||
          coupon.closest('product-info') ||
          coupon.closest('.product__info-container') ||
          document
        );
      }

      function getApplyCouponVariantId(coupon) {
        var sectionId = coupon.dataset.sectionId || '';
        var productForm = document.getElementById(
          'product-form-' + sectionId
        );
        var variantInput = productForm
          ? productForm.querySelector('input[name="id"]')
          : null;

        if (!variantInput) {
          var sectionRoot = getApplyCouponSectionRoot(coupon);
          variantInput = sectionRoot.querySelector(
            'form[action*="/cart/add"] input[name="id"]'
          );
        }

        if (variantInput && variantInput.value) {
          return String(variantInput.value);
        }

        var urlVariant = new URL(window.location.href).searchParams.get(
          'variant'
        );

        if (urlVariant) {
          return String(urlVariant);
        }

        var variantPrices = getApplyCouponVariantPrices(coupon);
        return Object.keys(variantPrices)[0] || '';
      }

      function formatApplyCouponMoney(cents, currencyCode) {
        var locale =
          document.documentElement.lang || navigator.language || 'en-US';
        var currency = currencyCode || 'USD';

        try {
          return new Intl.NumberFormat(locale, {
            style: 'currency',
            currency: currency
          }).format(cents / 100);
        } catch (error) {
          return '$' + (cents / 100).toFixed(2);
        }
      }

      function getApplyCouponOffer(coupon) {
        var variantId = getApplyCouponVariantId(coupon);
        var variantPrices = getApplyCouponVariantPrices(coupon);
        var originalPrice = Number(variantPrices[variantId]);
        var minimumPrice = Number(
          coupon.dataset.minimumVariantPrice || 0
        );
        var discountPercent = Number(
          coupon.dataset.discountPercent || 0
        );

        if (
          !Number.isFinite(originalPrice) ||
          !discountPercent ||
          originalPrice < minimumPrice
        ) {
          return null;
        }

        return {
          coupon: coupon,
          finalPrice: Math.round(
            originalPrice * (100 - discountPercent) / 100
          ),
          discountPercent: discountPercent
        };
      }

      function updateBestApplyCoupon(coupon) {
        var sectionRoot = getApplyCouponSectionRoot(coupon);
        var coupons = Array.from(
          sectionRoot.querySelectorAll(
            '[data-apply-coupon-checkout]'
          )
        );
        var bestOffer = null;

        coupons.forEach(function (couponElement) {
          var offer = getApplyCouponOffer(couponElement);

          if (!offer) return;

          if (
            !bestOffer ||
            offer.finalPrice < bestOffer.finalPrice ||
            offer.finalPrice === bestOffer.finalPrice &&
              offer.discountPercent > bestOffer.discountPercent
          ) {
            bestOffer = offer;
          }
        });

        var activeCoupon = coupons.find(function (couponElement) {
          return couponElement.classList.contains('is-applied');
        });
        var activeOffer = activeCoupon
          ? getApplyCouponOffer(activeCoupon)
          : null;

        if (activeCoupon && !activeOffer) {
          removeSavedCheckoutDiscountCode(activeCoupon);
          setApplyCouponState(activeCoupon, false);
          applyDiscountToCart(getSavedDiscountCode()).catch(
            function (error) {
              console.warn(
                'Unable to remove ineligible coupon:',
                error
              );
            }
          );

          activeCoupon = null;
        }

        var visibleCoupon = activeOffer
          ? activeOffer.coupon
          : bestOffer && bestOffer.coupon;

        coupons.forEach(function (couponElement) {
          couponElement.hidden = couponElement !== visibleCoupon;
        });

        if (activeOffer) {
          renderApplyCouponPrice(activeOffer.coupon);
        }
      }

      function renderApplyCouponPrice(coupon) {
        if (!coupon.classList.contains('is-applied')) return;

        var variantId = getApplyCouponVariantId(coupon);
        var variantPrices = getApplyCouponVariantPrices(coupon);
        var originalPrice = Number(variantPrices[variantId]);
        var discountPercent = Number(
          coupon.dataset.discountPercent || 0
        );

        if (!originalPrice || !discountPercent) return;

        var discountedPrice = Math.round(
          originalPrice * (100 - discountPercent) / 100
        );
        var formattedPrice = formatApplyCouponMoney(
          discountedPrice,
          coupon.dataset.currencyCode
        );
        var label = coupon.querySelector('[data-coupon-label]');
        var status = coupon.querySelector('[data-coupon-status]');
        var appliedText = coupon.dataset.appliedText || 'Coupon applied! Final Price:';
        var finalMessage = appliedText + ' ' + formattedPrice;

        if (label) {
          label.textContent = finalMessage;
        }

        if (status) {
          status.textContent = finalMessage;
        }
      }

      function setApplyCouponState(coupon, isApplied) {
        var button = coupon.querySelector('[data-coupon-apply-button]');
        var label = coupon.querySelector('[data-coupon-label]');
        var status = coupon.querySelector('[data-coupon-status]');

        coupon.classList.toggle('is-applied', isApplied);

        if (button) {
          button.setAttribute(
            'aria-pressed',
            isApplied ? 'true' : 'false'
          );
        }

        if (label) {
          label.textContent = isApplied
            ? coupon.dataset.appliedText
            : coupon.dataset.applyText;
        }

        if (status) {
          status.textContent = isApplied
            ? coupon.dataset.appliedText
            : '';
        }

        if (isApplied) {
          requestAnimationFrame(function () {
            renderApplyCouponPrice(coupon);
          });
        }
      }

      function scheduleApplyCouponPrice(coupon) {
        window.clearTimeout(coupon._couponPriceTimer);
        coupon._couponPriceTimer = window.setTimeout(function () {
          renderApplyCouponPrice(coupon);
        }, 80);
      }

      function initializeApplyCoupons() {
        document
          .querySelectorAll('[data-apply-coupon-checkout]')
          .forEach(function (coupon) {
            if (coupon.dataset.couponInitialized === 'true') return;

            coupon.dataset.couponInitialized = 'true';
            getApplyCouponVariantPrices(coupon);

            var savedCode = getSavedCheckoutDiscountCode(coupon);
            var couponCode = coupon.dataset.couponCode || '';

            if (
              savedCode &&
              couponCode &&
              savedCode.toLowerCase() === couponCode.toLowerCase()
            ) {
              saveCheckoutDiscountCode(coupon, savedCode);
              setApplyCouponState(coupon, true);
            }

            var sectionRoot = getApplyCouponSectionRoot(coupon);
            var priceContainer = document.getElementById(
              'price-' + (coupon.dataset.sectionId || '')
            );

            sectionRoot.addEventListener(
              'change',
              function () {
                updateBestApplyCoupon(coupon);

                if (coupon.classList.contains('is-applied')) {
                  scheduleApplyCouponPrice(coupon);
                }
              },
              true
            );

            if (priceContainer && !applyCouponObservers.has(coupon)) {
              var observer = new MutationObserver(function () {
                updateBestApplyCoupon(coupon);

                if (coupon.classList.contains('is-applied')) {
                  scheduleApplyCouponPrice(coupon);
                }
              });

              observer.observe(priceContainer, {
                childList: true,
                subtree: true
              });

              applyCouponObservers.set(coupon, observer);
            }
          });

        document
          .querySelectorAll('[data-apply-coupon-checkout]')
          .forEach(updateBestApplyCoupon);
      }

      function handleApplyCoupon(event) {
        var button = event.target.closest(
          '[data-coupon-apply-button]'
        );

        if (!button) return;

        var coupon = button.closest('[data-apply-coupon-checkout]');
        if (!coupon) return;

        var code = (coupon.dataset.couponCode || '').trim();
        if (!code) return;

        event.preventDefault();
        event.stopImmediatePropagation();

        if (button.dataset.discountProcessing === 'true') return;

        var label = coupon.querySelector('[data-coupon-label]');
        var status = coupon.querySelector('[data-coupon-status]');
        button.dataset.discountProcessing = 'true';
        button.disabled = true;
        coupon.classList.add('is-loading');

        var isApplied = coupon.classList.contains('is-applied');
        var nextCode = isApplied ? getSavedDiscountCode() : code;

        applyDiscountToCart(nextCode)
          .then(function () {
            if (isApplied) {
              removeSavedCheckoutDiscountCode(coupon);
            } else {
              saveCheckoutDiscountCode(coupon, code);
            }

            getApplyCouponSectionRoot(coupon)
              .querySelectorAll('[data-apply-coupon-checkout]')
              .forEach(function (couponElement) {
                var elementCode =
                  couponElement.dataset.couponCode || '';
                var shouldApply =
                  !isApplied &&
                  elementCode.toLowerCase() === code.toLowerCase();

                if (!shouldApply && couponElement !== coupon) {
                  removeSavedCheckoutDiscountCode(couponElement);
                }

                setApplyCouponState(
                  couponElement,
                  shouldApply
                );
              });

            updateBestApplyCoupon(coupon);

            if (isApplied && status) {
              status.textContent =
                coupon.dataset.removedText || 'Coupon removed';
            }
          })
          .catch(function (error) {
            console.warn('Unable to apply coupon:', error);

            if (label) {
              label.textContent =
                coupon.dataset.errorText ||
                'Unable to apply coupon. Try again.';

              window.setTimeout(function () {
                label.textContent = isApplied
                  ? coupon.dataset.appliedText
                  : coupon.dataset.applyText;
              }, 2200);
            }

            if (status) {
              status.textContent =
                coupon.dataset.errorText ||
                'Unable to apply coupon. Try again.';
            }
          })
          .finally(function () {
            button.disabled = false;
            button.dataset.discountProcessing = 'false';
            coupon.classList.remove('is-loading');
          });
      }

      document.addEventListener('click', handleApplyCoupon, true);

      [
        'variant:change',
        'product:variant-change',
        'product:variant-changed'
      ].forEach(function (eventName) {
        document.addEventListener(eventName, function () {
          document
            .querySelectorAll('[data-apply-coupon-checkout]')
            .forEach(updateBestApplyCoupon);

          document
            .querySelectorAll('[data-apply-coupon-checkout].is-applied')
            .forEach(scheduleApplyCouponPrice);
        });
      });

      /*
       * 更新 Summer Saving、Coupon Code、
       * Discount Code 按钮的复制提示。
       */
      function showCopiedMessage(container) {
        if (!container) return;

        var feedbackTarget = container.querySelector(
          '[data-copy-feedback-target]'
        );

        if (!feedbackTarget) return;

        var originalText =
          feedbackTarget.dataset.copyOriginalText ||
          feedbackTarget.textContent;

        var copiedText =
          container.dataset.copiedText ||
          'Copied';

        var duration =
          Number(container.dataset.copiedDuration) ||
          1500;

        feedbackTarget.dataset.copyOriginalText = originalText;
        feedbackTarget.textContent = copiedText;
        container.classList.add('tooltip--is-visible');

        clearTimeout(feedbackTimers.get(container));

        feedbackTimers.set(
          container,
          setTimeout(function () {
            feedbackTarget.textContent =
              feedbackTarget.dataset.copyOriginalText;

            container.classList.remove('tooltip--is-visible');
          }, duration)
        );
      }

      /*
       * Summer Saving 模块的布局高度同步。
       * 保留你原代码中的这部分功能。
       */
      function syncSummerSavingLimitHeights() {
        document
          .querySelectorAll('.product__summer-saving')
          .forEach(function (summerSaving) {
            var firstLimit = summerSaving.querySelector(
              '.product__summer-saving-tier:first-child ' +
              '.product__summer-saving-limit'
            );

            if (!firstLimit) return;

            summerSaving.classList.remove(
              'product__summer-saving--limit-wrap'
            );

            var styles = window.getComputedStyle(firstLimit);

            var lineHeight =
              parseFloat(styles.lineHeight) ||
              parseFloat(styles.fontSize) * 1.15;

            var isWrapped =
              firstLimit.scrollHeight >
              Math.ceil(lineHeight) + 1;

            summerSaving.classList.toggle(
              'product__summer-saving--limit-wrap',
              isWrapped
            );
          });
      }

      /*
       * 点击 Copy 后：
       * 1. 复制代码
       * 2. 保存代码
       * 3. 写入 Shopify Cart
       */
      function handleDiscountCopy(event) {
        var button = event.target.closest(
          '.product__summer-saving-copy-button,' +
          '.product__coupon-code-copy-btn,' +
          '.product__discount-code-copy-btn'
        );

        if (!button) return;

        var container = button.closest(
          '.product__summer-saving-copy,' +
          '.product__coupon-code-copy,' +
          '.product__discount-code-copy'
        );

        if (!container) return;

        var code = (
          container.dataset.copyValue || ''
        ).trim();

        if (!code) return;

        event.preventDefault();
        event.stopImmediatePropagation();

        if (button.dataset.discountProcessing === 'true') {
          return;
        }

        button.dataset.discountProcessing = 'true';
        button.disabled = true;

        activateLegacyDiscountCode(code);

        /*
         * 复制和应用折扣同时执行。
         * 即使折扣未达到金额门槛，代码仍会保存到购物车。
         */
        Promise.all([
          copyCoupon(code),
          applyDiscountToCart(code)
        ])
          .then(function () {
            showCopiedMessage(container);
          })
          .catch(function (error) {
            console.warn('Unable to copy discount code:', error);
          })
          .finally(function () {
            button.disabled = false;
            button.dataset.discountProcessing = 'false';
          });
      }

      document.addEventListener(
        'click',
        handleDiscountCopy,
        true
      );

      /*
       * 兼容你原来的 discount_code_memorial 模块。
       *
       * 原按钮仍然使用：
       * onclick="copyAndApply('CLM08', 'btn-clm08')"
       */
      window.copyAndApply = function (code, btnId) {
        var button = document.getElementById(btnId);

        if (!code) return;

        activateLegacyDiscountCode(code);

        if (button) {
          button.disabled = true;
        }

        Promise.all([
          copyCoupon(code),
          applyDiscountToCart(code)
        ])
          .then(function () {
            if (!button) return;

            var originalText =
              button.dataset.originalText ||
              button.textContent;

            var originalBackground =
              button.dataset.originalBackground ||
              button.style.background;

            button.dataset.originalText = originalText;
            button.dataset.originalBackground =
              originalBackground;

            button.textContent = '✓ Copied!';
            button.style.background = '#27ae60';

            setTimeout(function () {
              button.textContent =
                button.dataset.originalText;

              button.style.background =
                button.dataset.originalBackground;

              button.disabled = false;
            }, 2000);
          })
          .catch(function (error) {
            console.warn('Unable to copy discount:', error);

            if (button) {
              button.disabled = false;
            }
          });
      };

      /*
       * 点击普通 Checkout 按钮前，
       * 再次把保存的折扣码写入购物车。
       */
      document.addEventListener(
        'click',
        function (event) {
          var checkoutButton = event.target.closest(
            'button[name="checkout"],' +
            'input[name="checkout"],' +
            'a[href*="/checkout"],' +
            '[data-checkout-button],' +
            '.shopify-payment-button__button,' +
            '.cart__checkout,' +
            '.drawer__checkout'
          );

          if (!checkoutButton) return;

          var savedCode = getActiveDiscountCode();

          if (!savedCode) return;

          if (
            checkoutButton.dataset.discountCheckoutProcessing ===
            'true'
          ) {
            return;
          }

          event.preventDefault();
          event.stopImmediatePropagation();

          checkoutButton.dataset.discountCheckoutProcessing =
            'true';

          if ('disabled' in checkoutButton) {
            checkoutButton.disabled = true;
          }

          var discountCheckoutUrl = shopRoot + 'checkout';

          window.location.assign(
            shopRoot +
              'discount/' +
              encodeURIComponent(savedCode) +
              '?redirect=' +
              encodeURIComponent(discountCheckoutUrl)
          );

          return;

          applyDiscountToCart(savedCode)
            .then(function () {
              /*
               * 应用成功后进入正常 Shopify Checkout。
               */
              window.location.href =
                shopRoot + 'checkout';
            })
            .catch(function (error) {
              console.warn(
                'AJAX discount application failed. Using discount URL fallback.',
                error
              );

              /*
               * AJAX 失败时使用 Shopify 折扣链接兜底。
               */
              var checkoutUrl =
                shopRoot + 'checkout';

              window.location.href =
                shopRoot +
                'discount/' +
                encodeURIComponent(savedCode) +
                '?redirect=' +
                encodeURIComponent(checkoutUrl);
            });
        },
        true
      );

      /*
       * 用户刷新页面或进入其他产品页时，
       * 恢复之前选择的折扣码。
       */
      function restoreSavedDiscount() {
        var savedCode = getActiveDiscountCode();

        if (!savedCode) return;

        applyDiscountToCart(savedCode).catch(function (error) {
          console.warn(
            'Saved discount could not be restored:',
            error
          );
        });
      }

      var restoreDiscountTimer;

      function scheduleSavedDiscountRestore() {
        window.clearTimeout(restoreDiscountTimer);
        restoreDiscountTimer = window.setTimeout(
          restoreSavedDiscount,
          650
        );
      }

      document.addEventListener(
        'submit',
        function (event) {
          var form = event.target;

          if (
            form &&
            form.matches &&
            form.matches('form[action*="/cart/add"]')
          ) {
            scheduleSavedDiscountRestore();
          }
        },
        true
      );

      [
        'product:added',
        'cart:item-added',
        'ajaxProduct:added'
      ].forEach(function (eventName) {
        document.addEventListener(
          eventName,
          scheduleSavedDiscountRestore
        );
      });

      initializeApplyCoupons();
      syncSummerSavingLimitHeights();
      restoreSavedDiscount();

      window.addEventListener(
        'resize',
        syncSummerSavingLimitHeights
      );

      window.addEventListener(
        'orientationchange',
        syncSummerSavingLimitHeights
      );

      document.addEventListener(
        'shopify:section:load',
        function () {
          initializeApplyCoupons();
          syncSummerSavingLimitHeights();
          restoreSavedDiscount();
        }
      );

      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(
          syncSummerSavingLimitHeights
        );
      }
    })();
  }
</script>
