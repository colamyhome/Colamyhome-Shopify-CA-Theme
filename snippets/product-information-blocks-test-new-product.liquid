{%- liquid
  assign default_form_id = 'product-form-' | append: section.id
  assign product_form_id = product_form_id | default: default_form_id
  assign product_media_count = product.media.size
-%}
<div
  id="ProductInfo-{{ section.id }}"
  data-section="{{ section.id }}"
  data-url="{{ product.url }}"
  class="product__info-container{% if enable_sticky_info %} sticky-element{% endif %}"
>
  <div class="product__blocks accordion-parent">
    {%- for block in section.blocks -%}
      {%- liquid
        assign is_show_below_media = block.settings.show_below_product_media | default: false
        assign block_classes = 'product__block product__block--' | append: block.type
        if block.id contains 'wc_product_review_badge'
          assign block_classes = block_classes | append: ' product__block--review-badge'
        endif
        if is_show_below_media and product_media_count > 0
          assign block_classes = block_classes | append: ' block md:hidden'
        endif
      -%}
      {%- capture additional_attributes -%}
        data-block-id="{{ block.id }}"
        {% if is_show_below_media %}
          data-show-below-media="true"
        {% endif %}
      {%- endcapture -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          <div class="{{ block_classes }}">
            {% render block %}
          </div>
        {%- when 'divider' -%}
          <div 
            class="{{ block_classes }}"
            {{ additional_attributes }}
            {{ block.shopify_attributes }}
          >
            <div class="product__divider border-top no-empty"></div>
          </div>
        {%- when 'promotion_alert' -%}
          {%- capture rgb -%}
            {{ block.settings.text_color.red }},{{ block.settings.text_color.green }},{{ block.settings.text_color.blue }}
          {%- endcapture -%}
          <div
            class="{{ block_classes }}"
            {{ additional_attributes }}
            {{ block.shopify_attributes }}
            style="color: {{ block.settings.text_color }};--color-foreground:{{ rgb }};--color-link:{{ rgb }};--color-button-text:{{ rgb }}"
          >
            {%- if block.settings.heading != blank or block.settings.description != blank -%}
              <product-promotion-alert class="product__promotion-alert relative flex items-center gap-3 blocks-radius">
                {%- if block.settings.icon != 'none' -%}
                  <div class="product__promotion-alert-icon flex shrink-0">
                    {%- render 'icons', icon: block.settings.icon, size: 'extra-large' -%}
                  </div>
                {%- endif -%}
                <div class="product__promotion-alert-info flex flex-grow flex-col gap-1">
                  {%- if block.settings.heading != blank -%}
                    <div class="product__promotion-alert-heading font-body-bolder">{{ block.settings.heading }}</div>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <div class="product__promotion-alert-heading rte text-sm-extra">
                      {{ block.settings.description }}
                    </div>
                  {%- endif -%}
                </div>
                <button
                  class="btn--small btn--icon btn--icon-circle no-js-hidden"
                  aria-label="{{ 'accessibility.close' | t }}"
                >
                  {%- render 'icon-close', size: 'small' -%}
                </button>
              </product-promotion-alert>
            {%- endif -%}
          </div>
        {%- when 'discount_code' -%}
          {%- liquid
            assign discount_code = product.metafields.custom.discount_code.value | default: product.metafields.custom.discount_code | strip
            assign discount_description = block.settings.description_text | strip

            assign discount_description_color = block.settings.description_color | default: block.settings.text_color
            assign discount_left_background_color = block.settings.left_background_color | default: '#C9A260'
            assign discount_right_background_color = block.settings.right_background_color | default: '#FFFFFF'
            assign discount_right_text_color = block.settings.text_color | default: '#C9A260'
            assign discount_description_font_size = block.settings.description_font_size | default: 24
            assign discount_code_font_size = block.settings.code_font_size | default: 24
          -%}
          {%- if discount_code != blank -%}
            <div
              class="{{ block_classes }} product__discount-code blocks-radius relative overflow-hidden"
              style="--discount-code-height: {{ block.settings.component_height }}px;--discount-code-left-bg: {{ discount_left_background_color }};--discount-code-left-text: {{ discount_description_color }};--discount-code-right-bg: {{ discount_right_background_color }};--discount-code-right-text: {{ discount_right_text_color }};--discount-code-description-size: {{ discount_description_font_size }}px;--discount-code-text-size: {{ discount_code_font_size }}px;"
              {{ additional_attributes }}
              {{ block.shopify_attributes }}
            >
              <div class="product__discount-code-inner relative z-1">
                <div class="product__discount-code-left">
                  <div class="product__discount-code-info flex flex-col gap-1">
                    {%- if discount_description != blank -%}
                      <span class="product__discount-code-description">{{ discount_description | escape }}</span>
                    {%- endif -%}
                  </div>
                </div>
                <div class="product__discount-code-right">
                  <div class="product__discount-code-heading">
                    <span>CODE:</span>
                    <span class="product__discount-code-value">{{ discount_code }}</span>
                  </div>
                  <div
                    class="product__discount-code-copy"
                    is="copy-to-clipboard"
                    data-copy-value="{{ discount_code | escape }}"
                    data-copied-text="{{ 'general.share.copied' | t }}"
                    data-copied-duration="2000"
                  >
                    <button type="button" class="product__discount-code-copy-btn">
                      <span data-copy-feedback-target>{{ 'general.share.copy' | t }}</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- when 'coupon_code' -%}
          {%- liquid
            assign coupon_offer_text = block.settings.offer_text | default: 'Get 8% off' | strip
            assign coupon_limit_text = block.settings.limit_text | default: 'no limited' | strip
            assign coupon_code_label = block.settings.code_label | default: 'Code:' | strip
            assign coupon_code = block.settings.coupon_code | default: 'CLM08' | strip
            assign coupon_copy_text = block.settings.copy_text | default: 'Copy' | strip
            assign coupon_copied_text = block.settings.copied_text | default: 'Copied' | strip
            assign coupon_background_color = block.settings.background_color | default: '#FBF8F3'
            assign coupon_accent_color = block.settings.accent_color | default: '#C8AE79'
            assign coupon_button_background_color = block.settings.button_background_color | default: '#C8A567'
            assign coupon_button_text_color = block.settings.button_text_color | default: '#FFFFFF'
            assign coupon_copied_text_color = block.settings.copied_text_color | default: '#1B9B5F'
          -%}
          {%- if coupon_code != blank -%}
            <div
              class="{{ block_classes }} product__coupon-code-list"
              style="--coupon-background: {{ coupon_background_color }};--coupon-accent: {{ coupon_accent_color }};--coupon-button-background: {{ coupon_button_background_color }};--coupon-button-text: {{ coupon_button_text_color }};--coupon-copied-text: {{ coupon_copied_text_color }};"
              {{ additional_attributes }}
              {{ block.shopify_attributes }}
            >
              <div class="product__coupon-code-card">
                <div class="product__coupon-code-part product__coupon-code-part--offer">
                  {%- if coupon_offer_text != blank -%}
                    <div class="product__coupon-code-offer">{{ coupon_offer_text | escape }}</div>
                  {%- endif -%}
                  {%- if coupon_limit_text != blank -%}
                    <div class="product__coupon-code-limit">{{ coupon_limit_text | escape }}</div>
                  {%- endif -%}
                </div>
                <div class="product__coupon-code-part product__coupon-code-part--code">
                  {%- if coupon_code_label != blank -%}
                    <span class="product__coupon-code-label">{{ coupon_code_label | escape }}</span>
                  {%- endif -%}
                  <span class="product__coupon-code-value">{{ coupon_code | escape }}</span>
                </div>
                <div class="product__coupon-code-part product__coupon-code-part--copy">
                  <div
                    class="product__coupon-code-copy"
                    is="copy-to-clipboard"
                    data-copy-value="{{ coupon_code | escape }}"
                    data-copied-text="{{ coupon_copied_text | escape }}"
                    data-copied-duration="1000"
                  >
                    <button type="button" class="product__coupon-code-copy-btn">
                      <span class="product__coupon-code-copy-text" data-copy-feedback-target>{{ coupon_copy_text | escape }}</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- when 'apply_coupon_checkout' -%}
          {%- liquid
            assign apply_coupon_code = block.settings.coupon_code | default: 'LUXE' | strip
            assign apply_coupon_percent = block.settings.discount_percent | default: 10
            assign apply_coupon_text = block.settings.apply_text | default: 'Apply 10% off coupon' | strip
            assign applied_coupon_text = block.settings.applied_text | default: 'Coupon applied! Final Price:' | strip
            assign removed_coupon_text = block.settings.removed_text | default: 'Coupon removed' | strip
            assign apply_coupon_error_text = block.settings.error_text | default: 'Unable to apply coupon. Try again.' | strip
          -%}
          {%- if apply_coupon_code != blank and apply_coupon_percent > 0 -%}
            <div
              class="{{ block_classes }} product__apply-coupon"
              data-apply-coupon-checkout
              data-section-id="{{ section.id }}"
              data-product-id="{{ product.id }}"
              data-template-suffix="{{ template.suffix | default: 'default' | escape }}"
              data-coupon-code="{{ apply_coupon_code | escape }}"
              data-discount-percent="{{ apply_coupon_percent }}"
              data-minimum-variant-price="{{ block.settings.minimum_variant_price | default: 0 | times: 100 }}"
              data-apply-text="{{ apply_coupon_text | escape }}"
              data-applied-text="{{ applied_coupon_text | escape }}"
              data-removed-text="{{ removed_coupon_text | escape }}"
              data-error-text="{{ apply_coupon_error_text | escape }}"
              data-currency-code="{{ cart.currency.iso_code | default: shop.currency | escape }}"
              style="--apply-coupon-background: {{ block.settings.background_color }}; --apply-coupon-text: {{ block.settings.text_color }}; --apply-coupon-checkbox: {{ block.settings.checkbox_color }}; --apply-coupon-active: {{ block.settings.applied_color }};"
              {{ additional_attributes }}
              {{ block.shopify_attributes }}
            >
              <button
                type="button"
                class="product__apply-coupon-button"
                data-coupon-apply-button
                aria-pressed="false"
              >
                <span class="product__apply-coupon-checkbox" aria-hidden="true">
                  <svg viewBox="0 0 20 20" focusable="false">
                    <path d="M4 10.2 8.1 14 16 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                <span class="product__apply-coupon-content">
                  <span class="product__apply-coupon-label" data-coupon-label>{{ apply_coupon_text | escape }}</span>
                </span>
              </button>

              <span class="product__apply-coupon-status" data-coupon-status role="status" aria-live="polite"></span>

              <script type="application/json" data-coupon-variant-prices>
                [
                  {%- for variant in product.variants -%}
                    {"id":{{ variant.id | json }},"price":{{ variant.price | json }}}{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                ]
              </script>
            </div>

            <style>
              .product__apply-coupon {
                width: 100%;
                position: relative;
              }

              .product__apply-coupon-button {
                appearance: none;
                width: 100%;
                min-height: 30px;
                display: flex;
                align-items: center;
                gap: 16px;
                padding: 0px 10px;
                border: 0;
                border-radius: 0;
                background: var(--apply-coupon-background, #fbf7ef);
                color: var(--apply-coupon-text, #2d2d2d);
                font: inherit;
                text-align: left;
                cursor: pointer;
                transition: opacity 0.2s ease, background-color 0.2s ease;
              }

              .product__apply-coupon-button:hover {
                opacity: 0.88;
              }

              .product__apply-coupon-button:focus-visible {
                outline: 2px solid currentColor;
                outline-offset: 2px;
              }

              .product__apply-coupon-checkbox {
                width: 20px;
                height: 20px;
                flex: 0 0 0px;
                display: grid;
                place-items: center;
                border: 2px solid var(--apply-coupon-checkbox, #222222);
                border-radius: 0;
                color: #ffffff;
                transition: background-color 0.2s ease, border-color 0.2s ease;
              }

              .product__apply-coupon-checkbox svg {
                width: 14px;
                height: 14px;
                opacity: 0;
                transform: scale(0.7);
                transition: opacity 0.18s ease, transform 0.18s ease;
              }

              .product__apply-coupon-label {
                font-size: clamp(12px, 2vw, 14px);
                font-weight: 400;
                line-height: 1.25;
                letter-spacing: -0.01em;
              }

              .product__apply-coupon-content {
                min-width: 0;
                display: flex;
                align-items: center;
                flex: 1 1 auto;
              }

              .product__apply-coupon-status {
                position: absolute;
                width: 1px;
                height: 1px;
                overflow: hidden;
                clip: rect(0 0 0 0);
                white-space: nowrap;
              }

              .product__apply-coupon.is-applied .product__apply-coupon-button {
                background: var(--apply-coupon-background, #fbf7ef);
              }

              .product__apply-coupon.is-applied .product__apply-coupon-checkbox {
                border-color: var(--apply-coupon-active, #222222);
                background: var(--apply-coupon-active, #222222);
              }

              .product__apply-coupon.is-applied .product__apply-coupon-checkbox svg {
                opacity: 1;
                transform: scale(1);
              }

              .product__apply-coupon.is-loading .product__apply-coupon-button {
                opacity: 0.62;
                cursor: wait;
              }

              @media (max-width: 749px) {
                .product__apply-coupon-button {
                  min-height: 10px;
                  gap: 12px;
                  padding: 0px 10px;
                }

                .product__apply-coupon-checkbox {
                  width: 20px;
                  height: 20px;
                  flex-basis: 20px;
                }

                .product__apply-coupon-checkbox svg {
                  width: 12px;
                  height: 12px;
                }

                .product__apply-coupon-label {
                  font-size: 12px;
                }

              }
            </style>
          {%- endif -%}
        {%- when 'summer_saving' -%}
          {%- liquid
            assign summer_saving_heading = block.settings.heading | default: 'SUMMER SAVINGS' | strip
            assign summer_saving_eyebrow = block.settings.eyebrow | default: 'LIMITED-TIME CODES' | strip
            assign first_coupon_code = block.settings.first_coupon_code | default: 'CLM08' | strip
            assign second_coupon_code = block.settings.second_coupon_code | default: 'CLM12' | strip
            assign third_coupon_code = block.settings.third_coupon_code | default: 'CLM15' | strip
            assign summer_saving_copy_text = block.settings.copy_text | default: 'COPY' | strip
            assign summer_saving_copied_text = block.settings.copied_text | default: 'Copied' | strip
          -%}
          <div
            class="{{ block_classes }} product__summer-saving"
            {{ additional_attributes }}
            {{ block.shopify_attributes }}
          >
            <div class="product__summer-saving-header">
              {%- if summer_saving_heading != blank -%}
                <div class="product__summer-saving-title">
                  <span class="product__summer-saving-title-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="M20 7h-2.1c.1-.3.1-.6.1-.9C18 4.4 16.6 3 14.9 3c-1.2 0-2.2.6-2.9 1.6C11.3 3.6 10.3 3 9.1 3 7.4 3 6 4.4 6 6.1c0 .3 0 .6.1.9H4c-.6 0-1 .4-1 1v4h2v8c0 .6.4 1 1 1h12c.6 0 1-.4 1-1v-8h2V8c0-.6-.4-1-1-1ZM9.1 5c.8 0 1.5.7 1.8 2H8.1c-.1-.3-.1-.6-.1-.9C8 5.5 8.5 5 9.1 5Zm5.8 0c.6 0 1.1.5 1.1 1.1 0 .3 0 .6-.1.9h-2.8c.3-1.3 1-2 1.8-2ZM5 9h6v2H5V9Zm2 4h4v6H7v-6Zm10 6h-4v-6h4v6Zm2-8h-6V9h6v2Z" fill="currentColor"/>
                    </svg>
                  </span>
                  <span>{{ summer_saving_heading | escape }}</span>
                </div>
              {%- endif -%}
              {%- if summer_saving_eyebrow != blank -%}
                <div class="product__summer-saving-eyebrow">{{ summer_saving_eyebrow | escape }}</div>
              {%- endif -%}
            </div>
            <div class="product__summer-saving-tiers">
              <div class="product__summer-saving-tier">
                <div class="product__summer-saving-offer">8% OFF</div>
                <div class="product__summer-saving-limit">No Minimum</div>
                {%- if first_coupon_code != blank -%}
                  <div
                    class="product__summer-saving-copy"
                    data-copy-value="{{ first_coupon_code | escape }}"
                    data-copied-text="{{ summer_saving_copied_text | escape }}"
                    data-copied-duration="1000"
                  >
                    <button type="button" class="product__summer-saving-copy-button">
                      <span class="product__summer-saving-code">{{ first_coupon_code | escape }}</span>
                      <span class="product__summer-saving-copy-text" data-copy-feedback-target>{{ summer_saving_copy_text | escape }}</span>
                    </button>
                  </div>
                {%- endif -%}
              </div>
              <div class="product__summer-saving-tier">
                <div class="product__summer-saving-offer">12% OFF</div>
                <div class="product__summer-saving-limit">$200-$400</div>
                {%- if second_coupon_code != blank -%}
                  <div
                    class="product__summer-saving-copy"
                    data-copy-value="{{ second_coupon_code | escape }}"
                    data-copied-text="{{ summer_saving_copied_text | escape }}"
                    data-copied-duration="1000"
                  >
                    <button type="button" class="product__summer-saving-copy-button">
                      <span class="product__summer-saving-code">{{ second_coupon_code | escape }}</span>
                      <span class="product__summer-saving-copy-text" data-copy-feedback-target>{{ summer_saving_copy_text | escape }}</span>
                    </button>
                  </div>
                {%- endif -%}
              </div>
              <div class="product__summer-saving-tier">
                <div class="product__summer-saving-offer">15% OFF</div>
                <div class="product__summer-saving-limit">over $400</div>
                {%- if third_coupon_code != blank -%}
                  <div
                    class="product__summer-saving-copy"
                    data-copy-value="{{ third_coupon_code | escape }}"
                    data-copied-text="{{ summer_saving_copied_text | escape }}"
                    data-copied-duration="1000"
                  >
                    <button type="button" class="product__summer-saving-copy-button">
                      <span class="product__summer-saving-code">{{ third_coupon_code | escape }}</span>
                      <span class="product__summer-saving-copy-text" data-copy-feedback-target>{{ summer_saving_copy_text | escape }}</span>
                    </button>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- when 'discount_code_memorial' -%}
          {%- assign memorial_discount_code = block.settings.discount_code | strip -%}
          {%- if memorial_discount_code != blank -%}
            <div
              class="{{ block_classes }}"
              {{ additional_attributes }}
              {{ block.shopify_attributes }}
              style="padding-top:{{ block.settings.padding_top }}px; padding-bottom:{{ block.settings.padding_bottom }}px;"
            >
              {%- if memorial_discount_code == 'CLM08' or memorial_discount_code == 'CLM12' or memorial_discount_code == 'CLM15' -%}
                <div style="display:flex; flex-direction:column; gap:10px;">
                  <div style="background:#f9f3ea; border:1.5px dashed #d4b896; border-radius:12px; padding:14px 18px; display:flex; align-items:center; justify-content:space-between;">
                    <div>
                      <div style="font-size:15px; color:#666; font-weight:500;">Under $200</div>
                      <div style="font-size:26px; font-weight:500; color:#1a1a1a; line-height:1.1;">8% OFF</div>
                      <div style="margin-top:6px;"><span style="border:1.5px solid #c8a97a; border-radius:20px; padding:3px 12px; font-size:13px; color:#5a3e1b; font-weight:500;">CODE: CLM08</span></div>
                    </div>
                    <button id="btn-clm08" onclick="copyAndApply('CLM08', 'btn-clm08')" style="background:#c0392b; color:white; border:none; border-radius:25px; padding:10px 22px; font-weight:500; font-size:14px; cursor:pointer; min-width:80px;">COPY</button>
                  </div>
                  <div style="background:#f9f3ea; border:1.5px dashed #d4b896; border-radius:12px; padding:14px 18px; display:flex; align-items:center; justify-content:space-between;">
                    <div>
                      <div style="font-size:15px; color:#666; font-weight:500;">Over $200</div>
                      <div style="font-size:26px; font-weight:500; color:#1a1a1a; line-height:1.1;">12% OFF</div>
                      <div style="margin-top:6px;"><span style="border:1.5px solid #c8a97a; border-radius:20px; padding:3px 12px; font-size:13px; color:#5a3e1b; font-weight:500;">CODE: CLM12</span></div>
                    </div>
                    <button id="btn-clm12" onclick="copyAndApply('CLM12', 'btn-clm12')" style="background:#c0392b; color:white; border:none; border-radius:25px; padding:10px 22px; font-weight:500; font-size:14px; cursor:pointer; min-width:80px;">COPY</button>
                  </div>
                  <div style="background:#f9f3ea; border:1.5px dashed #d4b896; border-radius:12px; padding:14px 18px; display:flex; align-items:center; justify-content:space-between;">
                    <div>
                      <div style="font-size:15px; color:#666; font-weight:500;">Over $400</div>
                      <div style="font-size:26px; font-weight:500; color:#1a1a1a; line-height:1.1;">15% OFF</div>
                      <div style="margin-top:6px;"><span style="border:1.5px solid #c8a97a; border-radius:20px; padding:3px 12px; font-size:13px; color:#5a3e1b; font-weight:500;">CODE: CLM15</span></div>
                    </div>
                    <button id="btn-clm15" onclick="copyAndApply('CLM15', 'btn-clm15')" style="background:#c0392b; color:white; border:none; border-radius:25px; padding:10px 22px; font-weight:500; font-size:14px; cursor:pointer; min-width:80px;">COPY</button>
                  </div>
                </div>
              {%- else -%}
                <div style="background:#f9f3ea; border:1.5px dashed #d4b896; border-radius:12px; padding:14px 18px; display:flex; align-items:center; justify-content:space-between;">
                  <div>
                    <div style="font-size:15px; color:#666; font-weight:500;">Limited Offer</div>
                    <div style="font-size:26px; font-weight:500; color:#1a1a1a; line-height:1.1;">20% OFF</div>
                    <div style="margin-top:6px;"><span style="border:1.5px solid #c8a97a; border-radius:20px; padding:3px 12px; font-size:13px; color:#5a3e1b; font-weight:500;">CODE: {{ memorial_discount_code }}</span></div>
                  </div>
                  <button id="btn-{{ memorial_discount_code | downcase }}" onclick="copyAndApply('{{ memorial_discount_code }}', 'btn-{{ memorial_discount_code | downcase }}')" style="background:#c0392b; color:white; border:none; border-radius:25px; padding:10px 22px; font-weight:500; font-size:14px; cursor:pointer; min-width:80px;">COPY</button>
                </div>
              {%- endif -%}
            </div>

            <script>
            if (!window.copyAndApplyDefined) {
              window.copyAndApplyDefined = true;
              window.copyAndApply = function(code, btnId) {
                navigator.clipboard.writeText(code).catch(function() {
                  var t = document.createElement('textarea');
                  t.value = code;
                  document.body.appendChild(t);
                  t.select();
                  document.execCommand('copy');
                  document.body.removeChild(t);
                });
                var iframe = document.createElement('iframe');
                iframe.style.display = 'none';
                iframe.src = '/discount/' + code;
                document.body.appendChild(iframe);
                setTimeout(function() { document.body.removeChild(iframe); }, 3000);
                var btn = document.getElementById(btnId);
                btn.innerText = '✓ Copied!';
                btn.style.background = '#27ae60';
                setTimeout(function() {
                  btn.innerText = 'COPY';
                  btn.style.background = '#c0392b';
                }, 2000);
              }
            }
            </script>
