        {%- when 'newsletter' -%}
          <div 
            class="{{ block_classes }} flex flex-col gap-5"
            {{ additional_attributes }}
            {{ block.shopify_attributes }}
          >
            <h2 class="{{ block.settings.heading_size }}">{{ block.settings.heading }}</h2>
            <div class="grid gap-4 text-center">
