            class="{{ block_classes }}"
            {{ additional_attributes }}
            {{ block.shopify_attributes }}
            style="--delivery-time-font-size: {{ desktop_font_size }}px; --delivery-time-font-weight: {{ desktop_font_weight }}; --delivery-time-mobile-font-size: {{ mobile_font_size }}px; --delivery-time-mobile-font-weight: {{ mobile_font_weight }};"
          >
            <div class="product__delivery-time">
              <span
                class="product__delivery-time-icon"
                aria-hidden="true"
                style="--delivery-time-icon: url({{ delivery_time_icon_asset | asset_url }});"
              ></span>
              {%- if block.settings.text != blank -%}
