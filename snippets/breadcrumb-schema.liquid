{%- if request.page_type == 'product' -%}
  {%- liquid
    assign primary_collection = product.metafields.breadcrumb.primary_collection.value
    assign product_position = 2

    if primary_collection != blank
      assign product_position = 3
    endif
  -%}

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": {{ canonical_url | append: '#breadcrumb' | json }},
    "name": "Product breadcrumb",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ shop.url | append: routes.root_url | json }}
      }
      {%- if primary_collection != blank -%}
      ,
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ primary_collection.title | json }},
        "item": {{ shop.url | append: primary_collection.url | json }}
      }
      {%- endif -%}
      ,
      {
        "@type": "ListItem",
        "position": {{ product_position }},
        "name": {{ product.title | json }},
        "item": {{ canonical_url | json }}
      }
    ]
  }
  </script>
{%- endif -%}