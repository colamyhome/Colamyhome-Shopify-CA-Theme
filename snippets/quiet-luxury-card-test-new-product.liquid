{%- liquid
  assign title_alignment = block.settings.video_top_text_alignment | default: 'left'
  assign title_alignment_class = 'quiet-luxury-card__title--left'
  assign source_product = block.settings.source_product
  assign source_product_handle = blank
  assign source_video = blank
  assign selling_point_images = blank
  assign selling_point_count = 0
  assign metafield_description_text = blank
  assign metafield_description_is_richtext = false
  assign video_top_text_font_size = block.settings.video_top_text_font_size | default: 16
  assign video_top_text_font_weight = block.settings.video_top_text_font_weight | default: 500
  assign product_metafield_title_font_size = block.settings.product_metafield_title_font_size | default: 16
  assign product_metafield_title_font_weight = block.settings.product_metafield_title_font_weight | default: 500
  assign product_metafield_text_font_size = block.settings.product_metafield_text_font_size | default: 14
  assign product_metafield_text_font_weight = block.settings.product_metafield_text_font_weight | default: 300
  assign product_metafield_text_color = block.settings.product_metafield_text_color | default: '#757575'
  assign product_metafield_mobile_title_font_size = block.settings.product_metafield_mobile_title_font_size | default: 16
  assign product_metafield_mobile_title_font_weight = block.settings.product_metafield_mobile_title_font_weight | default: 500
  assign product_metafield_mobile_text_font_size = block.settings.product_metafield_mobile_text_font_size | default: 14
  assign product_metafield_mobile_text_font_weight = block.settings.product_metafield_mobile_text_font_weight | default: 300
  assign product_metafield_mobile_text_color = block.settings.product_metafield_mobile_text_color | default: '#757575'
  assign product_metafield_text_alignment = block.settings.product_metafield_text_alignment | default: 'center'
  assign product_metafield_text_justify = product_metafield_text_alignment | replace: 'left', 'flex-start' | replace: 'right', 'flex-end'
  assign video_row_background_color = block.settings.video_row_background_color | default: 'rgba(244,244,244,1)'
  assign love_it_background_color = block.settings.love_it_background_color | default: '#f4f1ec'
  assign love_it_heading_font_size = block.settings.love_it_heading_font_size | default: 24
  assign love_it_heading_font_weight = block.settings.love_it_heading_font_weight | default: 500
  assign love_it_item_title_font_size = block.settings.love_it_item_title_font_size | default: 12
  assign love_it_item_title_font_weight = block.settings.love_it_item_title_font_weight | default: 600
  assign love_it_item_text_font_size = block.settings.love_it_item_text_font_size | default: 11
  assign love_it_item_text_font_weight = block.settings.love_it_item_text_font_weight | default: 300
  assign love_it_text_alignment = block.settings.love_it_text_alignment | default: 'center'
  assign love_it_mobile_heading_font_size = block.settings.love_it_mobile_heading_font_size | default: love_it_heading_font_size
  assign love_it_mobile_heading_font_weight = block.settings.love_it_mobile_heading_font_weight | default: love_it_heading_font_weight
  assign love_it_mobile_item_title_font_size = block.settings.love_it_mobile_item_title_font_size | default: love_it_item_title_font_size
  assign love_it_mobile_item_title_font_weight = block.settings.love_it_mobile_item_title_font_weight | default: love_it_item_title_font_weight
  assign love_it_mobile_item_text_font_size = block.settings.love_it_mobile_item_text_font_size | default: love_it_item_text_font_size
  assign love_it_mobile_item_text_font_weight = block.settings.love_it_mobile_item_text_font_weight | default: love_it_item_text_font_weight
  assign love_it_mobile_text_alignment = block.settings.love_it_mobile_text_alignment | default: love_it_text_alignment
  assign metafield_video = blank
  assign metafield_image = blank
  assign metafield_description = blank
  assign love_it_metafield = blank
  assign love_it_content = blank
  assign love_it_heading = blank
  assign love_it_items = blank
  assign love_it_has_items = false
  assign love_it_item_count = 0
  assign scene_presentation_metafield = blank
  assign scene_presentation_content = blank
  assign scene_presentation_count = 0

  if source_product == blank and product != blank
    assign source_product = product
  endif

  if source_product != blank and source_product.metafields == blank
    assign source_product_handle = source_product.handle | default: source_product
    if source_product_handle != blank and all_products[source_product_handle] != blank
      assign source_product = all_products[source_product_handle]
    endif
  endif

  if source_product != blank
    assign metafield_video = source_product.metafields.foxtheme.product_video.value
    if metafield_video == blank
      assign metafield_video = source_product.metafields.custom.product_video.value
    endif

    assign metafield_image = source_product.metafields.foxtheme.product_image.value
    if metafield_image == blank
      assign metafield_image = source_product.metafields.custom.product_image.value
    endif

    assign metafield_description = source_product.metafields.foxtheme.product_description
    if metafield_description == blank
      assign metafield_description = source_product.metafields.custom.product_description
    endif

    assign love_it_metafield = source_product.metafields.custom.love_it
    if love_it_metafield != blank
      assign love_it_content = love_it_metafield.value
      for love_it_group in love_it_content
        assign love_it_heading = love_it_group[0]
        assign love_it_items = love_it_group[1]
        break
      endfor

      if love_it_items != blank
        for love_it_item in love_it_items
          assign love_it_item_title = love_it_item[0]
          assign love_it_item_text = love_it_item[1]
          if love_it_item_title != blank or love_it_item_text != blank
            assign love_it_has_items = true
            assign love_it_item_count = love_it_item_count | plus: 1
          endif
        endfor
      endif
    endif

    assign scene_presentation_metafield = source_product.metafields.custom.scene_presentation
    if scene_presentation_metafield != blank
      assign scene_presentation_content = scene_presentation_metafield.value
      for scene_presentation_entry in scene_presentation_content
        assign scene_presentation_data = scene_presentation_entry[1]
        assign scene_presentation_image = scene_presentation_data.image
        assign scene_presentation_title = scene_presentation_data.title
        assign scene_presentation_text = scene_presentation_data.content
        if scene_presentation_image != blank or scene_presentation_title != blank or scene_presentation_text != blank
          assign scene_presentation_count = scene_presentation_count | plus: 1
        endif
      endfor
    endif

    assign source_video = source_product.media | where: 'media_type', 'video' | first
    if source_video == blank
      assign source_video = source_product.media | where: 'media_type', 'external_video' | first
    endif

    assign selling_point_images = source_product.metafields.foxtheme.product_selling_points_images.value
    if selling_point_images == blank
      assign selling_point_images = source_product.metafields.custom.product_selling_points_images.value
    endif

    if selling_point_images != blank and selling_point_images.size == blank
      assign selling_point_images = source_product.metafields.foxtheme.product_selling_points_images
      if selling_point_images == blank
        assign selling_point_images = source_product.metafields.custom.product_selling_points_images
      endif
    endif

    if selling_point_images != blank
      for _selling_point_image in selling_point_images limit: 4
        assign selling_point_count = selling_point_count | plus: 1
      endfor
    endif
  endif

  if metafield_description != blank
    assign metafield_description_text = metafield_description.value | default: metafield_description
    if metafield_description.type contains 'rich_text'
      assign metafield_description_is_richtext = true
    endif
  endif

  if title_alignment == 'center'
    assign title_alignment_class = 'quiet-luxury-card__title--center'
  elsif title_alignment == 'right'
    assign title_alignment_class = 'quiet-luxury-card__title--right'
  endif
-%}

<style>
  #shopify-block-{{ block.id }} .quiet-luxury-card__title.rte * {
    font-size: inherit;
    font-weight: inherit;
  }

  #shopify-block-{{ block.id }} .quiet-luxury-card__subtitle.rte *,
  #shopify-block-{{ block.id }} .quiet-luxury-card__subtitle.rte a {
    color: inherit;
    font-size: inherit;
    font-weight: inherit;
  }
  #shopify-block-{{ block.id }} .quiet-luxury-card__description .quiet-luxury-card__subtitle.rte strong {
    font-size: var(--quiet-luxury-card-description-title-size, 16px);
    font-weight: var(--quiet-luxury-card-description-title-weight, 500);
  }
</style>

<div class="quiet-luxury-card" {{ block.shopify_attributes }}>
  <div
    class="quiet-luxury-card__hero{% if block.settings.video_top_text != blank %} quiet-luxury-card__hero--with-header{% endif %}"
    style="--quiet-luxury-card-hero-background: {{ video_row_background_color }};"
  >
    <div class="quiet-luxury-card__media-column">
      <div class="quiet-luxury-card__video-wrap">
        <div class="quiet-luxury-card__media-frame">
        {%- liquid
          assign has_valid_metafield_video = false
          if metafield_video != blank
            if metafield_video.media_type == 'video' or metafield_video.media_type == 'external_video'
              assign has_valid_metafield_video = true
            endif
          endif
        -%}
        {%- if has_valid_metafield_video -%}
          {{
            metafield_video
            | media_tag:
              image_size: '1800x',
              controls: true,
              autoplay: true,
              muted: true,
              loop: false,
              class: 'quiet-luxury-card__video'
          }}
        {%- elsif metafield_image != blank -%}
          {%- liquid
            assign top_image = metafield_image
            if metafield_image.preview_image != blank
              assign top_image = metafield_image.preview_image
            endif
          -%}
          {{
            top_image
            | image_url: width: 1800
            | image_tag:
              loading: 'lazy',
              widths: '550, 750, 950, 1200, 1500, 1800, 2400',
              sizes: '(min-width: 768px) min(120rem, 100vw - 6rem), calc(100vw - 3rem)',
              class: 'quiet-luxury-card__video',
              alt: source_product.title,
              is: 'image-lazy'
          }}
        {%- elsif source_video != blank -%}
          {{
            source_video
            | media_tag:
              image_size: '1800x',
              controls: true,
              autoplay: true,
              muted: true,
              loop: false,
              class: 'quiet-luxury-card__video'
          }}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg quiet-luxury-card__video-placeholder' }}
        {%- endif -%}
        </div>

        {%- if metafield_description_text != blank -%}
          <div class="quiet-luxury-card__description" style="--quiet-luxury-card-description-title-size: {{ product_metafield_title_font_size }}px; --quiet-luxury-card-description-title-weight: {{ product_metafield_title_font_weight }}; --quiet-luxury-card-description-body-size: {{ product_metafield_text_font_size }}px; --quiet-luxury-card-description-body-weight: {{ product_metafield_text_font_weight }}; --quiet-luxury-card-description-color: {{ product_metafield_text_color }}; --quiet-luxury-card-description-mobile-title-size: {{ product_metafield_mobile_title_font_size }}px; --quiet-luxury-card-description-mobile-title-weight: {{ product_metafield_mobile_title_font_weight }}; --quiet-luxury-card-description-mobile-body-size: {{ product_metafield_mobile_text_font_size }}px; --quiet-luxury-card-description-mobile-body-weight: {{ product_metafield_mobile_text_font_weight }}; --quiet-luxury-card-description-mobile-color: {{ product_metafield_mobile_text_color }}; --quiet-luxury-card-description-align: {{ product_metafield_text_alignment }}; --quiet-luxury-card-description-justify: {{ product_metafield_text_justify }};">
            {%- if metafield_description_is_richtext -%}
              <div class="quiet-luxury-card__subtitle rte">{{ metafield_description | metafield_tag }}</div>
            {%- elsif metafield_description_text contains '<' and metafield_description_text contains '>' -%}
              <div class="quiet-luxury-card__subtitle rte">{{ metafield_description_text }}</div>
            {%- else -%}
              <p class="quiet-luxury-card__subtitle">{{ metafield_description_text | escape | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if love_it_heading != blank and love_it_has_items -%}
        <section class="quiet-luxury-card__love-it" style="--quiet-luxury-card-love-it-background: {{ love_it_background_color }}; --quiet-luxury-card-love-it-count: {{ love_it_item_count }}; --quiet-luxury-card-love-it-heading-size: {{ love_it_heading_font_size }}px; --quiet-luxury-card-love-it-heading-weight: {{ love_it_heading_font_weight }}; --quiet-luxury-card-love-it-item-title-size: {{ love_it_item_title_font_size }}px; --quiet-luxury-card-love-it-item-title-weight: {{ love_it_item_title_font_weight }}; --quiet-luxury-card-love-it-item-text-size: {{ love_it_item_text_font_size }}px; --quiet-luxury-card-love-it-item-text-weight: {{ love_it_item_text_font_weight }}; --quiet-luxury-card-love-it-align: {{ love_it_text_alignment }}; --quiet-luxury-card-love-it-mobile-heading-size: {{ love_it_mobile_heading_font_size }}px; --quiet-luxury-card-love-it-mobile-heading-weight: {{ love_it_mobile_heading_font_weight }}; --quiet-luxury-card-love-it-mobile-item-title-size: {{ love_it_mobile_item_title_font_size }}px; --quiet-luxury-card-love-it-mobile-item-title-weight: {{ love_it_mobile_item_title_font_weight }}; --quiet-luxury-card-love-it-mobile-item-text-size: {{ love_it_mobile_item_text_font_size }}px; --quiet-luxury-card-love-it-mobile-item-text-weight: {{ love_it_mobile_item_text_font_weight }}; --quiet-luxury-card-love-it-mobile-align: {{ love_it_mobile_text_alignment }};">
          <h2 class="quiet-luxury-card__love-it-heading">{{ love_it_heading | escape }}</h2>
          <div class="quiet-luxury-card__love-it-list">
            {%- for love_it_item in love_it_items -%}
              {%- liquid
                assign love_it_item_title = love_it_item[0]
                assign love_it_item_text = love_it_item[1]
              -%}
              {%- if love_it_item_title != blank or love_it_item_text != blank -%}
                <article class="quiet-luxury-card__love-it-item">
                  {%- if love_it_item_title != blank -%}
                    <h3 class="quiet-luxury-card__love-it-item-title">{{ love_it_item_title | escape }}</h3>
                  {%- endif -%}
                  {%- if love_it_item_text != blank -%}
                    <p class="quiet-luxury-card__love-it-item-text">{{ love_it_item_text | escape }}</p>
                  {%- endif -%}
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}
    </div>

    {%- if block.settings.video_top_text != blank -%}
      <div class="quiet-luxury-card__header">
        {%- if block.settings.video_top_text contains '<' and block.settings.video_top_text contains '>' -%}
          <div class="quiet-luxury-card__title {{ title_alignment_class }} rte" style="font-size: {{ video_top_text_font_size }}px; font-weight: {{ video_top_text_font_weight }}; color: #0e0e0e;">{{ block.settings.video_top_text }}</div>
        {%- else -%}
          <h2 class="quiet-luxury-card__title {{ title_alignment_class }}" style="font-size: {{ video_top_text_font_size }}px; font-weight: {{ video_top_text_font_weight }}; color: #0e0e0e;">{{ block.settings.video_top_text | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if scene_presentation_count > 0 -%}
    <section class="quiet-luxury-card__scene-presentation">
      {%- for scene_presentation_entry in scene_presentation_content -%}
        {%- liquid
          assign scene_presentation_data = scene_presentation_entry[1]
          assign scene_presentation_image = scene_presentation_data.image
          assign scene_presentation_title = scene_presentation_data.title
          assign scene_presentation_text = scene_presentation_data.content
          assign scene_presentation_is_reverse = forloop.index0 | modulo: 2
        -%}
        {%- if scene_presentation_image != blank or scene_presentation_title != blank or scene_presentation_text != blank -%}
          <article class="quiet-luxury-card__scene{% if scene_presentation_is_reverse == 1 %} quiet-luxury-card__scene--reverse{% endif %}">
            <div class="quiet-luxury-card__scene-media">
              {%- if scene_presentation_image != blank -%}
                <img
                  src="{{ scene_presentation_image | escape }}"
                  alt="{{ scene_presentation_title | escape }}"
                  loading="lazy"
                  class="quiet-luxury-card__scene-image"
                >
              {%- endif -%}
            </div>
            <div class="quiet-luxury-card__scene-content">
              {%- if scene_presentation_title != blank -%}
                <h2 class="quiet-luxury-card__scene-title">{{ scene_presentation_title | escape }}</h2>
              {%- endif -%}
              {%- if scene_presentation_text != blank -%}
                <p class="quiet-luxury-card__scene-text">{{ scene_presentation_text | escape | newline_to_br }}</p>
              {%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </section>
  {%- endif -%}

  {%- if selling_point_count > 0 -%}
  <div id="quiet-luxury-card-grid-{{ block.id }}" class="quiet-luxury-card__grid quiet-luxury-card__grid--count-{{ selling_point_count }}" data-quiet-luxury-selling-points>
    <div class="quiet-luxury-card__grid-inner">
    {%- for card_image_media in selling_point_images limit: 4 -%}
      {%- liquid
        assign index = forloop.index
        assign card_image = blank
        assign card_text_metafield = blank
        assign card_text = blank
        assign card_image_alt = blank
        assign card_sizes = '(min-width: 768px) calc((100vw - 8rem) / 3), calc(100vw - 3rem)'

        if selling_point_count == 1
          assign card_sizes = '(min-width: 768px) min(120rem, 100vw - 6rem), calc(100vw - 3rem)'
        elsif selling_point_count == 2 or selling_point_count == 4
          assign card_sizes = '(min-width: 768px) calc((100vw - 8rem) / 2), calc(100vw - 3rem)'
        endif

        if card_image_media != blank
          if card_image_media.preview_image != blank
            assign card_image = card_image_media.preview_image
          else
            assign card_image = card_image_media
          endif
          if card_image == blank and card_image_media.value != blank
            assign card_image = card_image_media.value
          endif
          if card_image != blank
            assign card_image_alt = card_image.alt | default: card_image_media.alt
          endif
        endif

        case index
          when 1
            assign card_text_metafield = source_product.metafields.foxtheme.product_selling_point_text_1
            if card_text_metafield == blank
              assign card_text_metafield = source_product.metafields.custom.product_selling_point_text_1
            endif
          when 2
            assign card_text_metafield = source_product.metafields.foxtheme.product_selling_point_text_2
            if card_text_metafield == blank
              assign card_text_metafield = source_product.metafields.custom.product_selling_point_text_2
            endif
          when 3
            assign card_text_metafield = source_product.metafields.foxtheme.product_selling_point_text_3
            if card_text_metafield == blank
              assign card_text_metafield = source_product.metafields.custom.product_selling_point_text_3
            endif
          when 4
            assign card_text_metafield = source_product.metafields.foxtheme.product_selling_point_text_4
            if card_text_metafield == blank
              assign card_text_metafield = source_product.metafields.custom.product_selling_point_text_4
            endif
        endcase

        if card_text_metafield != blank
          assign card_text = card_text_metafield.value | default: card_text_metafield
        endif
      -%}
      <article class="quiet-luxury-card__item quiet-luxury-card__item--{{ index }}">
        <div class="quiet-luxury-card__item-image-wrap quiet-luxury-card__item-image-wrap--count-{{ selling_point_count }}">
          {%- if card_image != blank -%}
            {{
              card_image
              | image_url: width: 1500
              | image_tag:
                loading: 'lazy',
                widths: '375, 550, 750, 950, 1100, 1500',
                sizes: card_sizes,
                class: 'quiet-luxury-card__item-image',
                alt: card_image_alt,
                is: 'image-lazy'
            }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg quiet-luxury-card__item-placeholder' }}
          {%- endif -%}
        </div>
        {%- if card_text_metafield != blank and card_text_metafield.type contains 'rich_text' -%}
          <div class="quiet-luxury-card__item-text rte">{{ card_text_metafield | metafield_tag }}</div>
        {%- elsif card_text != blank -%}
          {%- if card_text contains '<' and card_text contains '>' -%}
            <div class="quiet-luxury-card__item-text rte">{{ card_text }}</div>
          {%- else -%}
            <p class="quiet-luxury-card__item-text">{{ card_text | escape | newline_to_br }}</p>
          {%- endif -%}
        {%- endif -%}
      </article>
    {%- endfor -%}
    </div>
  </div>
  <nav class="quiet-luxury-card__pagination md:hidden" aria-label="Selling point pagination" data-quiet-luxury-pagination data-target="quiet-luxury-card-grid-{{ block.id }}">
    <button type="button" class="quiet-luxury-card__pagination-button" data-quiet-luxury-pagination-prev aria-label="Previous selling point">
      {% render 'icon-caret-left', size: 'small' %}
    </button>
    <span class="quiet-luxury-card__pagination-fraction" aria-live="polite">
      <span class="quiet-luxury-card__pagination-current" data-quiet-luxury-pagination-current>1</span>
      <span class="quiet-luxury-card__pagination-separator">/</span>
      <span class="quiet-luxury-card__pagination-total">{{ selling_point_count }}</span>
    </span>
    <button type="button" class="quiet-luxury-card__pagination-button" data-quiet-luxury-pagination-next aria-label="Next selling point">
      {% render 'icon-caret-right', size: 'small' %}
    </button>
  </nav>
    {%- endif -%}
</div>
