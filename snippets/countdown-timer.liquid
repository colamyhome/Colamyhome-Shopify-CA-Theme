{{ 'component-countdown-timer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'countdown-timer.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign number_size = number_size | default: 'h3'

  assign display_text = false
  assign style = style | default: 'number'
  if style == 'with_text'
    assign display_text = true
  endif

  assign type = type | default: 'evergreen'
  assign duration = duration | default: 'every_month'
  if show_days == nil
    assign show_days = true
  endif
  assign split_digits = split_digits | default: false
-%}
<countdown-timer
  id="countdown-timer-{{ id }}"
  class="countdown-timer hidden no-js-hidden {{ custom_class }}"
  data-type="{{ type }}"
  data-duration="{{ duration }}"
  data-due-date="{{ time }}"
  data-split-digits="{{ split_digits }}"
  {% if text_color != blank %}
    style="--countdown-timer-text-color: {{ text_color }};"
  {% endif %}
>
  <div class="countdown-timer__inner inline-flex items-center justify-center">
    {%- unless show_days == false -%}
      <div class="countdown-timer__block countdown-timer__block--day relative inline-flex flex-col items-center justify-center">
        <div
          class="relative text-center w-full countdown-timer__number countdown-timer__day {{ number_size }} {{ block_class }}"
          data-timer-day
        >
          {%- if split_digits -%}
            <span class="countdown-timer__digit">0</span><span class="countdown-timer__digit">0</span>
          {%- else -%}
            00
          {%- endif -%}
        </div>
        {%- if display_text -%}
          <span class="text-subtext">{{ 'sections.countdown-timer.days' | t }}</span>
        {%- endif -%}
      </div>
    {%- endunless -%}
    <div class="countdown-timer__block relative inline-flex flex-col items-center justify-center">
      <div
        class="relative text-center w-full countdown-timer__number countdown-timer__hour {{ number_size }} {{ block_class }}"
        data-timer-hour
      >
        {%- if split_digits -%}
          <span class="countdown-timer__digit">0</span><span class="countdown-timer__digit">0</span>
        {%- else -%}
          00
        {%- endif -%}
      </div>
      {%- if display_text -%}
        <span class="text-subtext">{{ 'sections.countdown-timer.hours' | t }}</span>
      {%- endif -%}
    </div>
    <div class="countdown-timer__block relative inline-flex flex-col items-center justify-center">
      <div
        class="relative text-center w-full countdown-timer__number countdown-timer__minute {{ number_size }} {{ block_class }}"
        data-timer-minute
      >
        {%- if split_digits -%}
          <span class="countdown-timer__digit">0</span><span class="countdown-timer__digit">0</span>
        {%- else -%}
          00
        {%- endif -%}
      </div>
      {%- if display_text -%}
        <span class="text-subtext">{{ 'sections.countdown-timer.minutes' | t }}</span>
      {%- endif -%}
    </div>
    <div class="countdown-timer__block relative inline-flex flex-col items-center justify-center">
      <div
        class="relative text-center w-full countdown-timer__number countdown-timer__sec {{ number_size }} {{ block_class }}"
        data-timer-second
      >
        {%- if split_digits -%}
          <span class="countdown-timer__digit">0</span><span class="countdown-timer__digit">0</span>
        {%- else -%}
          00
        {%- endif -%}
      </div>
      {%- if display_text -%}
        <span class="text-subtext">{{ 'sections.countdown-timer.seconds' | t }}</span>
      {%- endif -%}
    </div>
  </div>
</countdown-timer>
