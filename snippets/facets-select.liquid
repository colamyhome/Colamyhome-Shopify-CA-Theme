{%- liquid
  assign has_filters = false
  assign select_filter_index = 0

  for filter in results.filters
    if filter.type == 'list' or filter.type == 'boolean' or filter.type == 'price_range'
      assign has_filters = true
      break
    endif
  endfor
-%}
{%- if has_filters -%}
  <div
    class="collection-filter-select"
    id="TopFacetFiltersContainer"
  >
    <form
      class="collection-filter-select__form"
      method="GET"
      action="{{ request.path }}"
      is="facet-form"
      data-section-id="{{ section.id }}"
      data-history
      update-on-change
    >
      <div data-filter data-index="{{ context }}-page" hidden>
        <input type="hidden" name="page" value="">

        {%- if results.current_type != blank or results.current_vendor != blank -%}
          <input type="hidden" name="q" value="{{ results.current_vendor | default: results.current_type | escape }}">
        {%- endif -%}

        {%- if request.page_type == 'search' -%}
          <input type="hidden" name="q" value="{{ results.terms | escape }}">
        {%- endif -%}

        {%- if results.sort_by != blank -%}
          <input type="hidden" name="sort_by" value="{{ results.sort_by }}">
        {%- endif -%}
      </div>

      <div class="collection-filter-select__controls">
        {%- for filter in results.filters -%}
          {%- assign filter_id = context | append: '-' | append: filter.param_name -%}
          {%- case filter.type -%}
            {%- when 'list', 'boolean' -%}
              {%- liquid
                assign sorted_values = filter.values
                assign active_filter_values = sorted_values | where: 'active', true
                if filter.operator == 'AND'
                  assign active_filter_values = filter.values | where: 'active', true
                  assign inactive_filter_values = filter.values | where: 'active', false
                  assign sorted_values = active_filter_values | concat: inactive_filter_values
                endif
              -%}
              {%- if sorted_values.size > 0 -%}
                {%- liquid
                  assign select_filter_index = select_filter_index | plus: 1
                  assign filter_placeholder = 'products.facets.filter_button' | t

                  if context == 'toolbar' and select_filter_index == 1
                    assign filter_placeholder = 'Category'
                  elsif context == 'toolbar' and select_filter_index == 3
                    assign filter_placeholder = 'Color'
                  endif
                -%}
                <div
                  class="collection-filter-select__field{% if context == 'toolbar' and select_filter_index == 2 %} collection-filter-select__field--hidden{% endif %}"
                  data-filter
                  data-index="{{ filter_id }}"
                >
                  {%- for filter_value in sorted_values -%}
                    {%- if filter_value.active -%}
                      <input
                        type="hidden"
                        name="{{ filter_value.param_name }}"
                        value="{{ filter_value.value | escape }}"
                        data-facet-toggle-value="{{ filter_value.value | escape }}"
                      >
                    {%- endif -%}
                  {%- endfor -%}
                  <div class="select collection-filter-select__select-wrap">
                    {%- for filter_value in sorted_values limit: 1 -%}
                      <select
                        class="form-control form-control--select collection-filter-select__select"
                        id="FacetSelect-{{ filter_id }}"
                        data-name="{{ filter_value.param_name }}"
                        data-placeholder="{{ filter_placeholder | escape }}"
                        aria-label="{{ filter.label | escape }}"
                        is="facet-toggle-select"
                      >
                    {%- endfor -%}
                      <option value="" selected disabled data-facet-summary-option>
                        {%- if active_filter_values.size > 0 -%}
                          {%- for active_filter_value in active_filter_values -%}
                            {{- active_filter_value.label | escape -}}
                            {%- unless forloop.last -%}, {%- endunless -%}
                          {%- endfor -%}
                        {%- else -%}
                          {{- filter_placeholder -}}
                        {%- endif -%}
                      </option>
                      {%- for filter_value in sorted_values -%}
                        {%- liquid
                          assign is_disabled = false
                          if filter_value.count == 0 and filter_value.active == false
                            assign is_disabled = true
                          endif
                        -%}
                        <option
                          value="{{ filter_value.value | escape }}"
                          data-label="{{ filter_value.label | escape }}"
                          {% if is_disabled %}
                            disabled
                          {% endif %}
                        >
                          {{- filter_value.label | escape -}}
                          {%- unless filter_value.count == blank -%}
                            ({{ filter_value.count }})
                          {%- endunless -%}
                        </option>
                      {%- endfor -%}
                    </select>
                    {% render 'icon-caret-down', size: '2xs' %}
                  </div>
                </div>
              {%- endif -%}
            {%- when 'price_range' -%}
              {%- liquid
                assign min_value = filter.min_value.value | default: 0.0 | divided_by: 100.0
                assign max_value = filter.max_value.value | default: filter.range_max | divided_by: 100.0
                assign range_max = filter.range_max | divided_by: 100.0 | ceil
                assign step_value = max_value | minus: min_value | divided_by: 100.0 | ceil | at_most: 1
              -%}
              {%- if range_max > 0 -%}
                <div
                  class="collection-filter-select__field collection-filter-select__field--price"
                  data-filter
                  data-index="{{ filter_id }}"
                >
                  <div class="collection-filter-select__price flex items-center gap-2">
                    <label class="visually-hidden" for="FacetSelectInputFromPrice-{{ context }}">
                      {{- 'products.facets.from' | t -}}
                    </label>
                    <input
                      class="form-control"
                      type="number"
                      inputmode="numeric"
                      name="{{ filter.min_value.param_name }}"
                      id="FacetSelectInputFromPrice-{{ context }}"
                      autocomplete="off"
                      placeholder="0"
                      min="0"
                      max="{{ max_value | ceil }}"
                      step="{{ step_value }}"
                      {% if filter.min_value.value %}
                        value="{{ min_value | ceil }}"
                      {% endif %}
                    >
                    <span aria-hidden="true">-</span>
                    <label class="visually-hidden" for="FacetSelectInputToPrice-{{ context }}">
                      {{- 'products.facets.to' | t -}}
                    </label>
                    <input
                      class="form-control"
                      type="number"
                      inputmode="numeric"
                      name="{{ filter.max_value.param_name }}"
                      id="FacetSelectInputToPrice-{{ context }}"
                      autocomplete="off"
                      placeholder="{{ range_max | ceil }}"
                      min="{{ min_value | ceil }}"
                      max="{{ range_max | ceil }}"
                      step="{{ step_value }}"
                      {% if filter.max_value.value %}
                        value="{{ max_value | ceil }}"
                      {% endif %}
                    >
                  </div>
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>

      <div class="collection-filter-select__loading" data-facet-loading>
        {%- render 'loading-spinner', size: 'small' -%}
      </div>
    </form>
  </div>
{%- endif -%}
